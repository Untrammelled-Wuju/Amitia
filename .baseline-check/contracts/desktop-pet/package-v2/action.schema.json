{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Amitia Desktop Pet Action JSON Schema v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "actionKey",
    "displayName",
    "version",
    "playbackMode",
    "fps",
    "interruptible",
    "priority",
    "cooldownMs",
    "minimumPlayMs",
    "maximumPlayMs",
    "mutexGroup",
    "supportsDefaultIdle",
    "isStableStateCandidate",
    "isTransitionOnly",
    "returnTo",
    "anchor",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "actionKey": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "playbackMode": {
      "type": "string",
      "enum": ["loop", "once", "hold", "ping_pong"]
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "interruptible": {
      "type": "boolean"
    },
    "interruptAfterMs": {
      "type": "integer",
      "minimum": 0
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "cooldownMs": {
      "type": "integer",
      "minimum": 0
    },
    "minimumPlayMs": {
      "type": "integer",
      "minimum": 0
    },
    "maximumPlayMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "mutexGroup": {
      "type": ["string", "null"]
    },
    "supportsDefaultIdle": {
      "type": "boolean"
    },
    "isStableStateCandidate": {
      "type": "boolean"
    },
    "isTransitionOnly": {
      "type": "boolean"
    },
    "returnTo": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["default", "previous", "current_activity", "none", "action"]
        },
        "actionKey": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "action" } } },
          "then": { "required": ["actionKey"] }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "required": ["x", "y", "coordinateSpace"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "coordinateSpace": { "type": "string", "const": "normalized_canvas" }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frameId", "index", "file", "durationMs", "assetId", "contentHash"],
        "properties": {
          "frameId": { "type": "string", "minLength": 1 },
          "index": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "minLength": 1 },
          "durationMs": { "type": "integer", "minimum": 8, "maximum": 60000 },
          "assetId": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "additionalProperties": false
}
