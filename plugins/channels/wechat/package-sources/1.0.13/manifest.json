{
  "manifestVersion": 1,
  "placement": "device",
  "extension": {
    "id": "com.amitia/channel-wechat",
    "name": {
      "default": "微信渠道"
    },
    "description": {
      "default": "通过 OpenClaw 微信协议接入微信消息。"
    },
    "version": "1.0.14",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "channel",
      "messaging"
    ],
    "keywords": [
      "wechat",
      "openclaw",
      "channel"
    ]
  },
  "publisher": {
    "id": "com.amitia",
    "displayName": "Amitia",
    "trustLevel": "official"
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "wechat-channel-service",
      "name": {
        "default": "微信渠道服务"
      },
      "description": {
        "default": "管理微信扫码登录、账号状态、入站消息和单条消息发送。"
      },
      "type": "service",
      "runtime": {
        "type": "service",
        "entryPoint": "launcher.mjs",
        "timeout": "30s",
        "memory": 536870912,
        "maxSubprocesses": 1
      },
      "placement": "device",
      "providedCapabilities": [
        {
          "id": "channel.provider",
          "version": "1.0.0"
        }
      ],
      "provider": {
        "id": "com.amitia.channel-wechat.provider",
        "priority": 100,
        "labels": {
          "channelId": "wechat"
        },
        "metadata": {
          "capabilities": {
            "file": true,
            "group": false,
            "image": true,
            "reply": false,
            "text": true,
            "thread": false,
            "video": false,
            "voice": true
          },
          "id": "wechat",
          "sidecar": {
            "defaultPort": 19876,
            "healthPath": "/api/health",
            "kind": "wechat",
            "subdir": "sidecar"
          }
        }
      },
      "contributions": []
    },
    {
      "id": "wechat-channel-ui",
      "name": {
        "default": "微信渠道界面"
      },
      "description": {
        "default": "提供微信连接、扫码、账号状态和断开操作页面。"
      },
      "type": "data_only",
      "contributions": [
        {
          "id": "wechat-page",
          "kind": "ui_page",
          "name": {
            "default": "微信连接"
          },
          "description": {
            "default": ""
          },
          "spec": {
            "actions": [
              {
                "action_id": "status",
                "risk_level": "low",
                "target": {
                  "command": "channel.status",
                  "type": "host_command"
                },
                "title": {
                  "default": "查询微信状态"
                }
              },
              {
                "action_id": "config",
                "risk_level": "low",
                "target": {
                  "command": "channel.config",
                  "type": "host_command"
                },
                "title": {
                  "default": "读取微信配置"
                }
              },
              {
                "action_id": "connect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.connect",
                  "type": "host_command"
                },
                "title": {
                  "default": "连接微信"
                }
              },
              {
                "action_id": "disconnect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.disconnect",
                  "type": "host_command"
                },
                "title": {
                  "default": "断开微信"
                }
              },
              {
                "action_id": "messages",
                "risk_level": "low",
                "target": {
                  "command": "channel.messages",
                  "type": "host_command"
                },
                "title": {
                  "default": "查看微信消息"
                }
              }
