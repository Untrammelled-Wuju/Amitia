            "contract_version": 1,
            "contribution_id": "wechat-page",
            "display": {
              "description": {
                "default": "连接微信账号并查看扫码状态。"
              },
              "icon": "channel",
              "title": {
                "default": "微信连接"
              }
            },
            "entry": {
              "content_hash": "sha256-oNVcbEn5unkjbKLgbi5xkCGKGTgHeNUJtSzdIwVxrJo=",
              "path": "modules/wechat-channel-ui/desktop/index.html",
              "type": "web_restricted"
