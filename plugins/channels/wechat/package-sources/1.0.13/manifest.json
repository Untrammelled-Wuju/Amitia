  "permissions": [
    {
      "name": "conversation.read",
      "reason": "在渠道消息查看页面读取宿主保存的微信会话和消息。",
      "required": true,
      "scope": "global"
    },
    {
      "name": "conversation.write",
      "reason": "将微信入站消息提交给统一会话管线。",
      "required": true,
      "scope": "global"
    },
    {
      "name": "message.send",
      "reason": "向微信用户发送角色回复。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.provider.register",
      "reason": "注册并管理微信渠道 Provider。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.secret.use",
      "reason": "读取微信机器人令牌。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.network.request",
      "reason": "连接微信 iLink 服务。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.network.listen_loopback",
      "reason": "在本地回环地址提供渠道状态和发送接口。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.background.run",
      "reason": "保持微信连接和消息接收任务运行。",
      "required": true,
      "scope": "extension"
    }
  ],
