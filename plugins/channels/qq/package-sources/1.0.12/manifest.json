{
  "manifestVersion": 1,
  "placement": "device",
  "extension": {
    "id": "com.amitia/channel-qq",
    "name": {
      "default": "QQ 渠道"
    },
    "description": {
      "default": "通过 QQ Bot WebSocket 接入 QQ 私聊和群聊消息。"
    },
    "version": "1.0.13",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "channel",
      "messaging"
    ],
    "keywords": [
      "qq",
      "qqbot",
      "channel"
    ]
  },
  "publisher": {
    "id": "com.amitia",
    "displayName": "Amitia",
    "trustLevel": "official"
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "qq-channel-service",
      "name": {
        "default": "QQ 渠道服务"
      },
      "description": {
        "default": "管理 QQ Bot 连接、账号状态、入站消息和单条消息发送。"
      },
      "type": "service",
      "runtime": {
        "type": "service",
        "entryPoint": "launcher.mjs",
        "timeout": "30s",
        "memory": 268435456,
        "maxSubprocesses": 1
      },
      "placement": "device",
      "providedCapabilities": [
        {
          "id": "channel.provider",
          "version": "1.0.0"
        }
      ],
      "provider": {
        "id": "com.amitia.channel-qq.provider",
        "priority": 100,
        "labels": {
          "channelId": "qq"
        },
        "metadata": {
          "capabilities": {
            "file": true,
            "group": true,
            "image": true,
            "reply": false,
            "text": true,
            "thread": false,
            "video": false,
            "voice": true
          },
          "id": "qq",
          "sidecar": {
            "defaultPort": 19877,
            "healthPath": "/api/health",
            "kind": "qq",
            "subdir": "qq-sidecar"
          }
        }
      },
      "contributions": []
    },
    {
      "id": "qq-channel-ui",
      "name": {
        "default": "QQ 渠道界面"
      },
      "description": {
        "default": "提供 QQ Bot 配置、连接状态和断开操作页面。"
      },
      "type": "data_only",
      "contributions": [
        {
          "id": "qq-page",
          "kind": "ui_page",
          "name": {
            "default": "QQ 连接"
          },
          "description": {
            "default": ""
          },
          "spec": {
            "actions": [
              {
                "action_id": "status",
                "risk_level": "low",
                "target": {
                  "command": "channel.status",
                  "type": "host_command"
                },
                "title": {
                  "default": "查询 QQ 状态"
                }
              },
              {
                "action_id": "config",
                "risk_level": "low",
                "target": {
                  "command": "channel.config",
                  "type": "host_command"
                },
                "title": {
                  "default": "读取 QQ 配置"
                }
              },
              {
                "action_id": "connect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.connect",
                  "type": "host_command"
                },
                "title": {
                  "default": "连接 QQ"
                }
              },
              {
                "action_id": "disconnect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.disconnect",
                  "type": "host_command"
                },
                "title": {
                  "default": "断开 QQ"
                }
              },
              {
                "action_id": "messages",
                "risk_level": "low",
                "target": {
                  "command": "channel.messages",
                  "type": "host_command"
                },
                "title": {
                  "default": "查看 QQ 消息"
                }
              }
            ],
            "contract_version": 1,
            "contribution_id": "qq-page",
            "display": {
              "description": {
                "default": "配置并连接 QQ Bot。"
              },
              "icon": "channel",
              "title": {
                "default": "QQ 连接"
              }
            },
            "entry": {
              "content_hash": "sha256-KUiqccdNj0VAfgMhFjqaunItOfbrkUBWvRaEYYBEIkE=",
              "path": "modules/qq-channel-ui/desktop/index.html",
              "type": "web_restricted"
            },
            "extension_id": "com.amitia/channel-qq",
            "integrity": {
              "definition_hash": "qq-page-v1"
            },
            "kind": "web_page",
            "module_id": "qq-channel-ui",
            "sandbox": {
              "enable_scripts": true,
              "type": "web_restricted"
            },
            "slot": {
              "contract_version": 1,
              "slot_id": "provider.page.provider"
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            }
          },
          "requiredPermissions": [
            "service.network.request"
          ]
        },
        {
          "id": "qq-messages-page",
          "kind": "ui_page",
          "name": {
            "default": "QQ 消息"
          },
          "description": {
            "default": "查看宿主保存的 QQ 渠道会话和消息。"
