              "definition_hash": "qq-messages-page-v1"
            },
            "kind": "web_page",
            "module_id": "qq-channel-ui",
            "sandbox": {
              "enable_scripts": true,
              "type": "web_restricted"
            },
            "slot": {
              "contract_version": 1,
              "slot_id": "provider.page.provider"
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            }
          },
          "requiredPermissions": [
            "conversation.read"
          ]
        },
