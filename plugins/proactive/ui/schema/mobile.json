{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "主动任务（手机端）",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "ui.dashboard"
        },
        "statePath": "dashboard"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "mobile-proactive-page",
      "type": "page",
      "children": [
        {
          "id": "mobile-proactive-status",
          "type": "key_value",
          "props": {
            "title": "运行状态",
            "columns": 1
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "dashboard.status"
            }
          ]
        },
        {
          "id": "mobile-proactive-refresh",
          "type": "button",
          "props": {
            "text": "刷新",
            "type": "primary"
          },
          "actions": [
            {
              "action_id": "command",
              "target": "tool",
              "input": {
                "action": "ui.dashboard"
              },
              "statePath": "dashboard"
            }
          ]
        },
        {
          "id": "mobile-proactive-tabs",
          "type": "tabs",
          "children": [
            {
              "id": "mobile-proactive-settings",
              "type": "tab_item",
              "props": {
                "label": "参数",
                "name": "settings"
              },
              "children": [
                {
                  "id": "mobile-proactive-enabled",
                  "type": "switch",
                  "props": {
                    "activeText": "启用主动任务"
                  },
                  "bindings": [
                    {
                      "path": "settings.enabled",
                      "source": "form",
                      "default": true
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-level",
                  "type": "slider",
                  "props": {
                    "label": "主动程度",
                    "min": 1,
                    "max": 100
                  },
                  "bindings": [
                    {
                      "path": "settings.activeLevel",
                      "source": "form",
                      "default": 40
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-max-day",
                  "type": "slider",
                  "props": {
                    "label": "每天最多",
                    "min": 1,
                    "max": 24
                  },
                  "bindings": [
                    {
                      "path": "settings.maxPerDay",
                      "source": "form",
                      "default": 6
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-quiet-start",
                  "type": "field",
                  "props": {
                    "label": "静默开始",
                    "variant": "time"
                  },
                  "bindings": [
                    {
                      "path": "settings.quietStart",
                      "source": "form",
                      "default": "23:00"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-quiet-end",
                  "type": "field",
                  "props": {
                    "label": "静默结束",
                    "variant": "time"
                  },
                  "bindings": [
                    {
                      "path": "settings.quietEnd",
                      "source": "form",
                      "default": "07:00"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-save",
                  "type": "button",
                  "props": {
                    "text": "保存参数",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "settings.update",
                        "ui_state": true,
                        "payload": {
                          "enabled": "$form.settings.enabled",
                          "activeLevel": "$form.settings.activeLevel",
                          "maxPerDay": "$form.settings.maxPerDay",
                          "quietStart": "$form.settings.quietStart",
                          "quietEnd": "$form.settings.quietEnd",
                          "minInterval": "$form.settings.minInterval",
                          "maxDailyCalls": "$form.settings.maxDailyCalls",
                          "unrepliedSlowdownEnabled": "$form.settings.unrepliedSlowdownEnabled",
                          "unrepliedSlowdownAfter": "$form.settings.unrepliedSlowdownAfter",
                          "unrepliedCooldownMultiplier": "$form.settings.unrepliedCooldownMultiplier",
                          "unrepliedRecoveryOnReply": "$form.settings.unrepliedRecoveryOnReply"
                        }
                      },
                      "statePath": "dashboard"
                    }
                  ]
                },
                {
                  "id": "unified-setting-minInterval",
                  "type": "field",
                  "props": {
                    "label": "最短间隔（分钟）",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "settings.minInterval",
                      "source": "form",
                      "default": 60
                    }
                  ]
                },
                {
                  "id": "unified-setting-maxDailyCalls",
                  "type": "field",
                  "props": {
                    "label": "每日模型调用上限",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "settings.maxDailyCalls",
                      "source": "form",
                      "default": 10
                    }
                  ]
                },
                {
                  "id": "unified-setting-unrepliedSlowdownEnabled",
                  "type": "switch",
                  "props": {
                    "label": "未回复时减缓"
                  },
                  "bindings": [
                    {
                      "path": "settings.unrepliedSlowdownEnabled",
                      "source": "form",
                      "default": true
                    }
                  ]
                },
                {
                  "id": "unified-setting-unrepliedSlowdownAfter",
                  "type": "field",
                  "props": {
                    "label": "连续未回复次数",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "settings.unrepliedSlowdownAfter",
                      "source": "form",
                      "default": 2
                    }
                  ]
                },
                {
                  "id": "unified-setting-unrepliedCooldownMultiplier",
                  "type": "field",
                  "props": {
                    "label": "未回复冷却倍数",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "settings.unrepliedCooldownMultiplier",
                      "source": "form",
                      "default": 2
                    }
                  ]
                },
                {
                  "id": "unified-setting-unrepliedRecoveryOnReply",
                  "type": "switch",
                  "props": {
                    "label": "回复后恢复"
                  },
                  "bindings": [
                    {
                      "path": "settings.unrepliedRecoveryOnReply",
                      "source": "form",
                      "default": true
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-reset-presets",
                  "type": "button",
                  "props": {
                    "text": "恢复当前角色预设"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "presets.reset",
                        "ui_state": true,
                        "payload": {}
                      },
                      "statePath": "dashboard"
                    }
                  ]
                }
              ]
            },
            {
              "id": "mobile-proactive-rules",
              "type": "tab_item",
              "props": {
                "label": "规则",
                "name": "rules"
              },
              "children": [
                {
                  "id": "mobile-proactive-rule-table",
                  "type": "table",
                  "props": {
                    "columns": [
                      {
                        "prop": "id",
                        "label": "ID"
                      },
                      {
                        "prop": "name",
                        "label": "名称"
                      },
                      {
                        "prop": "scheduleCron",
                        "label": "时间"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "data",
                      "source": "state",
                      "sourcePath": "dashboard.rules"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-id",
                  "type": "field",
                  "props": {
                    "label": "规则 ID"
                  },
                  "bindings": [
                    {
                      "path": "rule.id",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-name",
                  "type": "field",
                  "props": {
                    "label": "规则名称"
                  },
                  "bindings": [
                    {
                      "path": "rule.name",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-cron",
                  "type": "field",
                  "props": {
                    "label": "Cron 时间"
                  },
                  "bindings": [
                    {
                      "path": "rule.scheduleCron",
                      "source": "form",
                      "default": "0 9 * * *"
                    }
                  ]
                },
                {
                  "id": "unified-rule-quietEnd",
                  "type": "field",
                  "props": {
                    "label": "静默结束"
                  },
                  "bindings": [
                    {
                      "path": "rule.quietEnd",
                      "source": "form",
                      "default": "07:00"
                    }
                  ]
                },
                {
                  "id": "unified-rule-quietStart",
                  "type": "field",
                  "props": {
                    "label": "静默开始"
                  },
                  "bindings": [
                    {
                      "path": "rule.quietStart",
                      "source": "form",
                      "default": "23:00"
                    }
                  ]
                },
                {
                  "id": "unified-rule-maxOccurrences",
                  "type": "field",
                  "props": {
                    "label": "最多执行次数（0 不限）",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "rule.maxOccurrences",
                      "source": "form",
                      "default": 0
                    }
                  ]
                },
                {
                  "id": "unified-rule-endAt",
                  "type": "field",
                  "props": {
                    "label": "结束时间（含时区，可留空）"
                  },
                  "bindings": [
                    {
                      "path": "rule.endAt",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "unified-rule-channelTargetsText",
                  "type": "field",
                  "props": {
                    "label": "已接入渠道目标（JSON）"
                  },
                  "bindings": [
                    {
                      "path": "rule.channelTargetsText",
                      "source": "form",
                      "default": "[]"
                    }
                  ]
                },
                {
                  "id": "unified-rule-timezone",
                  "type": "field",
                  "props": {
                    "label": "时区（IANA）"
                  },
                  "bindings": [
                    {
                      "path": "rule.timezone",
                      "source": "form",
                      "default": "Asia/Shanghai"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-prompt",
                  "type": "field",
                  "props": {
                    "label": "消息 Prompt",
                    "variant": "textarea",
                    "rows": 4
                  },
                  "bindings": [
                    {
                      "path": "rule.promptTemplate",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-save",
                  "type": "button",
                  "props": {
                    "text": "保存规则",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "rules.save",
                        "ui_state": true,
                        "payload": {
                          "id": "$form.rule.id",
                          "name": "$form.rule.name",
                          "ruleType": "custom",
                          "scheduleCron": "$form.rule.scheduleCron",
                          "channel": "all",
                          "maxPerDay": "$form.rule.maxPerDay",
                          "randomMinutes": "$form.rule.randomMinutes",
                          "promptTemplate": "$form.rule.promptTemplate",
                          "timezone": "$form.rule.timezone",
                          "channelTargetsText": "$form.rule.channelTargetsText",
                          "endAt": "$form.rule.endAt",
                          "maxOccurrences": "$form.rule.maxOccurrences",
                          "quietStart": "$form.rule.quietStart",
                          "quietEnd": "$form.rule.quietEnd",
                          "conversationId": "$form.rule.conversationId",
                          "systemNotification": "$form.rule.systemNotification"
                        }
                      },
                      "statePath": "dashboard"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-toggle",
                  "type": "button",
                  "props": {
                    "text": "启用/停用"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "rules.toggle",
                        "ui_state": true,
                        "payload": {
                          "id": "$form.rule.id"
                        }
                      },
                      "statePath": "dashboard"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-delete",
                  "type": "button",
                  "props": {
                    "text": "删除规则",
                    "type": "danger"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "rules.delete",
                        "ui_state": true,
                        "payload": {
                          "id": "$form.rule.id"
                        }
                      },
                      "confirmation": "确认删除该规则？",
                      "statePath": "dashboard"
                    }
                  ]
                },
                {
                  "id": "unified-rule-conversationId",
                  "type": "field",
                  "props": {
                    "label": "目标对话 ID（留空新建）"
                  },
                  "bindings": [
                    {
                      "path": "rule.conversationId",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "unified-rule-maxPerDay",
                  "type": "field",
                  "props": {
                    "label": "规则每日上限",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "rule.maxPerDay",
                      "source": "form",
                      "default": 1
                    }
                  ]
                },
                {
                  "id": "unified-rule-randomMinutes",
                  "type": "field",
                  "props": {
                    "label": "随机偏移分钟",
                    "variant": "number",
                    "min": 0
                  },
                  "bindings": [
                    {
                      "path": "rule.randomMinutes",
                      "source": "form",
                      "default": 0
                    }
                  ]
                },
                {
                  "id": "unified-rule-systemNotification",
                  "type": "switch",
                  "props": {
                    "label": "系统通知"
                  },
                  "bindings": [
                    {
                      "path": "rule.systemNotification",
                      "source": "form",
                      "default": true
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-test",
                  "type": "button",
                  "props": {
                    "text": "预览内容"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "rules.test",
                        "ui_state": false,
                        "payload": {
                          "id": "$form.rule.id"
                        }
                      },
                      "statePath": "preview"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-rule-trigger",
                  "type": "button",
                  "props": {
                    "text": "立即触发（查看历史结果）"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "rules.trigger",
                        "ui_state": true,
                        "payload": {
                          "id": "$form.rule.id"
                        }
                      },
                      "statePath": "dashboard"
                    }
                  ]
                },
                {
                  "id": "mobile-proactive-preview",
                  "type": "key_value",
                  "props": {
                    "title": "预览（不发送）"
                  },
                  "bindings": [
                    {
                      "path": "items",
                      "source": "state",
                      "sourcePath": "preview"
                    }
                  ]
                }
              ]
            },
            {
              "id": "mobile-proactive-history",
              "type": "tab_item",
              "props": {
                "label": "历史",
                "name": "history"
              },
              "children": [
                {
                  "id": "mobile-proactive-history-table",
                  "type": "table",
                  "props": {
                    "columns": [
                      {
                        "prop": "createdAt",
                        "label": "时间"
                      },
                      {
                        "prop": "title",
                        "label": "规则"
                      },
                      {
                        "prop": "state",
                        "label": "状态"
                      },
                      {
                        "prop": "result",
                        "label": "保存与分目标投递结果"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "data",
                      "source": "state",
                      "sourcePath": "dashboard.history.items"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 120,
    "maxLayoutCount": 180,
    "maxNodeCount": 180,
    "maxDataFetchCount": 1,
    "maxActionCount": 24
  }
}
