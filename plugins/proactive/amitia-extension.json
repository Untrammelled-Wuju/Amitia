                "action_id": "command",
                "title": {
                  "default": "执行主动消息操作"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/proactive/command"
                },
                "risk_level": "medium"
              }
            ],
            "integrity": {
              "definition_hash": "proactive-character-tab-v1"
