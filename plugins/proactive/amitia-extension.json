  "permissions": [
    {
      "name": "storage.state.read",
      "reason": "读取插件自有规则、设置和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.state.write",
      "reason": "保存插件自有规则、设置和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "message.send",
      "reason": "通过宿主统一会话管线发送角色消息。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "tool.invoke",
      "reason": "通过声明的主动消息工具执行页面操作。",
      "required": true,
      "scope": "extension"
    }
  ],
  "lifecycle": {
    "backgroundTasks": true,
    "networkAccess": false,
    "sandbox": true
  },
  "integrity": {
