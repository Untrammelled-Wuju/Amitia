{
  "manifestVersion": 1,
  "extension": {
    "id": "com.amitia/proactive",
    "name": {
      "default": "主动任务"
    },
    "description": {
      "default": "为角色提供主动任务规则、调度、发送、历史记录和独立启停能力。"
    },
    "version": "1.0.9",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "companion",
      "messaging"
    ],
    "keywords": [
      "proactive",
      "companion",
      "schedule",
      "reminder"
    ]
  },
  "publisher": {
    "id": "com.amitia",
    "displayName": "Amitia",
    "trustLevel": "official"
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "placement": "cloud",
  "modules": [
    {
      "id": "proactive-runtime",
      "name": {
        "default": "主动任务运行时"
      },
      "description": {
        "default": "使用宿主唯一调度账本管理主动任务，支持本地与云端。"
      },
      "type": "javascript",
      "placement": "cloud",
      "runtime": {
        "type": "javascript",
        "entryPoint": "dist/index.js",
        "timeout": "120s",
        "memory": 134217728,
        "maxSubprocesses": 0,
        "capabilities": {
          "network": false,
          "filesystem": false
        }
      },
      "contributions": [
        {
          "id": "proactive-command",
          "kind": "tool",
          "name": {
            "default": "主动任务命令"
          },
          "description": {
            "default": "主动任务插件的内部控制入口。"
          },
          "requiredPermissions": [
            "storage.state.read",
            "storage.state.write",
            "proactive_task.read",
            "proactive_task.create",
            "proactive_task.manage",
            "proactive_task.execute",
            "ui.notify",
            "message.send"
          ],
          "spec": {
            "toolId": "com.amitia/proactive/command",
            "modelName": "proactive_command",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "payload": {
                  "type": "object",
                  "properties": {
                    "scope": {
                      "type": "object",
                      "properties": {
                        "characterId": { "type": "string" },
                        "conversationId": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                },
                "ui_state": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "medium",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          }
        }
      ]
    },
    {
      "id": "proactive-ui",
      "name": {
        "default": "主动任务页面"
      },
      "description": {
        "default": "在角色详情中管理主动任务开关、参数、规则和运行历史。"
      },
      "type": "data_only",
      "placement": "device",
      "contributions": [
        {
          "id": "proactive-character-tab",
          "kind": "ui_page",
          "name": {
            "default": "主动任务"
          },
          "description": {
            "default": "配置角色主动任务规则和发送策略。"
          },
          "spec": {
            "contribution_id": "proactive-character-tab",
            "extension_id": "com.amitia/proactive",
            "module_id": "proactive-ui",
            "kind": "schema_page",
            "slot": {
              "slot_id": "character.detail.tab",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "主动任务"
              },
              "description": {
                "default": "管理主动任务开关、全局参数、规则和运行历史。"
              },
              "icon": "message"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/proactive-ui/desktop/schema.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 220
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            },
            "dispatch": {
              "entry_key": "proactive",
              "cell_id": "proactive"
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行主动任务操作"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/proactive/command"
                },
                "risk_level": "medium"
              }
            ],
            "integrity": {
              "definition_hash": "proactive-character-tab-v1"
            }
          },
          "requiredPermissions": [
            "tool.invoke"
          ]
        },
        {
          "id": "proactive-character-tab-mobile",
          "kind": "ui_page",
          "name": {
            "default": "主动任务"
          },
