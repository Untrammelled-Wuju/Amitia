        {
          "id": "proactive-routes",
          "kind": "ui_provider",
          "name": {
            "default": "主动任务路由"
          },
          "spec": {
            "providerId": "proactive-routes",
            "capability": "route.registry",
            "mode": "replace",
            "priority": 230,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "declarative"
              },
              "electron_windows": {
                "type": "declarative"
              },
              "electron_macos": {
                "type": "declarative"
              },
              "electron_linux": {
                "type": "declarative"
              },
              "mobile": {
                "type": "declarative"
              }
            },
            "metadata": {
              "routes": [
                {
                  "id": "proactive",
                  "path": "/characters/:id/proactive",
                  "providerId": "proactive-page-provider",
                  "capability": "page.provider",
                  "title": "主动任务",
                  "priority": 230
                }
              ]
            }
