  ],
  "permissions": [
    {
      "name": "storage.state.read",
      "reason": "读取主动任务设置；规则与历史由宿主账本查询。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.state.write",
      "reason": "保存主动任务设置；规则与历史由宿主管理。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "message.send",
      "reason": "通过宿主统一会话管线发送角色消息。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "tool.invoke",
      "reason": "通过声明的主动任务工具执行页面操作。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.read",
      "reason": "通过统一主动任务服务管理规则、执行和系统通知。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.create",
      "reason": "通过统一主动任务服务管理规则、执行和系统通知。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.manage",
      "reason": "通过统一主动任务服务管理规则、执行和系统通知。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.execute",
      "reason": "通过统一主动任务服务管理规则、执行和系统通知。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "ui.notify",
      "reason": "通过统一主动任务服务管理规则、执行和系统通知。",
      "required": true,
      "scope": "global"
    }
  ],
  "lifecycle": {
    "backgroundTasks": true,
    "networkAccess": false,
    "sandbox": true
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
