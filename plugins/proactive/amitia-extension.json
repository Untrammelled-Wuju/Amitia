              },
              "description": {
                "default": "管理主动任务开关、全局参数、规则和运行历史。"
              },
              "icon": "message"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/proactive-ui/mobile/schema.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 220
            },
            "visibility": {
              "platforms": [
                "android",
                "ios"
              ]
            },
            "dispatch": {
              "entry_key": "proactive",
              "cell_id": "proactive"
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行主动任务操作"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/proactive/command"
                },
                "risk_level": "medium"
              }
            ],
            "integrity": {
              "definition_hash": "proactive-character-tab-mobile-v1"
            }
          },
          "requiredPermissions": [
            "tool.invoke"
          ]
        },
        {
          "id": "proactive-page",
          "kind": "ui_page",
          "name": {
            "default": "主动任务"
          },
          "description": {
            "default": "管理主动任务规则、全局参数、测试触发和运行历史。"
          },
          "requiredPermissions": [
            "tool.invoke"
          ],
          "spec": {
            "contribution_id": "proactive-page",
            "extension_id": "com.amitia/proactive",
            "module_id": "proactive-ui",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
