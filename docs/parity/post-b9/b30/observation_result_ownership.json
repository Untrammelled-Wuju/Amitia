{
  "resultOwnership": {
    "description": "定义各类结果类型的所有权归属",
    "ownership": {
      "ToolResult": {
        "owner": "Kernel",
        "handler": "kernel/tool_executor",
        "storage": "kernel/result_store",
        "observationPath": "kernel → mindruntime/observability"
      },
      "TaskResult": {
        "owner": "TaskRuntime",
        "handler": "taskRuntime/executor",
        "storage": "taskRuntime/result_store",
        "observationPath": "taskRuntime → mindruntime/reflection"
      },
      "WorkflowResult": {
        "owner": "Workflow",
        "handler": "workflowEngine/executor",
        "storage": "workflow/result_store",
        "observationPath": "workflow → mindruntime/trace_export"
      },
      "Observation": {
        "owner": "MindRuntime",
        "handler": "mindruntime/observability",
        "storage": "mindruntime/snapshot",
        "observationPath": "self"
      }
    },
    "violations": {
      "unauthorizedAccess": 0,
      "ownershipConflict": 0,
      "improperRouting": 0
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
