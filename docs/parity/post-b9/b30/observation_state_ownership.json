{
  "stateOwnership": {
    "description": "定义观察状态的所有权归属",
    "ownership": {
      "toolState": {
        "owner": "Kernel",
        "fields": [
          "lastCallStatus",
          "lastError",
          "consecutiveFailures",
          "lastSuccessAt"
        ],
        "mutationAuthority": "Kernel Only"
      },
      "taskState": {
        "owner": "TaskRuntime",
        "fields": [
          "executionStatus",
          "currentAction",
          "completedSteps",
          "remainingSteps"
        ],
        "mutationAuthority": "TaskRuntime Only"
      },
      "observationFact": {
        "owner": "MindRuntime",
        "fields": [
          "observationId",
          "facts",
          "derivedConclusions",
          "patternMatches"
        ],
        "mutationAuthority": "MindRuntime Only"
      }
    },
    "isolation": {
      "kernelOverreach": 0,
      "taskRuntimeOverreach": 0,
      "mindRuntimeOverreach": 0,
      "crossDomainStateMixing": 0
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
