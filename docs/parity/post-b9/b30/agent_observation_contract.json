{
  "outputContract": {
    "description": "观察输出合同，定义Observation向下游传递的标准结构",
    "outputs": {
      "observation": {
        "fields": [
          "observationId",
          "sourceType",
          "sourceId",
          "status",
          "outcome",
          "facts",
          "errors",
          "metadata",
          "timestamp"
        ],
        "required": ["observationId", "sourceType", "status", "timestamp"]
      },
      "normalizedOutcome": {
        "fields": [
          "outcomeType",
          "rawStatus",
          "mappedStatus",
          "semanticCategory",
          "actionable",
          "retryable"
        ],
        "required": ["outcomeType", "mappedStatus"]
      }
    },
    "delivery": {
      "toDecision": true,
      "toMindRuntime": true,
      "toAgentLoop": true
    },
    "validation": {
      "invalidOutputs": 0,
      "missingFields": 0,
      "schemaViolations": 0
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
