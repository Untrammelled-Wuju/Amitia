{
  "futureMemoryInput": {
    "description": "未来记忆模块将使用的可持久化Observation Facts定义",
    "eligibleFacts": {
      "executionOutcome": {
        "type": "observation.facts.outcome",
        "eligibility": "confirmed_success_or_failure",
        "reason": "记录已确认的执行结果",
        "fields": ["outcomeType", "summary", "context", "timestamp"]
      },
      "userPreference": {
        "type": "observation.facts.userResponse",
        "eligibility": "explicit_preference_indication",
        "reason": "捕获用户偏好",
        "fields": ["preferenceType", "value", "confidence", "source"]
      },
      "patternRecognition": {
        "type": "observation.facts.pattern",
        "eligibility": "repeating_or_significant",
        "reason": "记录识别到的模式",
        "fields": ["patternType", "evidence", "frequency", "significance"]
      },
      "resourceKnowledge": {
        "type": "observation.facts.resource",
        "eligibility": "reusable_information",
        "reason": "记录可复用的资源信息",
        "fields": ["resourceType", "resourceId", "availability", "performance"]
      },
      "errorKnowledge": {
        "type": "observation.facts.error",
        "eligibility": "recurring_or_critical",
        "reason": "记录错误知识以防重复",
        "fields": ["errorType", "frequency", "remediation", "impact"]
      }
    },
    "delivery": {
      "to": "agent/tool/memory",
      "format": "StructuredFacts",
      "protocol": "deferred"
    },
    "policy": {
      "b30PersistsMemory": false,
      "deferredToStep": "B32"
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
