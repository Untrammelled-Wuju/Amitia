{
  "futureReflectionInput": {
    "description": "未来反思模块将使用的Observation输入定义",
    "inputs": {
      "goalTrace": {
        "type": "observation.facts.goalExecution",
        "required": true,
        "purpose": "Goal执行轨迹追踪",
        "fields": ["goalId", "startTime", "endTime", "status", "evidence"]
      },
      "candidateTrace": {
        "type": "observation.facts.candidateExecution",
        "required": true,
        "purpose": "Candidate执行轨迹追踪",
        "fields": ["candidateId", "parentGoalId", "selectionReason", "outcome"]
      },
      "evaluationTrace": {
        "type": "observation.facts.evaluation",
        "required": true,
        "purpose": "评估过程追踪",
        "fields": ["evaluatorType", "criteria", "scores", "rationale"]
      },
      "selectionTrace": {
        "type": "observation.facts.selection",
        "required": true,
        "purpose": "选择过程追踪",
        "fields": ["options", "decision", "reasoning"]
      },
      "planTrace": {
        "type": "observation.facts.planExecution",
        "required": true,
        "purpose": "Plan执行轨迹追踪",
        "fields": ["planId", "steps", "executionOrder", "resultByStep"]
      },
      "actionTrace": {
        "type": "observation.facts.actionExecution",
        "required": true,
        "purpose": "Action执行轨迹追踪",
        "fields": ["actionId", "input", "output", "duration", "status"]
      },
      "observationTrace": {
        "type": "observation.fullRecord",
        "required": true,
        "purpose": "完整Observation记录",
        "fields": ["observationId", "allFacts", "allErrors", "metadata"]
      }
    },
    "delivery": {
      "to": "mindruntime/reflection_run",
      "format": "ObservationRecordSet",
      "protocol": "async"
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
