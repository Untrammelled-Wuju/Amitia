{
  "futureReplanningInput": {
    "description": "未来重规划模块将使用的Observation输入定义",
    "inputs": {
      "error": {
        "type": "observation.errors",
        "required": true,
        "purpose": "提供错误类型和来源信息",
        "fields": ["errorCode", "errorMessage", "source", "timestamp"]
      },
      "retryable": {
        "type": "observation.normalizedOutcome.retryable",
        "required": true,
        "purpose": "指示是否可重试",
        "fields": ["retryable", "maxRetries", "retryBackoff"]
      },
      "unavailable": {
        "type": "observation.facts.resourceStatus",
        "required": false,
        "purpose": "记录资源不可用信息",
        "fields": ["resourceType", "resourceId", "unavailableReason", "retryAfter"]
      },
      "denied": {
        "type": "observation.errors",
        "required": false,
        "purpose": "记录权限/范围拒绝信息",
        "fields": ["deniedResource", "deniedAction", "denialReason", "remediation"]
      },
      "failureContext": {
        "type": "observation.facts",
        "required": false,
        "purpose": "提供失败上下文用于重规划",
        "fields": ["executionPhase", "partialResult", "affectedSteps"]
      }
    },
    "delivery": {
      "to": "decision/replanning",
      "format": "NormalizedObservationContract",
      "protocol": "sync"
    }
  },
  "status": "PASS_NO_CODE_CHANGE"
}
