{
  "schemaVersion": 1,
  "exitConditions": [
    {
      "adapterId": "TOOL_MIGRATION",
      "condition": "所有builtin handler迁移为Kernel builtin ToolDefinition",
      "metric": "builtin_tool_migration_complete = true",
      "targetStep": "B140后清理tool_migration辅助代码"
    },
    {
      "adapterId": "SKILL_MIGRATION",
      "condition": "所有Legacy AgentSkill迁移到AgentSkillCatalog + 生成ToolMapping",
      "metric": "legacy_skill_count -> 0 (通过AgentSkills.GetAll验证)"
    },
    {
      "adapterId": "MCP_MIGRATION",
      "condition": "MCP Server注册稳定通过ToolFacade.SyncMCPTools",
      "metric": "old_mcp_tool_registration_calls = 0"
    },
    {
      "adapterId": "WORKFLOW_MIGRATION",
      "condition": "Legacy Workflow definition全部迁移到Kernel Workflow",
      "metric": "legacy_workflow_compiler_calls = 0"
    },
    {
      "adapterId": "PLUGIN_MIGRATION",
      "condition": "所有Go Plugin迁移为Kernel Extension",
      "metric": "legacy_plugin_start_count = 0"
    },
    {
      "adapterId": "AMITIAX_MIGRATION",
      "condition": ".amitiax v1包系统被Kernel Package取代",
      "metric": "legacy_package_write_calls = 0 AND legacy_package_read_calls = 0"
    },
    {
      "adapterId": "DATA_MIGRATION",
      "condition": "所有extension数据存储迁移到kernel.db",
      "metric": "old_extension_data_access = 0"
    },
    {
      "adapterId": "LEGACY_RUNTIME_ADAPTER",
      "condition": "No ToolDefinition references RuntimeBinding=legacy",
      "metric": "adapter_legacy.Execute count = 0"
    }
  ],
  "zeroWindowProofRequired": true,
  "zeroWindowProofStep": "B140/B141/B151",
  "allConditionsDefined": true
}
