{
  "schemaVersion": 1,
  "chainId": "B9P6-PRODUCTION-RUNTIME-CHAIN",
  "verified": true,
  "chain": [
    {
      "step": "ToolDefinition Lookup",
      "source": "ExecutionPipeline.resolveTool via ToolRegistry.Get/GetByModelName",
      "output": "capability.ToolDefinition"
    },
    {
      "step": "RuntimeBinding Identification",
      "source": "ToolDefinition.RuntimeBinding field",
      "values": ["javascript", "wasm", "task", "mcp", "workflow", "plugin", "trusted_service", "host_internal", "legacy"]
    },
    {
      "step": "Gate Processing",
      "source": "Scope/Permission/Availability/Approval gates",
      "decision": "Allow or Deny"
    },
    {
      "step": "RuntimeDispatcher",
      "source": "ExecutionPipeline.Dispatcher (backend/internal/extension/kernel/execution/dispatcher.go)",
      "uses": "RuntimeAdapterRegistry.Lookup"
    },
    {
      "step": "RuntimeAdapter Selection",
      "source": "RuntimeAdapterRegistry matching by RuntimeBinding.Type",
      "output": "Matching RuntimeAdapter instance"
    },
    {
      "step": "Provider Execution",
      "source": "Adapter.Execute(ctx, invocation, input)",
      "providers": [
        "JavaScript Runtime (jsRuntime)",
        "WASMRuntime",
        "TaskRuntime",
        "MCP Remote Tool",
        "Workflow Executor",
        "Plugin Host",
        "Trusted Service Process",
        "Host Internal Dispatcher",
        "Legacy Migration Adapter (temporary)"
      ]
    },
    {
      "step": "UnifiedToolResult",
      "source": "Adapter returns UnifiedToolResult",
      "fields": ["Status", "Content", "Error", "SideEffects", "Structured"]
    }
  ],
  "failClosed": "Tool without RuntimeBinding returns error from resolver",
  "parallelRuntimeFound": false
}
