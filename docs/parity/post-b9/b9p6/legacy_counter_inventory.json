{
  "schemaVersion": 1,
  "counter": {
    "path": "backend/internal/extension/kernel/legacy_call_counter.go",
    "globalInstance": "kernel.GlobalLegacyCallCounter()",
    "sha256Verified": true,
    "metrics": [
      "legacy_tool_execute_calls",
      "legacy_model_tools_calls",
      "legacy_prompt_hook_calls",
      "legacy_mcp_execute_calls",
      "legacy_package_write_calls",
      "legacy_package_read_calls",
      "legacy_plugin_start",
      "legacy_plugin_dispatch",
      "legacy_package_install",
      "legacy_skill_execute",
      "legacy_mcp_tool_register",
      "legacy_schedule_tick",
      "duplicate_mcp_tool_registrations",
      "duplicate_contribution_registrations",
      "orphan_runtime_instances",
      "orphan_ui_sessions",
      "failed_cleanup_resources"
    ],
    "consumers": [
      "kernel/final_gate.go - gates on metric thresholds",
      "devConsole - displays metric snapshots",
      "ToolFacade counters - feeds into FinalGateMetrics"
    ]
  },
  "toolFacadeCounters": {
    "path": "backend/internal/extension/kernel/tool_facade_counters.go",
    "counters": ["prepare_agent_skill_prompt", "before_prompt", "model_tools", "execute_model_tool", "after_reply", "end_agent_skill_round"]
  },
  "purpose": "Track legacy system usage for eventual zero-legacy cutover evidence"
}
