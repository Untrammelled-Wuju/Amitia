{
  "schemaVersion": 1,
  "registrationPaths": [
    {
      "pathId": "BUILTIN_MIGRATION",
      "source": "backend/internal/extension/kernel/tool_migration/",
      "target": "ToolRegistry.Register/BatchRegister",
      "description": "Built-in tool IDs migrated to Kernel ToolRegistry"
    },
    {
      "pathId": "EXTENSION_CONTRIBUTION",
      "source": "backend/internal/extension/kernel/contribution/",
      "target": "ToolRegistry via ContributionInstaller",
      "description": "Extension contributions register tools through Kernel"
    },
    {
      "pathId": "MCP_SYNC",
      "source": "backend/cmd/server/tool_facade_wiring.go (mcpToolFacadeSyncerAdapter)",
      "target": "ToolFacade.SyncMCPTools -> ToolRegistry.BatchRegister",
      "description": "MCP remote tools synchronized through ToolFacade"
    },
    {
      "pathId": "WORKFLOW",
      "source": "backend/internal/extension/kernel/workflow/",
      "target": "WorkflowRuntimeAdapter -> ToolRegistry (if exposed as Agent Tool)",
      "description": "Workflow tools registered through adapter pattern"
    },
    {
      "pathId": "SKILL_MIGRATION",
      "source": "backend/internal/extension/kernel/skill_migration/",
      "target": "ToolRegistry via legacy-to-canonical mapping",
      "description": "Legacy Agent Skills migrated to Kernel Tool definitions"
    },
    {
      "pathId": "AGENT_SKILL_PROMPT",
      "source": "backend/internal/extension/kernel/agent_skill/",
      "target": "ToolFacade.PrepareAgentSkillPrompt (prompt only, not tool registration)",
      "description": "Agent Skill contributes to prompt, may provide ToolMappings"
    }
  ],
  "canonicalTargetId": "backend/internal/extension/kernel/capability.ToolRegistry",
  "dualRegistrationDetected": false
}
