{
  "schemaVersion": 1,
  "taskId": "B9P6-HOOK-EVENT-SCHEDULE-WIRING",
  "hook": {
    "canonicalPath": "backend/internal/extension/kernel/hook/service.go",
    "registry": "backend/internal/extension/kernel/hook/registry.go",
    "integrationPoint": "ToolFacade.BeforePrompt / ToolFacade.AfterReply",
    "usesPermissionBroker": true,
    "usesScopeManager": true,
    "role": "DOMAIN_HOOK_SYSTEM",
    "notDuplicate": true
  },
  "event": {
    "canonicalPath": "backend/internal/extension/kernel/event/service.go",
    "subscriptionRegistry": "backend/internal/extension/kernel/event/event_subscription_registry.go",
    "schemaRegistry": "backend/internal/extension/kernel/event/event_schema_registry.go",
    "role": "DOMAIN_EVENT_SYSTEM",
    "notDuplicate": true
  },
  "schedule": {
    "canonicalPath": "backend/internal/extension/kernel/schedule/service.go",
    "role": "DOMAIN_SCHEDULE_SYSTEM",
    "usesPermissionBroker": "schedule.NewBrokerPermissionChecker(permBroker, scheduleRepo)",
    "usesScopeManager": "schedule.NewManagerScopeChecker(scopeManager, scheduleRepo, scopeStore)",
    "targetAdapter": "schedule.NewToolTargetAdapter(NewKernelToolExecutorAdapter(executionKernel))",
    "notDuplicate": true
  },
  "noSecondHookSystem": true,
  "noSecondEventBus": true,
  "noSecondScheduler": true
}
