{
  "schemaVersion": 1,
  "taskId": "B19",
  "generatedAt": "2026-08-08T15:07:00+08:00",
  "description": "Android Bridge Protocol合同 - 跨端传输层DTO定义",

  "transport": {
    "mechanism": "MethodChannel (Flutter) - 'com.amitia.amitia_app/runtime'",
    "note": "复用A线已有Bridge，不新建第二IPC"
  },

  "protocolDTO": {
    "androidBridgeRequest": {
      "fields": {
        "protocolVersion": "int - 协议版本 (currently 1)",
        "requestId": "string - 调用ID，对应ToolInvocationContext.InvocationID",
        "operation": "string - provider/capability操作标识 (provider定义)",
        "payload": "map[string]any - 操作参数"
      },
      "constraints": "transport-only，不含业务逻辑"
    },
    "androidBridgeResponse": {
      "fields": {
        "protocolVersion": "int - 协议版本",
        "requestId": "string - 原调用ID",
        "status": "string - success/failed/cancelled/timeout",
        "result": "map[string]any - 执行结果 (Provider domain DTO)",
        "error": "object - {code, message, domainCode} (when failed)"
      },
      "constraints": "Bridge Response不是Runtime事实源，Adapter负责归一"
    }
  },

  "requestIdentity": {
    "source": "ToolInvocationContext.InvocationID",
    "propagation": "Adapter传递InvocationID到AndroidBridgeRequest.requestId",
    "correlation": "AndroidBridgeResponse.requestId必须等于AndroidBridgeRequest.requestId"
  },

  "cancellation": {
    "mechanism": "ctx.Done()监听",
    "implementation": "Adapter.Execute监听ctx.Done()，触发时可选择发送cancel消息到Bridge",
    "note": "如不支持cancel传播则返回ToolResultStatusCancelled"
  },

  "deadline": {
    "mechanism": "ctx.Deadline()",
    "implementation": "Adapter.Execute必须遵守context deadline",
    "note": "超时返回ToolResultStatusTimedOut"
  },

  "errors": {
    "bridgeErrorCodes": [
      "BRIDGE_DISCONNECTED - MethodChannel断开",
      "BRIDGE_TIMEOUT - 调用超时",
      "BRIDGE_INVALID_RESPONSE - 响应格式错误"
    ],
    "mapping": "Bridge Error → ToolError(ErrorCodeConnectionLost/ErrorCodeTimeout/ErrorCodeInternalError)"
  },

  "version": {
    "current": 1,
    "note": "如果现有MethodChannel无版本字段，Adapter内部使用DTO版本控制"
  }
}
