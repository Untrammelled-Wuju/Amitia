{
  "schemaVersion": 1,
  "taskId": "B13",
  "package": "backend/pkg/resourceuri",
  "scheme": "amitia",
  "roots": [
    {"name": "workspace", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "attachments", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "data", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "cache", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "runtime", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "config", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "extensions", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "logs", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "temp", "type": "ResourceRoot", "filesystem": true, "virtual": false},
    {"name": "native", "type": "ResourceRoot", "filesystem": false, "virtual": true}
  ],
  "types": [
    "ResourceURI (struct: root + relativePath)",
    "ResourceRoot (string type)",
    "ResourceKind (int enum: Filesystem, Virtual)",
    "ResolvedResource (struct: URI + Kind + LocalPath)",
    "ResourceResolver (interface: Resolve + Reverse)",
    "PhysicalRoots (struct: 10 string fields)",
    "PhysicalResolver (struct: rootFor map + keys slice)"
  ],
  "parsers": [
    "Parse(raw string) (ResourceURI, error)",
    "MustParse(raw string) ResourceURI",
    "parseResourceRoot(value string) (ResourceRoot, error)",
    "normalizeAndValidatePath(rawPath string) (string, error)"
  ],
  "builders": [
    "PhysicalRootsFromRuntimePaths(paths util.RuntimePaths) PhysicalRoots",
    "NewPhysicalResolver(roots PhysicalRoots) (*PhysicalResolver, error)"
  ],
  "normalizers": [
    "normalizeAndValidatePath: URL-decode, backslash reject, control char reject, dot-segment collapse, path.Clean, traversal detection"
  ],
  "resolvers": [
    "Resolve(uri ResourceURI) (ResolvedResource, error) — via ResourceResolver interface and PhysicalResolver"
  ],
  "reverseResolvers": [
    "Reverse(localPath string) (ResourceURI, error) — via ResourceResolver interface and PhysicalResolver; longest-match root priority"
  ],
  "securityControls": [
    "Scheme must be amitia:// (case-insensitive prefix, exact scheme match)",
    "Root must be in allow-list",
    "Backslash rejected in logical URI (prevents Windows separator bypass)",
    "Null byte rejected",
    "Control characters rejected",
    "Path traversal (.. segment) rejected both raw and percent-encoded",
    "Percent-encoded traversal (%2e%2e) rejected via post-decode traversal check",
    "Fragment (#) rejected",
    "Query (?) rejected",
    "UserInfo (@) rejected",
    "Port rejected",
    "path.Clean + residual '..' prefix check as defense-in-depth",
    "Physical Resolver: assertWithinRoot ensures resolved path stays inside configured root",
    "Physical Resolver: Reverse rejects paths outside all known roots (ErrResourceOutsideRoots)",
    "Virtual root (native) returns ErrNonFilesystemResource without touching filesystem"
  ],
  "productionCallers": [
    "backend/config/config.go — Parse",
    "backend/internal/scriptruntime/sidecar/resolver.go — PhysicalRootsFromRuntimePaths, NewPhysicalResolver, Parse",
    "backend/internal/scriptruntime/nodeenv/resolver.go — PhysicalRootsFromRuntimePaths, NewPhysicalResolver, Parse",
    "backend/internal/vectorstore/qdrantlayout/resolver.go — PhysicalRootsFromRuntimePaths, NewPhysicalResolver, MustParse",
    "backend/internal/vectorstore/qdrantenv/resolver.go — Parse, PhysicalRootsFromRuntimePaths, NewPhysicalResolver",
    "backend/internal/vectorstore/qdrantenv/candidates.go — Parse",
    "backend/internal/extension/kernel/script_host/resolver.go — PhysicalRootsFromRuntimePaths, NewPhysicalResolver, Parse"
  ]
}
