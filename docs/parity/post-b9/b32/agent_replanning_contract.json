{
  "contract": {
    "name": "Replanning / Goal Continuation Contract",
    "version": "B32",
    "input": {
      "canonicalGoal": "decision.GoalRegistry.Get(id)",
      "currentGoalState": "GoalStatus enum",
      "goalProgressDecision": "B31 output (UNCHANGED/PROGRESSED/SATISFIED/BLOCKED/FAILED/WAITING)",
      "canonicalObservation": "B30 normalized observation",
      "lastCandidateRef": "previous BehaviorCandidate",
      "lastPlanRef": "previous BehaviorPlan",
      "lastActionRef": "previous ToolFacade invocation",
      "errorFact": "B30 error semantics",
      "retryableFact": "B30 retryable projection",
      "sideEffectFact": "B30 side effect semantics",
      "waitingBlockingFact": "wait/blocked category",
      "supersessionFact": "B31 supersession state"
    },
    "output": {
      "decision": "STOP | CONTINUE | WAIT | ASK_USER | BLOCKED",
      "reasonCode": "structurerd reason enum",
      "nextCycleRef": "if CONTINUE, new Decision Cycle ID"
    },
    "decisionLogic": {
      "STOPconditions": [
        "GoalStatus == achieved",
        "GoalStatus == abandoned",
        "Superseded Goal"
      ],
      "WAITconditions": [
        "WAITING_USER",
        "WAITING_EXTERNAL",
        "Pending Task/Workflow running",
        "Awaiting Approval"
      ],
      "CONTINUEconditions": [
        "GoalStatus == active AND GoalProgress == progressed/unchanged AND no loop guard triggered"
      ],
      "BLOCKEDconditions": [
        "Goal blocked by permission/runtime/dependency"
      ],
      "ASK_USERconditions": [
        "Goal requires user input to proceed",
        "No viable candidate without user info"
      ]
    }
  }
}
