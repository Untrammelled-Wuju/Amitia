{
  "schemaVersion": 1,
  "taskId": "B15",
  "note": "State Projection从B9P8 final_state_projection_manifest.json读取。各Domain State独立。",
  "authority": "各Domain独立State，无统一Media State Store",
  "domains": {
    "imageGeneration": {
      "owner": "SubmissionState (accepted/processing/succeeded/failed/unknown)",
      "projectedTo": "Tool result status if exposed as Agent Tool"
    },
    "vision": {
      "owner": "Chat Pipeline Status",
      "projectedTo": "N/A (internal call)"
    },
    "asr": {
      "owner": "VoiceTurn.Status (interim/final/cancel)",
      "projectedTo": "Realtime UI"
    },
    "tts": {
      "owner": "Synchronous operation, caller-managed",
      "projectedTo": "Chat Pipeline Status"
    },
    "realtime": {
      "owner": "VoiceSessionState + Turn states",
      "projectedTo": "UI session indicator"
    },
    "browser": {
      "owner": "BrowserSessionState + BrowserTabState (B14)",
      "projectedTo": "Browser tool status"
    }
  },
  "noGlobalStateStore": true,
  "noUnifiedMediaStateStore": true
}
