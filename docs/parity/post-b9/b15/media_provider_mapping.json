{
  "schemaVersion": 1,
  "taskId": "B15",
  "note": "Provider事实源保持Domain独立，不建立统一MediaProviderRegistry。",
  "image": {
    "authority": "imageprovider.Registry",
    "providers": ["seedream", "stability", "tongyi"],
    "configAuthority": "imagegen.Service (DB: image_gen_configs)"
  },
  "vision": {
    "authority": "vision.Service",
    "providers": ["volcengine", "gemini", "openai-compatible"],
    "configAuthority": "vision.Service (DB: vision_configs)"
  },
  "asr": {
    "authority": "asr.Service",
    "providers": ["volcengine"],
    "configAuthority": "asr.Service (DB: asr_configs)"
  },
  "tts": {
    "authority": "tts.Service + Engine",
    "providers": ["volcengine", "openai", "azure", "edge", "elevenlabs", "minimax", "aliyun", "cosyvoice"],
    "configAuthority": "tts.Service (DB: tts_configs)"
  },
  "realtime": {
    "authority": "realtime.Protocol + VoiceSession",
    "providers": ["volcano"],
    "configAuthority": "tts.Config (realtime fields)"
  },
  "browser": {
    "authority": "browser.Provider (B14 types only)",
    "note": "Production implementation B79-B83"
  },
  "sharedProviderRegistryRequired": false
}
