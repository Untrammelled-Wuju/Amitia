{
  "schemaVersion": 1,
  "inputId": "B44-QuotaTimeout",
  "intendedFor": "Resource Quota step (future)",
  "description": "超时与配额的分离说明输入",
  "distinctions": {
    "timeBudget": {
      "description": "工具执行的时间预算",
      "authority": "B44 TimeoutController (Deadline Enforcement)",
      "unit": "time.Duration"
    },
    "cpuQuota": {
      "description": "CPU 计算配额",
      "authority": "Resource Quota system (future)",
      "unit": "CPU time"
    },
    "memoryQuota": {
      "description": "内存配额",
      "authority": "Resource Quota system (future)",
      "unit": "bytes"
    },
    "streamQuota": {
      "description": "流输出配额",
      "authority": "Stream Quota system (future)",
      "unit": "bytes/events"
    }
  },
  "invariant": "timeBudget ≠ cpuQuota ≠ memoryQuota ≠ streamQuota；各自独立计量，超时触发 TimedOut 终态；其他配额耗尽触发 QuotaExceeded"
}
