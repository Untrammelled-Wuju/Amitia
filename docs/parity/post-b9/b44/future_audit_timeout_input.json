{
  "schemaVersion": 1,
  "inputId": "B44-AuditTimeout",
  "intendedFor": "Audit step (future)",
  "description": "Timeout 审计追踪输入",
  "auditFields": {
    "invocationId": {
      "description": "被取消/超时的调用 ID",
      "source": "ToolInvocationContext.InvocationID"
    },
    "deadlineSource": {
      "description": "Deadline 来源标识",
      "values": ["invocation.ExpiresAt", "tool.TimeoutMS", "default.30s", "parent.context"]
    },
    "effectiveDeadline": {
      "description": "实际生效的 Deadline",
      "computation": "min(parentDeadline, toolTimeout, expiresAt, default)"
    },
    "timeoutObservedTime": {
      "description": "超时事件被接受的时间戳 (UTC)"
    },
    "runtimeProviderState": {
      "description": "超时时刻 Runtime/Provider 的状态",
      "values": ["executing", "awaiting_response", "streaming", "non_interruptible"]
    },
    "cancellationOutcome": {
      "description": "B43 Cancellation 触达 Provider 的结果",
      "values": ["provider_stopped", "provider_unresponsive", "non_interruptible_continue"]
    },
    "lateResultDiscarded": {
      "description": "超时后是否收到迟到结果并被丢弃"
    },
    "finalState": {
      "description": "最终 ToolResult 状态",
      "value": "timed_out"
    }
  },
  "privacyConstraints": {
    "noPayloadInAudit": true,
    "noSecretInDeadline": true
  }
}
