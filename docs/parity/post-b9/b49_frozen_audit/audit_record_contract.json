{
  "allowedFields": [
    "TraceID", "OperationID", "InvocationID", "AttemptID", "ParentID",
    "CapabilityID", "ToolID", "RuntimeType", "RuntimeID",
    "ActorType", "ActorID", "UserID", "CharacterID", "ConversationID",
    "ScopeSnapshotID", "Status", "ApprovalMode",
    "InputHash", "OutputHash", "InputSummary", "OutputSummary",
    "ErrorCode", "ErrorSummary", "RiskLevel",
    "RetryCount", "SideEffectCount",
    "DurationMs", "CreatedAt", "StartedAt", "FinishedAt"
  ],
  "forbiddenFields": [
    "Raw Secret", "API Key", "OAuth Token", "Password",
    "Private Key", "Authorization Header", "Cookie",
    "Full Prompt", "Hidden Reasoning", "Chain-of-Thought",
    "Arbitrary Provider Object", "Unbounded Metadata",
    "Physical Path (unless dev-only and redacted)"
  ],
  "sizeBounds": {
    "errorMessage": "truncated at N chars",
    "metadata": "typed map with allowlist only",
    "resourceRefs": "URI only (amitia://...), not absolute paths"
  }
}
