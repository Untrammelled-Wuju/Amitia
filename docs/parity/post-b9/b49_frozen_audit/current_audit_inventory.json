{
  "operationModels": [
    {
      "path": "backend/internal/extension/kernel/observability/types.go",
      "type": "OperationRecord",
      "purpose": "Canonical Operation record with TraceID, ParentOpID, Actor, Subject, Status, RiskLevel, Outcome"
    }
  ],
  "invocationModels": [
    {
      "path": "backend/internal/extension/kernel/observability/types.go",
      "type": "InvocationRecord",
      "purpose": "Canonical Invocation with TraceID, OperationID, ParentID, Runtime, User/Character/Conversation, Status, Hashes"
    },
    {
      "path": "backend/internal/extension/kernel/developer_console/repository.go",
      "type": "InvocationRecord",
      "purpose": "Developer Console diagnostic projection — in-memory, not canonical"
    }
  ],
  "attemptModels": [
    {
      "path": "backend/internal/extension/kernel/observability/types.go",
      "type": "ExecutionAttempt",
      "purpose": "Canonical attempt with InvocationID, AttemptNumber, Runtime, Status, Retryable"
    }
  ],
  "auditModels": [
    {
      "path": "backend/internal/extension/kernel/observability/types.go",
      "type": "AuditEvent",
      "purpose": "Canonical audit event"
    },
    {
      "path": "backend/internal/extension/kernel/execution/audit.go",
      "type": "AuditRecorder + AuditEntry",
      "purpose": "Memory-only audit store (records map[string]*AuditEntry) — used by production ExecutionPipeline"
    }
  ],
  "traceModels": [
    {
      "path": "backend/internal/extension/kernel/observability/types.go",
      "type": "Trace",
      "purpose": "Canonical trace with TraceID, RootOpID, Metadata"
    }
  ],
  "auditRecorders": [
    {
      "path": "backend/internal/extension/kernel/execution/audit.go",
      "type": "AuditRecorder",
      "role": "Production execution audit tracker (memory)"
    }
  ],
  "auditWriters": [
    {
      "path": "backend/internal/extension/kernel/observability/writer.go",
      "type": "DefaultRecordWriter (implements RecordWriter)",
      "role": "Canonical async record writer with bounded queue (MaxQueueSize=10000), Flush/Close"
    }
  ],
  "persistentRepositories": [
    {
      "path": "backend/internal/extension/kernel/observability/storage.go",
      "type": "StorageBackend interface",
      "role": "Canonical persistence interface: TraceStore, OperationStore, InvocationStore, AttemptStore, RuntimeEventStore, AuditEventStore, ErrorRecordStore"
    }
  ],
  "memoryRepositories": [
    {
      "path": "backend/internal/extension/kernel/execution/audit.go",
      "type": "AuditRecorder{ records map[string]*AuditEntry }",
      "role": "In-memory production execution audit"
    },
    {
      "path": "backend/internal/extension/kernel/developer_console/repository.go",
      "type": "DiagnosticRepository",
      "role": "Developer Console diagnostic cache (maxItems capped)"
    }
  ],
  "diagnosticRepositories": [
    {
      "path": "backend/internal/extension/kernel/developer_console/repository.go",
      "type": "DiagnosticRepository",
      "role": "DevConsole diagnostic projection with bounded maxItems"
    }
  ],
  "auditConsumers": [
    {
      "path": "Developer Console",
      "role": "UI projection"
    },
    {
      "path": "observability query API",
      "role": "Canonical audit query"
    }
  ],
  "productionWritePaths": [
    {
      "entry": "ExecutionPipeline.Execute",
      "auditCall": "AuditRec.RecordStart/RecordFinish/RecordDenied/RecordRetry",
      "target": "execution.AuditRecorder (memory)",
      "persistent": false
    }
  ]
}
