{
  "entrypoints": [
    {
      "entrypoint": "ExecutionPipeline.Execute (production path)",
      "writeTarget": "execution.AuditRecorder (memory)",
      "productionReachable": true,
      "legacyReachable": false,
      "authority": "false (memory only)",
      "persistent": false
    },
    {
      "entrypoint": "observability.DefaultRecordWriter (canonical)",
      "writeTarget": "observability.StorageBackend",
      "productionReachable": false,
      "authority": "true (canonical)",
      "persistent": true,
      "note": "Created but not wired to production executions"
    },
    {
      "entrypoint": "Developer Console DiagnosticRepository",
      "writeTarget": "in-memory diagnostic cache",
      "productionReachable": false,
      "authority": "false (diagnostic projection)",
      "persistent": false
    }
  ],
  "summary": "Production executions produce audit only in memory; canonical observability persistence is unused by production tools"
}
