{
  "policies": [
    {
      "type": "HIGH_RISK_SECURITY_AUDIT",
      "criteria": "Permission decisions, approval outcomes, secret use metadata, extension install/update/uninstall",
      "delivery": "synchronous committed (HighRiskSyncWrite=true for critical/high risk)"
    },
    {
      "type": "NORMAL_EXECUTION_AUDIT",
      "criteria": "Success/failure tool invocations, runtime events",
      "delivery": "bounded async (queue MaxQueueSize=10000, batching)"
    },
    {
      "type": "DIAGNOSTIC",
      "criteria": "Developer Console projection, dev-only metadata",
      "delivery": "best-effort cache (capped at maxItems)"
    }
  ]
}
