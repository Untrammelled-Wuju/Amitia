{
  "createGoal": {
    "owner": "decision.GoalRegistry.Register",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "updateGoalState": {
    "owner": "decision.GoalRegistry.UpdateStatus",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "completeGoal": {
    "owner": "decision.GoalRegistry.UpdateStatus(id, GoalStatusAchieved, progress)",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "failGoal": {
    "owner": "decision.GoalRegistry.UpdateStatus(id, GoalStatusAbandoned, _)",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "cancelGoal": {
    "owner": "decision.GoalRegistry.UpdateStatus(id, GoalStatusAbandoned, _)",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "supersedeGoal": {
    "owner": "decision.GoalRegistry.UpdateStatus(id, GoalStatusAbandoned/Suspended, _) + Register(newGoal)",
    "path": "backend/internal/decision/goal_registry.go"
  },
  "unknownGoalMutatorCount": 0,
  "detail": "所有Goal mutation都集中在GoalRegistry。所有方法都受RWMutex保护，状态更新与progress更新原子完成。"
}
