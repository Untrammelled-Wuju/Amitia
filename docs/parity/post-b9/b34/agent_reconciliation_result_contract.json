{
  "schemaVersion": 1,
  "generatedAt": "2026-08-08T23:50:00+08:00",
  
  "name": "Agent Reconciliation Result Contract",
  
  "resultShape": {
    "runId": "string - 本次 reconciliation run 唯一标识",
    "status": "CONSISTENT | DRIFT | PARTIAL | DEGRADED | BLOCKED",
    "scanned": "int - 扫描实体数",
    "diffCount": "int - 发现差异总数",
    "severityCounts": {
      "critical": 0,
      "high": 0,
      "warning": 0,
      "info": 0,
      "low": 0
    },
    "repairableCount": "int - 可自动修复数",
    "repairedCount": "int - 已修复数",
    "unresolvedCount": "int - 未解决数",
    "sourceFailures": "[]SourceFailure - 不可用的 source 列表",
    "safeCheckpoint": "bool - 是否安全执行 B35 Checkpoint",
    "safeResume": "bool - 是否安全恢复",
    "unknownOutcomes": "[]string - 无法确定结果的状态引用"
  },
  
  "rules": {
    "unresolvedHighSeverityCount > 0": {
      "safeCheckpoint": true,
      "safeResume": false,
      "note": "允许保存 Recovery Required 状态，但不允许直接恢复"
    },
    "sourceUnavailable": {
      "status": "DEGRADED 或 PARTIAL",
      "mustNotReport": "CONSISTENT"
    },
    "allConsistent": {
      "status": "CONSISTENT",
      "safeCheckpoint": true,
      "safeResume": true
    }
  }
}
