{
  "reflectionTypes": [
    {
      "name": "mindruntime.RunReflection",
      "description": "核心Reflection Runner，基于Evidence产生ReflectionCandidate",
      "owner": "backend/internal/mindruntime/reflection_run.go"
    },
    {
      "name": "mindruntime.ReflectionCandidate",
      "description": "结构化Reflection输出(BeliefAdjustments, RelationUpdates, MemoryAbstractions)",
      "owner": "backend/internal/mindruntime/reflection_run.go"
    },
    {
      "name": "mindruntime.MergeReflectionCandidates",
      "description": "合并多次Reflection结果",
      "owner": "backend/internal/mindruntime/reflection_run.go"
    }
  ],
  "reflectionTriggers": [
    {
      "kind": "TriggerKindTime",
      "description": "时间触发(默认24h)",
      "owner": "backend/internal/mindruntime/reflection_trigger.go"
    },
    {
      "kind": "TriggerKindEventCount",
      "description": "事件计数触发(默认50事件)",
      "owner": "backend/internal/mindruntime/reflection_trigger.go"
    },
    {
      "kind": "TriggerKindRelationChange",
      "description": "关系变化触发(默认3次)",
      "owner": "backend/internal/mindruntime/reflection_trigger.go"
    },
    {
      "kind": "TriggerKindAnomaly",
      "description": "异常触发(默认anomalyScore>=0.7)",
      "owner": "backend/internal/mindruntime/reflection_trigger.go"
    }
  ],
  "reflectionRunners": [
    {
      "name": "RunReflection",
      "signature": "func(characterID string, evidence ReflectionEvidence, config ReflectionRunConfig, now time.Time) ReflectionCandidate",
      "owner": "reflection_run.go"
    }
  ],
  "reflectionSupervisors": [
    {
      "name": "ReflectionSupervisor",
      "description": "审批、版本管理、回滚、健康检查",
      "owner": "reflection_supervisor.go",
      "capabilities": ["ApproveReflectionCandidate", "ApproveGrowth", "RollbackReflection", "RollbackGrowth", "GetReflectionHistory", "GetActiveReflectionVersions"]
    }
  ],
  "reflectionInputs": [
    {
      "type": "ReflectionEvidence",
      "fields": ["Events[]", "Relations[]", "Memories[]"],
      "description": "已验证的事证据集合"
    }
  ],
  "reflectionOutputs": [
    {
      "type": "ReflectionCandidate",
      "fields": ["ID", "BeliefAdjustments[]", "RelationUpdates[]", "MemoryAbstractions[]", "EvidenceRefs[]", "Confidence"],
      "description": "有证据约束的结构化反思"
    },
    {
      "type": "ReflectionApprovalResult",
      "fields": ["Approved", "Escalated", "RejectedReasons[]"],
      "description": "审批结果"
    }
  ],
  "reflectionStores": [
    {
      "name": "VersionHistory",
      "owner": "supervisor.go / version_rollback.go",
      "description": "Reflection版本历史(用于回滚)"
    }
  ],
  "reflectionConsumers": [],
  "productionCallers": [
    "mindruntime supervisor wiring",
    "future B34 Reconciliation"
  ]
}
