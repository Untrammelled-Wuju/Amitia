{
  "description": "Reflection结论中符合Memory候选条件的内容",
  "memoryCandidates": [
    {
      "type": "reflection_fact_candidate",
      "source": "ReflectionCandidate.BeliefAdjustments",
      "fields": ["beliefKey", "newStrength", "reason", "evidenceRefs"],
      "confidence": "float64",
      "uncertainty": "low if confidence>0.7, medium if 0.5-0.7, high if <0.5"
    },
    {
      "type": "reflection_lesson_candidate",
      "source": "ReflectionCandidate.RelationUpdates",
      "fields": ["relationId", "evidenceCount"],
      "confidence": "float64"
    },
    {
      "type": "reflection_abstraction_candidate",
      "source": "ReflectionCandidate.MemoryAbstractions",
      "fields": ["topic", "abstract", "sourceIDs"],
      "confidence": "float64"
    }
  ],
  "selectionCriteria": {
    "minConfidence": 0.5,
    "minEvidenceRefs": 2,
    "requiresSupervisorApproval": true
  },
  "note": "B33不写Memory。这些候选内容需经后续Memory System(独立步骤)采纳和存储。"
}
