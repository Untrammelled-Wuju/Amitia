{
  "schemaVersion": 1,
  "taskId": "B9P5",
  "domain": "ToolResult",
  "b9ProtocolStatus": "无直接B9对应（ToolExecution和ToolResult是不同的概念）",
  "canonicalDomain": "capability.ToolResultStatus",
  "canonicalStates": ["success", "failed", "cancelled", "timed_out"],
  "semanticDifference": {
    "toolExecution": "执行生命周期状态(queued->running->succeeded/failed/...)",
    "toolResult": "调用的最终结果状态(success/failed/cancelled/timed_out)"
  },
  "guard": {
    "rule": "ToolResultStatus和ExecutionStatus不得合并成一套状态",
    "reason": "ToolResultStatus表示最终结果(action outcome)，ExecutionStatus表示执行生命周期(lifecycle phase)"
  },
  "mappings": [
    {"canonicalState": "success", "b9Equivalent": "ToolExecution.SUCCEEDED", "type": "SEMANTIC_EQUIVALENT"},
    {"canonicalState": "failed", "b9Equivalent": "ToolExecution.FAILED", "type": "SEMANTIC_EQUIVALENT"},
    {"canonicalState": "cancelled", "b9Equivalent": "ToolExecution.CANCELLED", "type": "SEMANTIC_EQUIVALENT"},
    {"canonicalState": "timed_out", "b9Equivalent": "ToolExecution.TIMED_OUT", "type": "SEMANTIC_EQUIVALENT"}
  ],
  "notes": "尽管值名称与B9 ToolExecution的终态重叠，但语义完全不同。ToolResult是一次调用的结果记录，Execution是执行过程的状态机。",
  "summary": {
    "totalStates": 4,
    "mappingType": "NO_PROTOCOL_MAPPING",
    "requiresGuard": true
  }
}
