{
  "schemaVersion": 1,
  "taskId": "B45",
  "matrix": {
    "Android": {
      "kernelPermissionOwner": "PermissionDefinitionRegistry + PermissionBroker",
      "osAuthorizationOwner": "Android OS (SAF/MediaStore/RuntimePermissions/Accessibility)",
      "runtimeProvider": "AndroidRuntimeAdapter",
      "kernelPermissionExamples": ["files.read", "files.write", "desktop.capture"],
      "osAuthExamples": ["READ_EXTERNAL_STORAGE", "MANAGE_EXTERNAL_STORAGE", "BIND_ACCESSIBILITY_SERVICE"],
      "canOsAuthReplaceKernelGrant": false,
      "canKernelGrantReplaceOsAuth": false
    },
    "iOS": {
      "kernelPermissionOwner": "PermissionDefinitionRegistry + PermissionBroker",
      "osAuthorizationOwner": "iOS (PhotoLibrary/Contacts/Location/Bluetooth/TCC)",
      "runtimeProvider": "iOSRuntimeAdapter",
      "canOsAuthReplaceKernelGrant": false,
      "canKernelGrantReplaceOsAuth": false
    },
    "Desktop": {
      "kernelPermissionOwner": "PermissionDefinitionRegistry + PermissionBroker",
      "osAuthorizationOwner": "Desktop OS (macOS TCC / Windows Security)",
      "runtimeProvider": "DesktopRuntimeAdapter",
      "canOsAuthReplaceKernelGrant": false,
      "canKernelGrantReplaceOsAuth": false
    },
    "Browser": {
      "kernelPermissionOwner": "PermissionDefinitionRegistry + PermissionBroker",
      "osAuthorizationOwner": "Browser Session Auth / User Login",
      "runtimeProvider": "Future Browser Provider",
      "canOsAuthReplaceKernelGrant": false,
      "canKernelGrantReplaceOsAuth": false,
      "note": "Browser session auth is NOT Kernel Permission Grant"
    }
  },
  "invariant": "OS Authorization ≠ Kernel Permission；两者独立且都为必要条件；任何一方不能替代另一方"
}
