{
  "errorSchema": {
    "type": "object",
    "required": [
      "code",
      "message",
      "timestamp"
    ],
    "properties": {
      "number": {
        "type": "integer",
        "description": "Error number"
      },
      "domain": {
        "type": "string",
        "description": "Error domain"
      },
      "code": {
        "type": "string",
        "description": "Error code",
        "pattern": "^ERR_[A-Z]+_[A-Z]+_[0-9]{5}$"
      },
      "details": {
        "type": "object",
        "description": "Additional error details"
      },
      "category": {
        "type": "string",
        "description": "Error category"
      },
      "stack": {
        "type": "string",
        "description": "Stack trace (debug only)"
      },
      "message": {
        "type": "string",
        "description": "Human-readable error message"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "schemaVersion": "1.0.0"
}
