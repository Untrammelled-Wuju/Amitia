      {"name": "WaifuModeSettingsScreen", "route_id": "native.waifu_mode_settings", "file": "ui/features/settings/screens/WaifuModeSettingsScreen.kt"},
      {"name": "CustomEmojiManagementScreen", "route_id": "native.custom_emoji_management", "file": "ui/features/settings/screens/CustomEmojiManagementScreen.kt"},
      {"name": "TagMarketScreen", "route_id": "native.tag_market", "file": "ui/features/settings/screens/TagMarketScreen.kt"},
