{
  "scan_domain": "UI_ENTRIES",
  "manifest_declarations": {
    "activities": [
      {
        "name": ".ui.main.MainActivity",
        "exported": true,
        "launchMode": "singleTask",
        "process": null,
        "intent_filters": [
          {
            "actions": ["android.intent.action.MAIN"],
            "categories": ["android.intent.category.LAUNCHER"]
          },
          {
            "actions": ["android.intent.action.VIEW"],
            "categories": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
            "data": [{"scheme": null, "mimeType": "*/*"}]
          },
          {
            "actions": ["android.intent.action.VIEW"],
            "categories": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
            "data": [{"scheme": "http"}, {"scheme": "https"}]
          },
          {
            "actions": ["android.intent.action.VIEW"],
            "categories": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"],
            "data": [{"scheme": "operit", "host": "github-oauth-callback"}]
          },
          {
            "actions": ["android.intent.action.SEND"],
            "categories": ["android.intent.category.DEFAULT"],
            "data": [{"mimeType": "*/*"}]
          },
          {
            "actions": ["android.intent.action.SEND"],
            "categories": ["android.intent.category.DEFAULT"],
            "data": [{"mimeType": "text/plain"}]
          },
          {
            "actions": ["android.intent.action.SEND_MULTIPLE"],
            "categories": ["android.intent.category.DEFAULT"],
            "data": [{"mimeType": "*/*"}]
          }
        ],
        "meta_data": ["android.app.shortcuts -> @xml/shortcuts"]
      },
      {
        "name": ".services.assistant.OperitAssistActivity",
        "exported": true,
        "process": null,
        "intent_filters": [
          {
            "actions": ["android.intent.action.ASSIST", "android.intent.action.VOICE_ASSIST"],
            "categories": ["android.intent.category.DEFAULT"]
          }
        ]
      },
      {
        "name": ".ui.error.CrashReportActivity",
        "exported": false,
        "process": ":crash"
      },
      {
        "name": ".ui.recovery.DataRecoveryActivity",
        "exported": true,
        "process": ":repair",
        "intent_filters": [
          {
            "actions": ["com.ai.assistance.operit.action.OPEN_DATA_RECOVERY"],
            "categories": ["android.intent.category.DEFAULT"]
          }
        ]
      },
      {
        "name": ".integrations.tasker.ActivityConfigAIAgentAction",
        "exported": true,
        "intent_filters": [
          {
            "actions": ["net.dinglisch.android.tasker.ACTION_EDIT_EVENT"]
          }
        ]
      },
      {
        "name": ".core.tools.system.ScreenCaptureActivity",
        "exported": false
      },
      {
        "name": ".core.tools.defaultTool.websession.browser.WebSessionPermissionRequestActivity",
        "exported": false
      },
      {
        "name": ".core.tools.defaultTool.websession.userscript.install.UserscriptImportPickerActivity",
        "exported": false
      },
      {
        "name": ".integrations.tasker.WorkflowTaskerActivityConfig",
        "exported": true,
        "intent_filters": [
          {
            "actions": ["com.twofortyfouram.locale.intent.action.EDIT_SETTING"]
          }
        ]
      },
      {
        "name": ".widget.ToolPkgDesktopWidgetConfigActivity",
        "exported": true,
        "intent_filters": [
          {
            "actions": ["android.appwidget.action.APPWIDGET_CONFIGURE"]
          }
        ]
      }
    ],
    "services": [
      {
        "name": ".services.FloatingChatService",
        "exported": false,
        "foregroundServiceType": "dataSync"
      },
      {
        "name": ".core.tools.system.ScreenCaptureService",
        "exported": false,
        "foregroundServiceType": "mediaProjection"
      },
      {
        "name": ".services.notification.OperitNotificationListenerService",
        "exported": true,
        "permission": "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
        "intent_filters": [
          {
            "actions": ["android.service.notification.NotificationListenerService"]
          }
        ]
      },
      {
        "name": ".api.chat.AIForegroundService",
        "exported": false,
        "foregroundServiceType": "dataSync|microphone|specialUse"
      },
      {
        "name": ".services.UIDebuggerService",
        "exported": false,
        "foregroundServiceType": "specialUse"
      },
      {
        "name": ".services.assistant.OperitVoiceInteractionService",
        "exported": true,
        "permission": "android.permission.BIND_VOICE_INTERACTION",
        "intent_filters": [
          {
            "actions": ["android.service.voice.VoiceInteractionService"]
          }
        ],
        "meta_data": ["android.voice_interaction -> @xml/interaction_service"]
      },
      {
        "name": ".services.assistant.OperitVoiceInteractionSessionService",
        "exported": true,
        "permission": "android.permission.BIND_VOICE_INTERACTION"
      }
    ],
    "receivers": [
      {
        "name": ".core.tools.javascript.ScriptExecutionReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.EXECUTE_JS"]}
        ]
      },
      {
        "name": ".core.tools.packTool.ToolPkgDebugInstallReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.DEBUG_INSTALL_TOOLPKG"]}
        ]
      },
      {
        "name": ".core.tools.packTool.PackageDebugRefreshReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.DEBUG_REFRESH_PACKAGES"]}
        ]
      },
      {
        "name": ".core.tools.packTool.ToolPkgComposeDslDebugDumpReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.DUMP_COMPOSE_DSL_UI"]}
        ]
      },
      {
        "name": ".integrations.intent.ExternalChatReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.EXTERNAL_CHAT"]}
        ]
      },
      {
        "name": ".core.tools.agent.ShowerBinderReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.action.SHOWER_BINDER_READY"]}
        ]
      },
      {
        "name": ".integrations.tasker.WorkflowTaskerReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["com.ai.assistance.operit.TRIGGER_WORKFLOW"]},
          {"actions": ["com.twofortyfouram.locale.intent.action.FIRE_SETTING"]}
        ]
      },
      {
        "name": ".integrations.tasker.WorkflowBootReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["android.intent.action.BOOT_COMPLETED"]}
        ]
      },
      {
        "name": ".widget.VoiceAssistantWidgetReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["android.appwidget.action.APPWIDGET_UPDATE"]}
        ],
        "meta_data": ["android.appwidget.provider -> @xml/voice_assistant_widget_info"]
      },
      {
        "name": ".widget.ToolPkgDesktopWidgetReceiver",
        "exported": true,
        "intent_filters": [
          {"actions": ["android.appwidget.action.APPWIDGET_UPDATE"]}
        ],
        "meta_data": ["android.appwidget.provider -> @xml/toolpkg_desktop_widget_info"]
      }
    ],
    "providers": [
      {
        "name": "rikka.shizuku.ShizukuProvider",
        "authorities": "${applicationId}.shizuku",
        "exported": true
      },
      {
        "name": "androidx.core.content.FileProvider",
        "authorities": "${applicationId}.fileprovider",
        "exported": false
      },
      {
        "name": ".provider.WorkspaceDocumentsProvider",
        "authorities": "${applicationId}.documents.workspace",
        "exported": true
      },
      {
        "name": ".provider.MemoryDocumentsProvider",
        "authorities": "${applicationId}.documents.memory",
        "exported": true
      },
      {
        "name": ".provider.OperitDataDocumentsProvider",
        "authorities": "${applicationId}.documents.data",
        "exported": true,
        "process": ":repair"
      }
    ]
  },
  "navigation": {
    "framework": "Custom route-based navigation (AppRouterState + ScreenRouteRegistry, NOT Jetpack Navigation Component)",
    "nav_hosts": ["OperitApp (main content host, not a NavHost composable)"],
    "nav_graphs": [],
    "route_pattern": "Route IDs follow pattern native.<snake_case_screen_name> or toolpkg.dynamic",
    "route_registry_class": "ScreenRouteRegistry",
    "route_catalog_class": "AppRouteCatalog",
    "routes": [
      "native.ai_chat",
      "native.assistant_config",
      "native.memory_base",
      "native.packages",
      "native.market",
      "native.market_category",
      "native.market_notifications",
      "native.market_entry_detail",
      "native.market_author",
      "native.market_manage",
      "native.artifact_publish",
      "native.artifact_continue_publish",
      "native.artifact_edit",
      "native.repo_publish",
      "native.repo_edit",
      "native.repo_publish_version",
      "native.toolbox",
      "native.shizuku_commands",
      "native.settings",
      "native.git_hub_account",
      "native.help",
      "native.about",
      "native.agreement",
      "native.update_history",
      "native.workflow",
      "native.workflow_detail",
      "native.token_config",
      "native.tool_permission",
      "native.user_preferences_guide",
      "native.user_preferences_settings",
      "native.model_config",
      "native.speech_services_settings",
      "native.external_http_chat_settings",
      "native.mnn_model_download",
      "native.persona_card_generation",
      "native.waifu_mode_settings",
      "native.custom_emoji_management",
      "native.tag_market",
      "native.model_prompts_settings",
      "native.functional_config",
      "native.theme_settings",
      "native.global_display_settings",
      "native.layout_adjustment_settings",
      "native.chat_history_settings",
      "native.chat_backup_settings",
      "native.language_settings",
      "native.token_usage_statistics",
      "native.context_summary_settings",
      "native.tool_pkg_compose_dsl",
      "native.tool_pkg_plugin_config",
      "native.file_manager",
      "native.terminal",
      "native.terminal_setup",
      "native.terminal_auto_config",
      "native.app_permissions",
      "native.ui_debugger",
      "native.shell_executor",
      "native.logcat",
      "native.sql_viewer",
      "native.ffmpeg_toolbox",
      "native.markdown_demo",
      "native.tool_tester",
      "native.text_to_speech",
      "native.speech_to_text",
      "native.default_assistant_guide",
      "native.process_limit_remover",
      "native.html_packager",
      "native.auto_glm_one_click",
      "native.auto_glm_tool"
    ]
  },
  "screens_and_pages": {
    "main_screens": [
      {"name": "AiChat", "route_id": "native.ai_chat", "source": "AIChatScreen", "file": "ui/features/chat/screens/AIChatScreen.kt"},
      {"name": "AssistantConfig", "route_id": "native.assistant_config", "source": "AssistantConfigScreen", "file": "ui/features/assistant/screens/AssistantConfigScreen.kt"},
      {"name": "MemoryBase", "route_id": "native.memory_base", "source": "MemoryScreen", "file": "ui/features/memory/screens/MemoryScreen.kt"},
      {"name": "Packages", "route_id": "native.packages", "source": "PackageManagerScreen", "file": "ui/features/packages/screens/PackageManagerScreen.kt"},
      {"name": "Market", "route_id": "native.market", "source": "UnifiedMarketScreen", "file": "ui/features/packages/screens/UnifiedMarketScreen.kt"},
