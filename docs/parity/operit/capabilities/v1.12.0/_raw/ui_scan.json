      {"name": "GitHubAccountScreen", "route_id": "native.git_hub_account", "file": "ui/features/settings/screens/GitHubAccountScreen.kt"},
      {"name": "ToolPermissionSettingsScreen", "route_id": "native.tool_permission", "file": "ui/features/settings/screens/ToolPermissionSettingsScreen.kt"},
      {"name": "UserPreferencesGuideScreen", "route_id": "native.user_preferences_guide", "file": "ui/features/settings/screens/UserPreferencesGuideScreen.kt"},
