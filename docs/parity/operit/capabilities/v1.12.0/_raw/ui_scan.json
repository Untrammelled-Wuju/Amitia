    "dialog_sheets": [
      {"name": "OrientationChangeDialog", "type": "AlertDialog", "file": "MainActivity.kt"},
      {"name": "RemoteAnnouncementDialog", "type": "AlertDialog", "file": "ui/features/announcement/RemoteAnnouncementDialog.kt"},
      {"name": "ErrorDialog", "type": "AlertDialog", "file": "ui/components/ErrorDialog.kt"},
      {"name": "ColorPickerDialog", "type": "AlertDialog", "file": "ui/features/settings/components/ColorPickerDialog.kt"},
      {"name": "FileContextMenu", "type": "DropdownMenu/BottomSheet", "file": "ui/features/toolbox/screens/filemanager/components/FileContextMenu.kt"},
      {"name": "LinkPreviewDialog", "type": "AlertDialog", "file": "ui/features/chat/components/LinkPreviewDialog.kt"},
      {"name": "MessageInfoDialog", "type": "AlertDialog", "file": "ui/features/chat/components/MessageInfoDialog.kt"},
      {"name": "MemoryFolderSelectionDialog", "type": "AlertDialog", "file": "ui/features/chat/components/MemoryFolderSelectionDialog.kt"},
      {"name": "WorkspaceChangeConfirmDialog", "type": "AlertDialog", "file": "ui/features/chat/components/WorkspaceChangeConfirmDialog.kt"},
      {"name": "ScheduleConfigDialog", "type": "AlertDialog", "file": "ui/features/workflow/components/ScheduleConfigDialog.kt"},
      {"name": "NodeActionMenu", "type": "DropdownMenu", "file": "ui/features/workflow/components/NodeActionMenu.kt"},
      {"name": "ConnectionMenu", "type": "DropdownMenu", "file": "ui/features/workflow/components/ConnectionMenu.kt"},
      {"name": "TokenInfoDialog", "type": "AlertDialog", "file": "ui/features/chat/components/config/TokenInfoDialog.kt"},
      {"name": "AttachmentViewerDialog", "type": "AlertDialog", "file": "ui/features/chat/components/attachments/AttachmentViewerDialog.kt"},
      {"name": "GitHubLoginWebViewDialog", "type": "Dialog", "file": "ui/features/github/GitHubLoginWebViewDialog.kt"},
      {"name": "ChatHistorySelector", "type": "AlertDialog", "file": "ui/features/chat/components/ChatHistorySelector.kt"},
      {"name": "DragDropBottomSheet", "type": "ModalBottomSheet", "file": "ui/theme/WaterGlass.kt"},
      {"name": "FileTransferBottomSheet", "type": "ModalBottomSheet", "file": "ui/theme/WaterGlass.kt"},
      {"name": "MarketDetailBottomSheet", "type": "ModalBottomSheet", "file": "ui/features/toolbox/screens/filemanager/FileManagerScreen.kt"}
    ],
    "overlay_entries": [
      {
        "name": "FloatingChatService",
        "type": "Floating Window (Service)",
        "description": "System overlay floating chat window using WindowManager",
        "file": "services/FloatingChatService.kt"
      },
      {
        "name": "UIDebuggerService",
        "type": "Floating Window (Service)",
        "description": "UI debugger floating window overlay using WindowManager",
        "file": "services/UIDebuggerService.kt"
      },
      {
        "name": "UIDebuggerWindowManager",
        "type": "Floating Window Manager",
        "description": "Manages the UI debugger overlay window",
        "file": "services/floating/UIDebuggerWindowManager.kt"
      },
      {
        "name": "FloatingWindowManager",
        "type": "Floating Window Manager",
        "description": "Manages the floating chat window overlays",
        "file": "services/floating/FloatingWindowManager.kt"
      },
      {
        "name": "VirtualDisplayOverlay",
        "type": "Virtual Display Overlay",
        "description": "Overlay using VirtualDisplay for rendering outside app context",
        "file": "ui/common/displays/VirtualDisplayOverlay.kt"
      },
      {
        "name": "UIOperationOverlay",
        "type": "UI Operation Overlay",
        "description": "Overlay for UI automation operations",
        "file": "ui/common/displays/UIOperationOverlay.kt"
      },
      {
        "name": "PermissionRequestOverlay",
        "type": "Permission Overlay",
        "description": "Overlay for permission requests",
        "file": "ui/permissions/PermissionRequestOverlay.kt"
      },
      {
        "name": "PluginLoadingScreenWithState",
        "type": "Loading Overlay",
        "description": "Overlay for plugin loading with z-index 10",
        "file": "ui/features/startup/screens/PluginLoadingScreen.kt"
      }
    ]
  },
  "entry_points": [
    {
      "entry_id": "main_launcher",
      "display_name": "MainActivity (Launcher)",
      "route": "native.ai_chat",
      "source_file": "ui/main/MainActivity.kt",
      "destination": "AiChat Screen",
      "feature_flag": null,
      "reachable": true
    },
    {
      "entry_id": "assistant_shortcut",
      "display_name": "System ASSIST",
      "route": "native.ai_chat",
      "source_file": "services/assistant/OperitAssistActivity.kt",
      "destination": "FloatingChat (via FloatingChatService)",
      "feature_flag": null,
      "reachable": true
    },
    {
      "entry_id": "voice_floating_window_shortcut",
