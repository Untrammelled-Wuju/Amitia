  "crash_recovery": {
    "found": true,
    "details": "全局异常捕获 + 独立崩溃报告 Activity + 数据救援模式",
    "items": [
      {
        "name": "GlobalExceptionHandler",
        "path": "util/GlobalExceptionHandler.kt",
        "description": "Thread.UncaughtExceptionHandler 实现。捕获未处理异常后: 标记 CrashRecoveryState 保存日志 → 格式化堆栈 → 启动 CrashReportActivity → exitProcess(1) 终止进程"
      },
      {
        "name": "CrashReportActivity",
        "path": "ui/error/CrashReportActivity.kt",
        "description": "崩溃报告展示页。功能: 重启应用 (通过 AlarmManager 200ms 后 PendingIntent 拉起 MainActivity)、复制堆栈到剪贴板、导出到 Downloads/Operit/error/error-report-*.log、导出 logcat 日志 (LogcatExportHelper)。堆栈截断上限 24000 字符"
      },
      {
        "name": "CrashRecoveryState",
        "path": "util/CrashRecoveryState.kt",
        "description": "崩溃恢复状态标记: SharedPreferences 持久化 pending crash report launch 状态，确保崩溃后重启时保留日志"
      },
      {
        "name": "DataRecoveryActivity + ViewModel",
        "path": "ui/recovery/DataRecoveryActivity.kt / DataRecoveryViewModel.kt",
        "description": "独立数据救援进程: 提供原始快照导入/导出 (调用 RawSnapshotBackupManager)、SQL 执行器 (直接 SQLite 操作)。从 launcher 独立启动，恢复后可重启主应用"
      },
      {
        "name": "Registration in OperitApplication",
        "path": "core/application/OperitApplication.kt",
        "description": "在 Application.onCreate 中调用 Thread.setDefaultUncaughtExceptionHandler(GlobalExceptionHandler(this)) 注册全局异常处理器"
      },
      {
        "name": "AnrMonitor",
        "path": "util/AnrMonitor.kt",
        "description": "ANR 监测工具，检测应用无响应情况"
      }
    ]
  },
