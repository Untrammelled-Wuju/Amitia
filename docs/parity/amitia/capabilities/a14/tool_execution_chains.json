{
  "id": "tool_execution_chains",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "tool_execution",
  "description": "工具执行流(LLM tool_call → 工具分发 → execute → 结果回填 → 后处理)",
  "flow": [
    { "step": 1, "name": "tool_call_detect", "description": "LLM输出中解析tool_call(JSON格式)", "file": "backend/internal/chat/tool_runtime.go" },
    { "step": 2, "name": "tool_lookup", "description": "根据tool name在全局funcMap/registry中查找实现", "file": "backend/internal/agent/tool/registry.go" },
    { "step": 3, "name": "tool_execute", "description": "执行工具函数(传入argsJSON，返回ToolCallResult)", "file": "backend/internal/agent/tool/registry.go ExecuteWithContext()" },
    { "step": 4, "name": "result_collect", "description": "收集ToolResult(状态/输出/错误/耗时)", "file": "backend/internal/chat/tool_runtime.go ToolResult struct" },
    { "step": 5, "name": "result_inject", "description": "将tool_result回填为assistant/tool角色消息，触发二次LLM生成", "file": "backend/internal/chat/message_llm.go" },
    { "step": 6, "name": "visible_text", "description": "从ToolResult.VisibleText生成用户可见文本片段", "file": "backend/internal/chat/tool_runtime.go" },
    { "step": 7, "name": "force_voice", "description": "若ForceVoice标记，触发语音回复合成", "file": "backend/internal/agent/tool/voice_reply.go" }
  ],
  "registered_tools": [
    { "name": "memory_summary", "file": "backend/internal/agent/tool/memory_summary.go", "desc": "记忆摘要" },
    { "name": "read_need_state", "file": "backend/internal/agent/tool/read_need_state.go", "desc": "读取需求状态" },
    { "name": "read_psyche_state", "file": "backend/internal/agent/tool/read_psyche_state.go", "desc": "读取心理状态" },
    { "name": "schedule", "file": "backend/internal/agent/tool/schedule.go", "desc": "日程查询" },
    { "name": "system_time", "file": "backend/internal/agent/tool/system_time.go", "desc": "系统时间" },
    { "name": "voice_reply", "file": "backend/internal/agent/tool/voice_reply.go", "desc": "语音回复" },
    { "name": "model", "file": "backend/internal/agent/tool/model.go", "desc": "模型操作" },
    { "name": "memory", "file": "backend/internal/agent/tool/memory.go", "desc": "记忆操作" }
  ]
}
