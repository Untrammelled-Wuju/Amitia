{
  "id": "vector_graph_inventory",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "vector_graph",
  "description": "向量+图谱存储能力清单(Qdrant向量库/SurrealDB图谱库)",
  "vector_store": {
    "engine": "Qdrant",
    "host": "http://127.0.0.1:6333",
    "sdk": "github.com/qdrant/go-client",
    "collections": [
      { "name": "messages", "description": "对话消息嵌入向量" },
      { "name": "memories", "description": "记忆嵌入向量" },
      { "name": "worldbook_entries", "description": "世界书条目嵌入向量" },
      { "name": "character_attributes", "description": "角色属性嵌入向量" }
    ],
    "operations": ["upsert", "search", "delete", "filter"],
    "used_by": [
      "backend/internal/vectorstore/",
      "backend/internal/memory/embedding_vector_service.go",
      "backend/internal/qdrant/"
    ],
    "embedding_model": "BGE系列(本地Ollama或独立嵌入服务)"
  },
  "graph_store": {
    "engine": "SurrealDB",
    "host": "http://127.0.0.1:8000",
    "sdk": "github.com/surrealdb/surrealdb.go",
    "used_for": [
      "人物关系图(relationship graph)",
      "实体关系(entity relaciones)",
      "知识图谱查询"
    ],
    "operations": ["关系创建/删除", "图遍历", "节点查询"],
    "used_by": [
      "backend/internal/graph/service.go",
      "backend/internal/graph/client.go",
      "backend/internal/memory/graph_service.go"
    ],
    "graph_service_files": [
      "backend/internal/graph/service.go",
      "backend/internal/graph/handler.go",
      "backend/internal/graph/router.go",
      "backend/internal/graph/client.go"
    ]
  },
  "vector_graph_integration": {
    "description": "向量检索与图谱遍历的协同",
    "use_case": "记忆检索时先通过Qdrant向量相似度召回候选 → 再通过SurrealDB图谱关系验证上下文",
    "files": ["backend/internal/memory/search_service.go", "backend/internal/memory/retrieval.go"]
  }
}
