{
  "id": "excluded_files",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "excluded_files",
  "description": "审计排除文件清单(构建产物/第三方库/自动生成)",
  "categories": [
    {
      "category": "构建产物",
      "patterns": [
        "desktop/release/**",
        "desktop/build/**",
        "desktop/dist-types/**",
        "backend/bin/**"
      ]
    },
    {
      "category": "第三方库",
      "patterns": [
        "**/node_modules/**",
        "**/vendor/**",
        "third_party/**"
      ]
    },
    {
      "category": "自动生成",
      "patterns": [
        "**/*.pb.go",
        "**/*.gen.go",
        "**/mocks/**",
        "**/testdata/**"
      ]
    },
    {
      "category": "二进制资源",
      "patterns": [
        "desktop/resources/core/*.exe",
        "desktop/resources/**/*.zip",
        "**/*.wasm"
      ]
    },
    {
      "category": "数据库文件",
      "patterns": [
        "**/*.db",
        "**/*.db-journal",
        "**/*.db-wal",
        "**/*.db-shm"
      ]
    },
    {
      "category": "日志与缓存",
      "patterns": [
        "**/*.log",
        "**/logs/**",
        "**/tmp/**"
      ]
    }
  ]
}
