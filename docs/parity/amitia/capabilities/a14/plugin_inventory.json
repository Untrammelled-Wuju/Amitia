{
  "id": "plugin_inventory",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "plugin",
  "description": "插件系统清单(内置插件/第三方插件/插件能力适配器)",
  "plugin_lifecycle": {
    "states": ["installed", "enabled", "disabled", "error", "circuit_open"],
    "files": [
      "backend/internal/extension/plugin_manager.go",
      "backend/internal/extension/plugin_handler.go",
      "backend/internal/extension/plugin_state.go (capability/state)"
    ]
  },
  "plugin_capabilities": {
    "description": "插件可暴露的能力",
    "types": ["tool", "workflow", "task", "ui_surface", "event", "schedule", "context_contribution"],
    "files": ["backend/internal/extension/capability/adapter_plugin.go"]
  },
  "plugin_system_apis": [
    { "name": "plugin_handler", "endpoint": "POST /api/extensions/plugins/:id/enable|disable|reload" },
    { "name": "plugin_config", "endpoint": "GET/PUT/POST /api/extensions/plugins/:id/config" },
    { "name": "plugin_permissions", "endpoint": "GET/PUT /api/extensions/plugins/:id/permissions" },
    { "name": "plugin_health", "endpoint": "GET /api/extensions/plugins/:id/health" },
    { "name": "plugin_surface", "endpoint": "GET /api/extensions/plugins/:id/surface" },
    { "name": "plugin_schedules", "endpoint": "GET /api/extensions/plugins/:id/schedules" },
    { "name": "plugin_events", "endpoint": "GET /api/extensions/plugins/:id/events" },
    { "name": "plugin_circuit", "endpoint": "POST /api/extensions/plugins/:id/circuit/reset" }
  ],
  "builtin_plugins": [
    { "name": "plugin_builtin_diagnostic", "file": "backend/internal/extension/plugin_builtin_diagnostic.go", "desc": "内置诊断插件" }
  ],
  "migration_plugins": [
    "agent_skill", "legacy_skill", "mcp_skill", "workflow_skill"
  ]
}
