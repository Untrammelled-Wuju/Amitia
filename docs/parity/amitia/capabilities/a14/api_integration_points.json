{
  "integrations": [
    {
      "name": "Qdrant",
      "type": "vector_db",
      "path": "backend/pkg/database/qdrandb/client.go",
      "protocol": "gRPC/HTTP",
      "description": "向量数据库，用于记忆和画像的向量检索",
      "managed_internally": true,
      "collections": ["memory_embeddings", "profile_embeddings", "episodic_embeddings", "worldbook_embeddings"]
    },
    {
      "name": "SurrealDB",
      "type": "graph_db",
      "path": "backend/internal/graph/client.go",
      "protocol": "WebSocket",
      "description": "图谱数据库，用于角色关系和知识图谱存储",
      "managed_internally": true,
      "entities": ["memory_nodes", "memory_edges", "character_nodes", "relationship_edges"]
    },
    {
      "name": "OpenAI API",
      "type": "llm_provider",
      "path": "backend/internal/chat/llm_client.go",
      "protocol": "HTTPS",
      "endpoint": "/chat/completions",
      "description": "OpenAI兼容LLM接口，支持tool_call和reasoning",
      "managed_internally": false
    },
    {
      "name": "Ollama",
      "type": "llm_provider",
      "path": "backend/internal/chat/llm_client.go",
      "protocol": "HTTPS",
      "endpoint": "/api/chat",
      "description": "本地Ollama模型接口，支持tool_call",
      "managed_internally": false
    },
    {
      "name": "Anthropic Claude",
      "type": "llm_provider",
      "path": "backend/internal/chat/llm_client.go",
      "protocol": "HTTPS",
      "endpoint": "/v1/messages",
      "description": "Anthropic Claude API，支持tool_use",
      "managed_internally": false
    },
    {
      "name": "Google Gemini",
      "type": "llm_provider",
      "path": "backend/internal/chat/llm_client.go",
      "protocol": "HTTPS",
      "endpoint": ":generateContent",
      "description": "Google Gemini API，支持functionCall和reasoning",
      "managed_internally": false
    },
    {
      "name": "WeChat Sidecar",
      "type": "channel_sidecar",
      "path": "backend/internal/delivery/channel_adapters.go",
      "protocol": "HTTP",
      "endpoint": "/api/send",
      "description": "微信侧车：微信消息收发",
      "managed_internally": true,
      "package": "@ai-companion/wechat-sidecar"
    },
    {
      "name": "QQ Sidecar",
      "type": "channel_sidecar",
      "path": "backend/internal/delivery/channel_adapters.go",
      "protocol": "HTTP",
      "endpoint": "/api/send",
      "description": "QQ侧车：QQ消息收发",
      "managed_internally": true,
      "package": "@ai-companion/qq-sidecar"
    },
    {
      "name": "MCP Servers (stdio)",
      "type": "external_tools",
      "path": "backend/internal/mcp/transport/stdio.go",
      "protocol": "JSON-RPC 2.0 (stdio)",
      "description": "MCP Server标准传输：stdin/stdout通信",
      "managed_internally": false
    },
    {
      "name": "MCP Servers (HTTP)",
      "type": "external_tools",
      "path": "backend/internal/mcp/transport/streamable_http.go",
      "protocol": "JSON-RPC 2.0 (HTTP+SSE)",
      "description": "MCP Server HTTP传输：SSE流+Session管理",
      "managed_internally": false
    },
    {
      "name": "MCP OAuth",
      "type": "auth",
      "path": "backend/internal/mcp/auth/oauth.go",
      "protocol": "HTTPS",
      "description": "MCP Server OAuth认证流程",
      "managed_internally": false
    },
    {
      "name": "Plugin Host (Node.js)",
      "type": "runtime_plugin",
      "path": "runtime/plugin-host/",
      "protocol": "JSON-RPC 2.0 (stdio)",
      "description": "Node.js插件宿主：独立子进程stdIO通信",
      "managed_internally": true,
      "security": "内置模块黑名单+路径逃逸防护+原生模块阻止"
    },
    {
      "name": "Task Host (Node.js)",
      "type": "runtime_task",
      "path": "runtime/task-host/",
      "protocol": "JSON-RPC 2.0 (stdio)",
      "description": "长时间任务宿主：检查点/取消/流式进度",
      "managed_internally": true
    },
    {
      "name": "Electron IPC",
      "type": "desktop_bridge",
      "path": "desktop/src/preload/",
      "protocol": "IPC (contextBridge)",
      "description": "Electron主进程与渲染进程桥接",
      "managed_internally": true
    },
    {
      "name": "Flutter Platform Channel",
      "type": "mobile_bridge",
      "path": "mobile_app/android/",
      "protocol": "MethodChannel/EventChannel",
      "description": "Flutter与原生平台(Android/iOS)桥接",
      "managed_internally": true
    },
    {
      "name": "Logrus",
      "type": "logging",
      "path": "backend/internal/",
      "protocol": "Library",
      "description": "结构化日志框架",
      "managed_internally": false
    },
    {
      "name": "Zap",
      "type": "logging",
      "path": "backend/internal/",
      "protocol": "Library",
      "description": "高性能日志框架",
      "managed_internally": false
    },
    {
      "name": "Embedding Service",
      "type": "embedding_provider",
      "path": "backend/internal/embedding/",
      "protocol": "HTTPS",
      "description": "文本Embedding向量生成服务(依赖LLM Provider配置)",
      "managed_internally": false
    }
  ]
}
