{
  "id": "websocket_sse_inventory",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "websocket_sse",
  "description": "SSE/WebSocket协议清单(各通道端点与数据格式)",
  "sse_channels": [
    {
      "name": "ChatSSE",
      "endpoint": "POST /api/Accept: text/event-stream",
      "file": "backend/internal/chat/handler.go",
      "events": [
        { "event": "token", "data": "LLM增量token文本" },
        { "event": "message_done", "data": "完整消息ID与元数据" },
        { "event": "tool_start", "data": "工具调用开始" },
        { "event": "tool_end", "data": "工具调用结束+结果摘要" },
        { "event": "error", "data": "错误信息" }
      ],
      "client": "front/src/composables/useChatSSE.ts"
    },
    {
      "name": "Proactive_reminders_stream",
      "endpoint": "GET /api/proactive/reminders/stream",
      "events": ["reminder_fired", "reminder_cancelled", "status_update"]
    },
    {
      "name": "reactive_ui_host",
      "endpoint": "/api/reactive",
      "file": "backend/internal/extension/kernel/sse_ui_host.go",
      "purpose": "向扩展Web UI推送运行时事件",
      "client": "front/src/composables/useUIHostSSE.ts"
    },
    {
      "name": "extension_updates",
      "endpoint": "/api/extensions/updates/stream",
      "purpose": "扩展安装/更新进度推送"
    }
  ],
  "websocket_channels": [
    {
      "name": "RealtimeVoice",
      "endpoint": "/api/realtime",
      "file": "backend/internal/realtime/",
      "protocol": "二进制帧协议(FullDuplex)",
      "features": ["全双工语音传输", "事件帧控制", "会话管理", "配置动态更新"],
      "client": "front/src/components/RealtimeCallWidget.vue"
    }
  ],
  "sse_protocol_format": {
    "format": "text/event-stream",
    "retry": "retry: 3000",
    "keep_alive": "comment ping every 25s"
  }
}
