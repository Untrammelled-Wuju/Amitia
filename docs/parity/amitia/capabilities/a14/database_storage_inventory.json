{
  "id": "database_storage_inventory",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "database_storage",
  "description": "数据库存储引擎清单：SQLite主库/Qdrant向量库/SurrealDB图谱库",
  "engines": [
    {
      "name": "SQLite",
      "role": "主业务数据库",
      "driver": "mattn/go-sqlite3 (cgo)",
      "tables_count": 80,
      "migrations": "backend/internal/migration/migrations.go",
      "baseline_sql": "backend/internal/migration/baseline.sql",
      "key_tables": ["characters", "conversations", "messages", "model_configs", "proactive_rules", "proactive_reminders", "plugins", "skills", "memory_candidates", "delivery_intents"]
    },
    {
      "name": "Qdrant",
      "role": "向量数据库(BGE嵌入向量检索)",
      "host": "http://127.0.0.1:6333",
      "collections": ["messages", "memories", "worldbook_entries", "character_attributes"],
      "sdk": "github.com/qdrant/go-client",
      "used_by": "backend/internal/qdrant/, backend/internal/memory/, backend/internal/vectorstore/"
    },
    {
      "name": "SurrealDB",
      "role": "图谱数据库(关系图谱/知识图谱)",
      "host": "http://127.0.0.1:8000",
      "used_for": ["人物关系图", "实体关系", "知识图谱查询"],
      "sdk": "github.com/surrealdb/surrealdb.go",
      "used_by": "backend/internal/graph/"
    }
  ]
}
