{
  "id": "web_frontend_inventory",
  "baseline": "AMT-A14-3daeaf3",
  "audit_time": "2026-08-07",
  "domain": "web_frontend",
  "description": "Web前端(Vue3)能力清单",
  "framework": "Vue3 + Element Plus + Vite + Pinia + Vue Router",
  "key_views": [
    { "name": "ChatView", "path": "/", "description": "主对话界面" },
    { "name": "CharacterConfigView", "path": "/character-config", "description": "角色配置(CRUD/测试对话/导入导出)" },
    { "name": "MemoryManagerView", "path": "/memory-manager", "description": "记忆管理(CRUD/候选/冲突/分析)" },
    { "name": "ExtensionCenterView", "path": "/extensions", "description": "扩展中心(插件/技能/MCP/Agent技能/包)" },
    { "name": "KernelCenterView", "path": "/kernel", "description": "内核中心(事件/任务/迁移/调度/更新/开发控制台)" },
    { "name": "OnboardingView", "path": "/onboarding", "description": "引导流程(8步设置向导)" },
    { "name": "SettingsView", "path": "/settings", "description": "系统设置(20+子面板)" },
    { "name": "DashboardView", "path": "/dashboard", "description": "仪表盘(状态/健康/用量/错误)" },
    { "name": "RealtimeVoiceView", "path": "/realtime", "description": "实时语音对话" },
    { "name": "LogsView", "path": "/logs", "description": "日志查看器" },
    { "name": "AsrView", "path": "/asr", "description": "语音识别测试" }
  ],
  "core_components": [
    { "name": "ChatBubble", "component": "front/src/components/ChatBubble.vue" },
    { "name": "ChatInput", "component": "front/src/components/ChatInput.vue" },
    { "name": "MessagesArea", "component": "front/src/components/MessagesArea.vue" },
    { "name": "SideNav", "component": "front/src/components/SideNav.vue" },
    { "name": "StatusBar", "component": "front/src/components/StatusBar.vue" },
    { "name": "RealtimeCallWidget", "component": "front/src/components/RealtimeCallWidget.vue" },
    { "name": "MemoryPanel", "component": "front/src/components/MemoryPanel.vue" }
  ],
  "composables": [
    "useChat/useChatSSE/useMessageSend/useChatScroll/useConversation",
    "useMemoryHub/useEpisodic/useWorldBook/useGraph",
    "useExtensionSlot/useExtensionPerformance",
    "useGenerationTask/useProcessingTask/useDesktopPetInstallations"
  ],
  "stores": ["app.ts", "chat.ts", "extensionUI.ts"],
  "apis": ["api/desktop/", "api/extension/", "api/temporal/"]
}
