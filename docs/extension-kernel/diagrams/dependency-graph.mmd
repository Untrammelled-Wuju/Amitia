%% 地图 K：交叉依赖图
%% 依据：dependency-matrix.md（RD-1~RD-7、CD-1~CD-2、AL-1~AL-7、BP-1~BP-10）
%% 节点：真实子系统 + 文件路径
%% 箭头：A→B 表示 A 依赖 B；红色为反向依赖；紫色为循环依赖；橙色为装配层注入
flowchart LR
    subgraph Assembly[装配层 services.go]
        Svc[NewAppServices<br/>services.go:288-314]:::asm
        ConfWF[configureWorkflowHost<br/>services.go:389-470]:::asm
    end

    subgraph ExtLayer[Extension Runtime]
        Ext[extension.Runtime<br/>runtime.go]:::ext
        Reg[(Registry<br/>registry.go)]:::reg
        Exe[Executor<br/>executor.go]:::ext
        Perm[PermissionEvaluator<br/>permission.go]:::ext
    end

    subgraph Chat[聊天层]
        ChatSvc[chat.Service<br/>chat/service.go]:::chat
        MsgLLM[message_llm.go<br/>硬编码 create_schedule 参数]:::chat
    end

    subgraph AgentSkill[Agent Skill 子系统]
        ASSvc[AgentSkillService<br/>agent_skill_service.go]:::as
        ASRt[AgentSkillRuntime<br/>agent_skill_runtime.go]:::as
        ASRepo[AgentSkillRepository<br/>agent_skill_repository.go]:::as
    end

    subgraph MCPSub[MCP 子系统]
        MCPMgr[mcpmanager.Manager<br/>mcp/manager/manager.go]:::mcp
        MCPSkill[mcp/skill.Runtime<br/>mcp/skill/runtime.go]:::mcp
        MCPDep[mcpdependency.Service<br/>mcp/dependency/service.go]:::mcp
        MCPDisc[mcpdiscovery.Service<br/>mcp/discovery/service.go]:::mcp
    end

    subgraph PluginSub[Plugin 子系统]
        PLGMgr[PluginManager<br/>plugin_manager.go]:::plg
        PLGHost[pluginHost<br/>plugin_host.go]:::plg
    end

    subgraph WFSub[Workflow 子系统]
        WFCmp[WorkflowCompiler<br/>workflow_compiler.go]:::wf
        WFExe[WorkflowExecutor<br/>workflow_executor.go]:::wf
        WFHost[WorkflowHostAdapter<br/>services.go:389]:::wf
    end

    subgraph PkgSub[Package 子系统]
        PKGSvc[PackageService<br/>package_service.go]:::pkg
        PKGInst[PackageInstaller<br/>package_installer.go]:::pkg
    end

    subgraph WSSub[Workshop 子系统]
        WSSvc[WorkshopService<br/>workshop_service.go]:::ws
        WSInst[WorkshopInstaller<br/>workshop_installer.go]:::ws
    end

    %% 正向依赖
    Svc --> Ext
    Svc --> ChatSvc
    Svc --> MCPMgr
    Svc --> MCPSkill
    Svc --> MCPDep
    Ext --> Reg
    Ext --> Exe
    Exe --> Perm
    Exe --> Reg
    PLGMgr --> Reg
    PLGHost --> Exe
    PLGHost --> Reg
    PKGInst --> Reg
    PKGInst --> ASSvc
    PKGInst --> WFCmp
    WSSvc --> PKGSvc
    WSSvc --> WFCmp
    WSInst --> ASSvc

    %% 反向依赖 RD-1~RD-7（红色）
    ChatSvc -.->|RD-1 反向| Ext
    WSSvc -.->|RD-2 反向| ChatSvc
    MCPSkill -.->|RD-3 反向| Ext
    MCPDep -.->|RD-4 反向| MCPSkill
    ASSvc -.->|RD-5 反向| MCPDep
    MCPMgr -.->|RD-6 反向| ChatSvc
    MsgLLM -.->|RD-7 反向| Exe

    %% 装配层注入 AL-1~AL-7（橙色虚线）
    Svc -.->|AL-1 注入| WFHost
    Svc -.->|AL-2 注入| ChatSvc
    Svc -.->|AL-3 注入| MCPDep
    Svc -.->|AL-4 注入| ASSvc
    ConfWF -.->|AL-5 闭包| ChatSvc
    ConfWF -.->|AL-6 闭包| Reg
    ConfWF -.->|AL-7 闭包| Exe

    %% 循环依赖 CD-1、CD-2（紫色粗线）
    WFHost ==>|CD-1 Schedule<br/>循环依赖 P0-3| Reg
    Reg ==>|Get create-schedule| Exe
    Exe ==>|执行| WFExe
    WFExe ==>|调用 Host| WFHost

    ASSvc ==>|CD-2 删除清理不完整 P0-5| MCPDep
    MCPDep ==>|Uninstall| MCPMgr
    MCPMgr -.->|应清理| Reg

    %% 不可删除桥接点 BP-1~BP-10（蓝色标注）
    BP1>BP-1 Runtime.ModelTools]:::bp
    BP2>BP-2 Runtime.ExecuteModelTool]:::bp
    BP3>BP-3 Runtime.BeforePrompt]:::bp
    BP4>BP-4 Runtime.AfterReply]:::bp
    BP5>BP-5 MCPSkill.RegisterServer]:::bp
    BP6>BP-6 ASSvc.SetAfterRemove]:::bp
    BP7>BP-7 configureWorkflowHost]:::bp
    BP8>BP-8 ChatSvc.SetSkillRuntime]:::bp
    BP9>BP-9 PluginManager.skills]:::bp
    BP10>BP-10 PKGInst→Registry.Register]:::bp

    Ext -.-> BP1
    Ext -.-> BP2
    Ext -.-> BP3
    Ext -.-> BP4
    MCPSkill -.-> BP5
    ASSvc -.-> BP6
    ConfWF -.-> BP7
    ChatSvc -.-> BP8
    PLGMgr -.-> BP9
    PKGInst -.-> BP10

