%% 地图 C+D：模型工具暴露与执行图
%% 依据：02-tool-exposure-execution.md 链路 TE-1、TE-2
%% 工具暴露链 + 工具执行链合并展示
flowchart TB
    subgraph Expose[地图 C：工具暴露链]
        direction TB
        ChatReq[chat 请求<br/>chat/service.go]:::chat
        Scope[ExecutionScope<br/>identity+character+channel]:::scope
        RT[Runtime.ModelTools<br/>extension/runtime.go:137]:::ext
        Avail[Registry.Available<br/>过滤 Enabled+Compatible+Kind≠instructions<br/>extension/registry.go:144]:::reg
        Internal{internal 工具<br/>agentSkillToolsAvailable?}:::perm
        GetScoped[GetScoped<br/>作用域过滤]:::reg
        Preview[Permissions.PreviewExecution<br/>预过滤 Deny]:::perm
        ToolList[tool.Tool 列表]:::out
        Model[模型请求]:::out

        ChatReq --> Scope --> RT --> Avail --> Internal
        Internal -->|true| GetScoped
        Internal -->|false P1-TE-2| Hide[隐藏 internal 工具]:::risk
        GetScoped --> Preview --> ToolList --> Model
    end

    subgraph Sources[4 类工具来源汇入 Registry]
        direction LR
        Legacy[LegacyToolAdapter<br/>旧 agent/tool/]:::src
        WF[WorkflowCompiler<br/>extension/workflow_compiler.go]:::src
        PLG[Plugin.RegisterSkill<br/>plugin_host.go:30]:::src
        MCP[mcp/skill.Runtime.RegisterServer<br/>mcp/skill/runtime.go:92]:::src
        Reg[(Registry<br/>extension/registry.go)]:::reg
        Legacy --> Reg
        WF --> Reg
        PLG --> Reg
        MCP --> Reg
    end

    subgraph Exec[地图 D：工具执行链]
        direction TB
        Call[模型 tool_call name args]:::out
        MLLM[message_llm.go:71<br/>ExecuteModelTool]:::chat
        Special{create_schedule?<br/>P1-TE-1}:::risk
        GetByName[Registry.GetByModelName<br/>registry.go:144]:::reg
        Ex[Executor.Execute<br/>executor.go:40]:::ext
        Checks[GetScoped+Enabled+Compatible+Trigger<br/>输入Schema校验]:::ext
        PermLoop[逐 capability<br/>EvaluateExecution]:::perm
        Deny[CreateRun denied 审计]:::audit
        Allow[CreateRun + SetRunStatus Running]:::audit
        Handler[callHandler<br/>goroutine + handlerSlots 64 + recover<br/>executor.go:250]:::ext
        OutCheck[状态判定 + 输出Schema校验]:::ext
        SideEff[RegisterOwnedSideEffects]:::ext
        UpdateRun[UpdateRun 审计]:::audit
        Result[SkillResult]:::out
        AgentSpecial{agent_skill_activate?<br/>P1-TE-3}:::risk
        Trace[注入 promptTrace]:::chat

        Call --> MLLM --> Special
        Special -->|是| Inject[注入 conversation_id 等<br/>绕过 Executor 统一处理]:::risk
        Special -->|否| GetByName
        Inject --> GetByName
        GetByName --> Ex --> Checks --> PermLoop
        PermLoop -->|Deny| Deny
        PermLoop -->|Allow| Allow --> Handler --> OutCheck --> SideEff --> UpdateRun --> Result
        Result --> AgentSpecial
        AgentSpecial -->|是| Trace
        AgentSpecial -->|否| ModelReturn[返回模型]:::out
        Trace --> ModelReturn
    end

    Model --> Call

    classDef chat fill:#e8f5e9,stroke:#388e3c
    classDef scope fill:#fff4e1,stroke:#f57c00
    classDef ext fill:#f3e5f5,stroke:#7b1fa2
    classDef reg fill:#e1f5ff,stroke:#0288d1
    classDef perm fill:#ffebee,stroke:#c62828
    classDef audit fill:#fce4ec,stroke:#c2185b
    classDef out fill:#f5f5f5,stroke:#616161
    classDef src fill:#e0f2f1,stroke:#00695c
    classDef risk fill:#ffebee,stroke:#c62828,stroke-width:2px
