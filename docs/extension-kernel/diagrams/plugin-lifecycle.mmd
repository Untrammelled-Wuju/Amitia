%% 地图 G：Plugin 生命周期图
%% 依据：05-plugin.md 链路 PLG-1~PLG-7
%% 覆盖：注册、加载、启用、Hook、事件、调度、熔断、禁用、卸载
%% 关键结论：仅支持内置 builtin 注册，无第三方动态加载
flowchart TB
    subgraph Register[PLG-1 注册链]
        direction TB
        Factory[Go Plugin Factory<br/>plugin_builtin_diagnostic.go:23 newDiagnosticPlugin]:::src
        RegCall[PluginRegistry.Register<br/>plugin_registry.go:44]:::reg
        Manifest[plugin.Manifest]:::be
        Marshal[json.Marshal raw]:::be
        Validate[validate<br/>强制 Entry.Kind==builtin<br/>plugin_registry.go:109]:::risk
        Compat[compatibility 版本检查]:::be
        Store[items[id]=RegisteredPlugin]:::reg

        Factory --> RegCall --> Manifest --> Marshal --> Validate --> Compat --> Store
        Note1>注：仅内置注册 P1-PLG-1<br/>无第三方动态加载]:::risk
    end

    subgraph Load[PLG-2 启动加载链]
        direction TB
        Start[PluginManager.Start<br/>plugin_manager.go:64]:::mgr
        List[registry.List]:::reg
        Load[load<br/>plugin_manager.go:130]:::mgr
        Upsert[repository.UpsertPlugin]:::repo
        OnLoad[invoke OnLoad]:::hook
        Verify[verifyRegisteredSkills<br/>plugin_host.go]:::host
        Mig[migrateStates<br/>StateMigrator.Migrate]:::mgr
        Enable[Enable<br/>plugin_manager.go:180]:::mgr
        OnEnable[invoke OnEnable]:::hook
        SetEnabled[skills.SetEnabled<br/>Registry Scope]:::reg
        LifeUpdate[UpdatePluginLifecycle enabled]:::repo
        AuditEn[AuditPlugin]:::audit
        Emit[emitLifecycleEvent]:::mgr

        Start --> List --> Load --> Upsert --> OnLoad --> Verify --> Mig --> Enable
        Enable --> OnEnable --> SetEnabled --> LifeUpdate --> AuditEn --> Emit
    end

    subgraph Workers[4 Worker 启动]
        direction LR
        AR[afterReplyWorker]:::worker
        EI[eventIngressWorker]:::worker
        EW[eventWorker]:::worker
        SW[scheduleWorker]:::worker
    end

    subgraph Hook[PLG-3 Hook 分发链]
        direction TB
        BP[DispatchBeforePrompt<br/>同步 800ms 超时]:::mgr
        Sort1[sortedEntriesForHook]:::mgr
        Inv1[invoke<br/>plugin_manager.go:431]:::hook
        Circuit[circuit.Allow/Failure/Success]:::be
        Run[CreatePluginRun 审计]:::audit
        ARQ[DispatchAfterReply 异步入队<br/>afterReplyQ]:::mgr
        ARW[afterReplyWorker 处理]:::worker

        BP --> Sort1 --> Inv1 --> Circuit --> Run
        ARQ -.-> ARW
        ARW --> Inv1
        Note2>注：invoke 用 context.Background()<br/>不响应 Stop 取消 P1-PLG-3]:::risk
    end

    subgraph Event[PLG-4 事件链]
        direction TB
        EmitEvt[EmitSystemEvent / pluginHost.EmitEvent]:::host
        Pers[persistEvent<br/>plugin_manager.go:394]:::mgr
        CreateEvt[repository.CreatePluginEvent]:::repo
        Deliv[创建 deliveries]:::repo
        Wake[唤醒 eventWorker]:::worker
        Proc[processPendingEvents]:::worker
        Inv2[invoke OnEvent]:::hook
        UpdateDeliv[UpdatePluginDelivery]:::repo
        Retry[失败重试]:::worker

        EmitEvt --> Pers --> CreateEvt --> Deliv --> Wake --> Proc --> Inv2 --> UpdateDeliv
        UpdateDeliv -.->|failed| Retry
        Retry --> Proc
        Note3>注：EmitEvent 不重试 P2-PLG-3<br/>AfterReply 队列满丢弃 P2-PLG-1]:::risk
    end

    subgraph Sched[PLG-5 调度链]
        direction TB
        Due[DuePluginSchedules]:::repo
        ProcSched[processDueSchedules]:::worker
        Inv3[invoke OnSchedule]:::hook
        Next[nextScheduleRun]:::be
        Complete[CompletePluginSchedule]:::repo

        Due --> ProcSched --> Inv3 --> Next --> Complete
        Note4>注：不支持 cron P2-PLG-5<br/>串行限 20 条 P2-PLG-6]:::risk
    end

    subgraph Ctrl[PLG-6/7 启用/禁用/重载/熔断]
        direction TB
        Disable[Disable<br/>plugin_manager.go:225]:::mgr
        DisSkill[skills.SetEnabled false]:::reg
        OnDis[invoke OnDisable]:::hook
        Reload[Reload<br/>plugin_manager.go:269]:::mgr
        Unload[invoke OnUnload]:::hook
        Unreg[skills.Unregister]:::reg
        Reset[ResetCircuit<br/>plugin_manager.go:301]:::mgr
        Stop[Stop<br/>plugin_manager.go:90]:::mgr

        Disable --> DisSkill --> OnDis
        Reload --> Disable --> Unload --> Unreg --> Load
        Reset --> Circuit
        Stop --> Workers
        Note5>注：Stop 不注销已注册 Skills P1-PLG-2]:::risk
    end

    Start --> Workers
    Enable -.-> Hook
    Workers -.-> Event
    Workers -.-> Sched

    classDef src fill:#e0f2f1,stroke:#00695c
    classDef reg fill:#e1f5ff,stroke:#0288d1
    classDef be fill:#f3e5f5,stroke:#7b1fa2
    classDef mgr fill:#fff4e1,stroke:#f57c00
    classDef repo fill:#e8f5e9,stroke:#388e3c
    classDef host fill:#fce4ec,stroke:#c2185b
    classDef hook fill:#f5f5f5,stroke:#616161
    classDef worker fill:#e1f5ff,stroke:#0288d1
    classDef audit fill:#fce4ec,stroke:#c2185b
    classDef risk fill:#ffebee,stroke:#c62828,stroke-width:2px
