%% 地图 H：.amitiax 包生命周期图
%% 依据：07-package.md 链路 PKG-1~PKG-7
%% 覆盖：预览、安装、升级、回滚、导出、卸载、启动恢复
%% 关键发现：Manifest Schema 声明 Plugin oneOf 但 Parser 拒绝，实际支持 workflow/instructions/agent-skill
flowchart TB
    subgraph Preview[PKG-1 导入预览链]
        direction TB
        Upload[上传或本地内容<br/>package_handler.go]:::api
        Archive[Archive 安全检查<br/>package_archive.go]:::be
        Parse[Manifest 解析<br/>package_parser.go]:::be
        Schema[Schema 校验<br/>schema/manifest.schema.json]:::be
        Entry[Entry 解析]:::be
        Sign[签名与发布者检查]:::be
        Dep[依赖检查]:::be
        Risk[风险预览]:::be
        Session[Import Session]:::be

        Upload --> Archive --> Parse --> Schema --> Entry --> Sign --> Dep --> Risk --> Session
        Note1>注：Schema 声明 Plugin oneOf 但 Parser 拒绝<br/>接口与实现不一致<br/>实际支持 workflow/instructions/agent-skill]:::risk
    end

    subgraph Install[PKG-2 安装链]
        direction TB
        Req[Install Request]:::api
        ReParse[重新解析 Session]:::be
        RiskChk[风险确认校验]:::be
        Branch{Entry 类型}:::be
        WFFlow[Workflow 分支<br/>WorkflowCompiler.Compile]:::be
        InstFlow[Instructions 分支<br/>WorkshopInstaller]:::be
        ASFlow[Agent Skill 分支<br/>AgentSkillService]:::be
        Art[Artifact 保存<br/>package_installer.go]:::repo
        Def[Definition/Handler 构建]:::be
        Reg[Registry.Register<br/>extension/registry.go]:::reg
        Ver[Package Version 提交]:::repo
        Audit[Operation Audit]:::audit

        Req --> ReParse --> RiskChk --> Branch
        Branch -->|workflow| WFFlow
        Branch -->|instructions| InstFlow
        Branch -->|agent-skill| ASFlow
        WFFlow --> Art
        InstFlow --> Art
        ASFlow --> Art
        Art --> Def --> Reg --> Ver --> Audit
        Note2>注：reinstallArchivedPackage 无独立 API 入口 P1-PKG-1]:::risk
    end

    subgraph Upgrade[PKG-3 升级链]
        direction TB
        CurVer[当前版本]:::be
        UpPrev[Upgrade Preview]:::be
        Diff[Version Diff]:::be
        PermChg[权限与配置变化]:::be
        InstallNew[安装新版本]:::be
        MigCfg[配置迁移]:::be
        Archive2[旧版本归档]:::repo

        CurVer --> UpPrev --> Diff --> PermChg --> InstallNew --> MigCfg --> Archive2
    end

    subgraph Rollback[PKG-4 回滚链]
        direction TB
        Pick[选择历史版本]:::be
        ReVer[Artifact 重校验]:::be
        Backup[当前状态备份]:::repo
        Restore[目标版本恢复]:::be
        RegRest[Registry/Agent Skill 恢复]:::reg
        Comp[失败补偿]:::be

        Pick --> ReVer --> Backup --> Restore --> RegRest --> Comp
        Note3>注：Rollback 状态直接置 succeeded P2-PKG-1<br/>workshop 回滚 Hash 校验弱 P2-PKG-2]:::risk
    end

    subgraph Uninstall[PKG-5 卸载链]
        direction TB
        UnPrev[Uninstall Preview<br/>package_lifecycle.go:456]:::be
        DepChk[Dependency/Owned Resource 检查]:::be
        Disable2[禁用]:::be
        RegDel[Registry 删除]:::reg
        DelRes[Agent Skill/Workflow 删除]:::be
        Clean[Artifact/Version/Binding 清理]:::repo
        OpAudit[Operation Audit]:::audit

        UnPrev --> DepChk --> Disable2 --> RegDel --> DelRes --> Clean --> OpAudit
        Note4>注：PreviewUninstall 不做来源预检 P1-PKG-2]:::risk
    end

    subgraph Restore[PKG-6 启动恢复链]
        direction TB
        Svc[PackageService.Restore]:::be
        Read[已安装版本读取]:::repo
        VerArt[Artifact 校验]:::be
        RegRec[Registry/Agent Skill 恢复]:::reg
        Iso[异常包隔离]:::be
        RecState[Recovery 状态记录]:::repo

        Svc --> Read --> VerArt --> RegRec --> Iso --> RecState
    end

    subgraph Export[PKG-7 导出链]
        direction TB
        Exp[Export Request]:::api
        Collect[exportAmitiaxFiles<br/>package_lifecycle.go:80]:::be
        Pack[打包 .amitiax]:::be
        Download[Download API]:::api

        Exp --> Collect --> Pack --> Download
        Note5>注：exportAmitiaxFiles 不重新签名 P1-PKG-3]:::risk
    end

    Session -.-> Req
    InstallNew -.->|升级| Archive2
    Audit -.->|失败| Comp

    classDef api fill:#fff4e1,stroke:#f57c00
    classDef be fill:#f3e5f5,stroke:#7b1fa2
    classDef repo fill:#e8f5e9,stroke:#388e3c
    classDef reg fill:#e1f5ff,stroke:#0288d1
    classDef audit fill:#fce4ec,stroke:#c2185b
    classDef risk fill:#ffebee,stroke:#c62828,stroke-width:2px
