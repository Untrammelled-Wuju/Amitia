{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitia.untrammelled.top/schemas/plugin-catalog.v1.schema.json",
  "title": "Amitia Plugin Catalog v1",
  "type": "object",
  "required": ["schemaVersion", "id", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "amitia.plugin.catalog/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["official", "community", "private", "local", "custom"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "displayName": {
          "type": "string"
        },
        "trustLevel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "trustLevel": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fileName": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["verified", "unverified", "unsigned", "unknown"]
        },
        "algorithm": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "minHostVersion": {
          "type": "string"
        },
        "maxHostVersion": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string"
            },
            "translations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["extensionId", "version", "name", "package"],
      "properties": {
        "extensionId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "trustLevel": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "releaseNotes": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
