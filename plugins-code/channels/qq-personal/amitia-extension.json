{
  "manifestVersion": 1,
  "placement": "device",
  "extension": {
    "id": "com.amitia/channel-qq-personal",
    "name": {
      "default": "QQ 个人号"
    },
    "description": {
      "default": "通过 OneBot 11 反向 WebSocket 将 SnowLuma 个人 QQ 协议端接入 Amitia，支持 Windows、Linux 原生运行及 Docker 部署。"
    },
  "version": "0.2.177",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "channel",
      "messaging"
    ],
    "keywords": [
      "qq",
      "snowluma",
      "onebot",
      "personal"
    ]
  },
  "publisher": {
    "id": "com.amitia",
    "displayName": "Amitia",
    "trustLevel": "official"
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "qq-personal-service",
      "name": {
        "default": "QQ 个人号桥接服务"
      },
      "description": {
        "default": "监听 OneBot 11 反向 WebSocket，将 SnowLuma 事件转换为 Amitia 渠道消息。"
      },
      "type": "service",
      "runtime": {
        "type": "service",
        "entryPoint": "launcher.mjs",
        "timeout": "30s",
        "memory": 1073741824,
        "maxSubprocesses": 256,
        "hostAccess": {
          "filesystem": {
            "mode": "read_write",
            "roots": [
              "package",
              "plugin_data"
            ]
          },
          "network": {
            "mode": "host"
          },
          "process": {
            "mode": "direct",
            "maxProcesses": 256
          }
        }
      },
      "placement": "device",
      "providedCapabilities": [
        {
          "id": "channel.provider",
          "version": "1.0.0"
        }
      ],
      "provider": {
        "id": "com.amitia.channel-qq-personal.provider",
        "priority": 100,
        "labels": {
          "channelId": "qq_personal"
        },
        "metadata": {
          "capabilities": {
            "file": true,
            "group": true,
            "image": true,
            "reply": true,
            "text": true,
            "thread": false,
            "video": true,
            "voice": true
          },
          "id": "qq_personal",
          "sidecar": {
            "defaultPort": 6199,
            "healthPath": "/api/health",
            "statusPath": "/api/status",
            "connectPath": "/api/connect",
            "disconnectPath": "/api/disconnect",
            "configPath": "/api/config",
            "actionPath": "/api/action",
            "sendPath": "/api/send",
            "imagePath": "/api/send-image",
            "voicePath": "/api/send-voice",
            "videoPath": "/api/send-video",
            "filePath": "/api/send-file",
            "kind": "qq-personal",
            "subdir": "qq-personal-sidecar"
          }
        }
      },
      "contributions": []
    },
    {
      "id": "qq-personal-ui",
      "name": {
        "default": "QQ 个人号界面"
      },
      "description": {
            "default": "配置 SnowLuma 反向 WebSocket、查看连接状态与 SnowLuma 运行环境。"
      },
      "type": "data_only",
      "placement": "device",
      "contributions": [
        {
          "id": "qq-personal-page",
          "kind": "ui_page",
          "name": {
            "default": "QQ 个人号"
          },
          "description": {
            "default": "管理 SnowLuma OneBot 11 桥接。"
          },
          "spec": {
            "actions": [
              {
                "action_id": "status",
                "risk_level": "low",
                "target": {
                  "command": "channel.status",
                  "type": "host_command"
                },
                "title": {
                  "default": "查询 QQ 个人号状态"
                }
              },
              {
                "action_id": "config",
                "risk_level": "low",
                "target": {
                  "command": "channel.config",
                  "type": "host_command"
                },
                "title": {
                  "default": "读取 QQ 个人号配置"
                }
              },
              {
                "action_id": "connect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.connect",
                  "type": "host_command"
                },
                "title": {
                  "default": "启用 QQ 个人号桥接"
                }
              },
              {
                "action_id": "disconnect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.disconnect",
                  "type": "host_command"
                },
                "title": {
                  "default": "断开 QQ 个人号连接"
                }
              },
              {
                "action_id": "install-snowluma",
                "risk_level": "high",
                "target": {
                  "command": "channel.invoke",
                  "type": "host_command"
                },
                "title": {
                  "default": "安装或更新 SnowLuma"
                }
              },
              {
                "action_id": "start-docker",
                "risk_level": "medium",
                "target": {
                  "command": "channel.invoke",
                  "type": "host_command"
                },
                "title": {
                  "default": "启动 Docker 与 SnowLuma"
                }
              },
              {
                "action_id": "copy-text",
                "risk_level": "medium",
                "target": {
                  "type": "copy"
                },
                "title": {
                  "default": "复制文本"
                }
              },
              {
                "action_id": "change-webui-password",
                "risk_level": "medium",
                "target": {
                  "command": "channel.invoke",
                  "type": "host_command"
                },
                "title": {
                  "default": "修改 SnowLuma WebUI 密码"
                }
              },
              {
                "action_id": "record-webui-password",
                "risk_level": "medium",
                "target": {
                  "command": "channel.invoke",
                  "type": "host_command"
                },
                "title": {
                  "default": "记录 SnowLuma WebUI 密码"
                }
              },
              {
                "action_id": "clear-webui-password",
                "risk_level": "medium",
                "target": {
                  "command": "channel.invoke",
                  "type": "host_command"
                },
                "title": {
                  "default": "清除已记录的 WebUI 密码"
                }
              }
            ],
            "permissions": [
              {
                "name": "clipboard.write",
                "scope": "session",
                "reason": "复制插件页面中的 OneBot Token、SnowLuma 账号密码和反向 WebSocket 地址。",
                "required": true
              }
            ],
            "contract_version": 1,
            "contribution_id": "qq-personal-page",
            "display": {
              "description": {
                "default": "将 SnowLuma 收到的个人 QQ 消息桥接到 Amitia。"
              },
              "icon": "connection",
              "title": {
                "default": "QQ 个人号"
              }
            },
            "entry": {
              "content_hash": "pending",
              "path": "modules/qq-personal-ui/desktop/index.mjs",
              "type": "client_module"
            },
            "extension_id": "com.amitia/channel-qq-personal",
            "integrity": {
              "definition_hash": "qq-personal-page-v1"
            },
            "kind": "web_page",
            "module_id": "qq-personal-ui",
            "sandbox": {
              "type": "client_module"
            },
            "slot": {
              "contract_version": 1,
              "slot_id": "provider.page.provider"
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            }
          },
          "requiredPermissions": [
            "service.network.request",
            "clipboard.write"
          ]
        },
        {
          "id": "qq-personal-mobile-page",
          "kind": "ui_page",
          "name": {
            "default": "QQ 个人号（手机）"
