                  "command": "channel.connect",
                  "type": "host_command"
                },
                "title": {
                  "default": "启用 QQ 个人号桥接"
                }
              },
              {
                "action_id": "disconnect",
                "risk_level": "medium",
                "target": {
                  "command": "channel.disconnect",
                  "type": "host_command"
                },
                "title": {
                  "default": "断开 QQ 个人号连接"
                }
              }
            ],
            "contract_version": 1,
            "contribution_id": "qq-personal-mobile-page",
            "display": {
              "description": {
                "default": "配置 SnowLuma OneBot 11 桥接。"
              },
              "icon": "connection",
              "title": {
                "default": "QQ 个人号"
              }
            },
            "entry": {
              "content_hash": "",
              "schema_path": "modules/qq-personal-ui/mobile/schema.json",
              "type": "schema_renderer"
            },
            "extension_id": "com.amitia/channel-qq-personal",
            "integrity": {
              "definition_hash": "qq-personal-page-v1"
            },
            "kind": "schema_page",
            "module_id": "qq-personal-ui",
            "sandbox": {
              "type": "schema_renderer"
            },
            "slot": {
              "contract_version": 1,
              "slot_id": "provider.page.provider"
            },
            "visibility": {
              "platforms": [
                "android",
                "ios"
              ]
            }
          },
          "requiredPermissions": [
            "service.network.request"
          ]
        },
