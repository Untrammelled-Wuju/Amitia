  "permissions": [
    {
      "name": "conversation.read",
      "reason": "在渠道消息页面读取 SnowLuma 个人 QQ 会话。",
      "required": true,
      "scope": "global"
    },
    {
      "name": "conversation.write",
      "reason": "将 SnowLuma 入站消息提交给 Amitia 统一会话管线。",
      "required": true,
      "scope": "global"
    },
    {
      "name": "message.send",
      "reason": "向个人 QQ 用户或群聊发送角色回复。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.provider.register",
      "reason": "注册 QQ 个人号渠道 Provider。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.network.request",
      "reason": "连接本机 Amitia Core 并调用 SnowLuma OneBot action。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.network.listen_loopback",
      "reason": "在本地回环地址提供 OneBot 反向 WebSocket 和渠道接口。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.background.run",
      "reason": "持续监听 SnowLuma 反向 WebSocket 并转发消息。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "clipboard.write",
      "reason": "从 QQ 个人号插件页面复制 OneBot Token、SnowLuma WebUI 与 noVNC 账号密码和反向 WebSocket 地址。",
      "required": true,
      "scope": "session"
    },
    {
      "name": "files.read",
      "reason": "读取 SnowLuma 原生数据目录中的 webui.json，或通过 docker exec 读取容器中的 WebUI 与 noVNC 凭据。",
      "required": true,
      "scope": "global"
    }
  ],
  "lifecycle": {
    "autoUpdate": true,
    "backgroundTasks": true,
    "networkAccess": true,
    "sandbox": false
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  },
  "development": {}
}
