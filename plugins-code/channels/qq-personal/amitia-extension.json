                  "route": "/channels/qq-personal",
                  "icon": "connection",
                  "group": "character",
                  "groupLabel": "角色",
                  "groupIcon": "character",
                  "order": 46,
                  "mobile": true
                }
              ],
              "routes": [
                {
                  "capability": "page.provider",
