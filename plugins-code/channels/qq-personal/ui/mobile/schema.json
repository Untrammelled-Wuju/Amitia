{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "QQ 个人号",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "status",
        "target": "host_command",
        "input": { "channelId": "qq_personal" },
        "statePath": "status"
      },
      {
        "action_id": "config",
        "target": "host_command",
        "input": { "channelId": "qq_personal" },
        "statePath": "config"
      }
    ]
  },
  "actions": [
    { "actionId": "status", "target": "host_command" },
    { "actionId": "config", "target": "host_command" },
    { "actionId": "connect", "target": "host_command" },
    { "actionId": "disconnect", "target": "host_command" }
  ],
  "children": [
    {
      "id": "qq-personal-page",
      "type": "page",
      "children": [
        {
          "id": "qq-personal-status",
          "type": "key_value",
          "props": { "title": "连接状态", "columns": 1 },
          "bindings": [
            { "path": "items", "source": "state", "sourcePath": "status.data" }
          ]
        },
        {
          "id": "qq-personal-notice",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "SnowLuma 反向 WebSocket",
            "description": "在 SnowLuma 网络配置中新建 WebSocket 客户端，填写反向 WebSocket 地址和 Token。WebUI 与 noVNC 地址、账号密码见下方已保存配置，桌面端会直接展示并支持一键复制。"
          }
        },
        {
          "id": "qq-personal-config",
          "type": "section",
          "props": { "title": "桥接配置" },
          "children": [
            {
              "id": "qq-personal-token",
              "type": "field",
              "props": { "label": "OneBot Token", "variant": "password" },
              "bindings": [
                { "path": "credentials.token", "source": "form", "default": "" }
              ]
            },
            {
              "id": "qq-personal-trigger",
              "type": "select",
              "props": {
                "label": "群聊触发方式",
                "options": [
                  { "label": "仅 @机器人", "value": "mention" },
                  { "label": "所有群消息", "value": "all" },
                  { "label": "指定前缀", "value": "prefix" }
                ]
              },
              "bindings": [
                { "path": "credentials.groupTrigger", "source": "form", "default": "mention" }
              ]
            },
            {
              "id": "qq-personal-prefix",
              "type": "field",
              "props": { "label": "群聊触发前缀", "placeholder": "Amitia" },
              "bindings": [
                { "path": "credentials.triggerPrefix", "source": "form", "default": "Amitia" }
              ]
            },
            {
              "id": "qq-personal-webui-port",
              "type": "field",
              "props": { "label": "SnowLuma WebUI 端口", "placeholder": "5099" },
              "bindings": [
                { "path": "credentials.webuiPort", "source": "form", "default": "5099" }
              ]
            },
            {
              "id": "qq-personal-novnc-port",
              "type": "field",
              "props": { "label": "noVNC 端口", "placeholder": "6081" },
              "bindings": [
                { "path": "credentials.novncPort", "source": "form", "default": "6081" }
              ]
            },
            {
              "id": "qq-personal-save",
              "type": "button",
              "props": { "text": "保存并启用", "type": "primary" },
              "actions": [
                {
                  "action_id": "connect",
                  "target": "host_command",
                  "input": {
                    "channelId": "qq_personal",
                    "config": {
                      "token": "$form.credentials.token",
                      "groupTrigger": "$form.credentials.groupTrigger",
                      "triggerPrefix": "$form.credentials.triggerPrefix",
                      "webuiPort": "$form.credentials.webuiPort",
                      "novncPort": "$form.credentials.novncPort"
                    }
                  },
                  "statePath": "connectResult"
                },
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": { "channelId": "qq_personal" },
                  "statePath": "status"
                }
              ]
            },
            {
              "id": "qq-personal-refresh",
              "type": "button",
              "props": { "text": "刷新状态" },
              "actions": [
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": { "channelId": "qq_personal" },
                  "statePath": "status"
                }
              ]
            },
            {
              "id": "qq-personal-disconnect",
              "type": "button",
              "props": { "text": "断开连接", "type": "danger" },
              "actions": [
                {
                  "action_id": "disconnect",
                  "target": "host_command",
                  "input": { "channelId": "qq_personal" },
                  "confirmation": "确认断开 QQ 个人号桥接？",
                  "statePath": "disconnectResult"
                },
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": { "channelId": "qq_personal" },
                  "statePath": "status"
                }
              ]
            }
          ]
        },
        {
          "id": "qq-personal-saved-config",
          "type": "key_value",
          "props": { "title": "已保存配置", "columns": 1 },
          "bindings": [
            { "path": "items", "source": "state", "sourcePath": "config.data" }
          ]
        }
      ]
    }
  ],
  "theme": { "mode": "auto" },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 120,
    "maxLayoutCount": 180,
    "maxNodeCount": 180,
    "maxDataFetchCount": 2,
    "maxActionCount": 12
  }
}
