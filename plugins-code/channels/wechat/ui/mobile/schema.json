{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "微信渠道（手机端）",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "status",
        "target": "host_command",
        "input": {
          "channelId": "wechat"
        },
        "statePath": "status"
      }
    ],
    "onRefresh": [
      {
        "action_id": "status",
        "target": "host_command",
        "input": {
          "channelId": "wechat"
        },
        "statePath": "status"
      }
    ],
    "refreshIntervalMs": 5000
  },
  "actions": [
    {
      "actionId": "status",
      "target": "host_command"
    },
    {
      "actionId": "connect",
      "target": "host_command"
    },
    {
      "actionId": "disconnect",
      "target": "host_command"
    }
  ],
  "children": [
    {
      "id": "wechat-mobile-page",
      "type": "page",
      "children": [
        {
          "id": "wechat-mobile-status",
          "type": "runtime_status",
          "props": {
            "label": "微信连接状态"
          },
          "bindings": [
            {
              "path": "status",
              "source": "state",
              "sourcePath": "status.status"
            },
            {
              "path": "statusText",
              "source": "state",
              "sourcePath": "status.status"
            },
            {
              "path": "message",
              "source": "state",
              "sourcePath": "status.lastError"
            }
          ]
        },
        {
          "id": "wechat-mobile-account",
          "type": "field",
          "props": {
            "label": "微信账号",
            "placeholder": "未登录"
          },
          "bindings": [
            {
              "path": "value",
              "source": "state",
              "sourcePath": "status.accountId",
              "default": ""
            }
          ],
          "visibleWhen": [
            {
              "field": "status.status",
              "operator": "==",
              "value": "connected"
            }
          ]
        },
        {
          "id": "wechat-mobile-message",
          "type": "field",
          "props": {
            "label": "当前提示",
            "variant": "textarea",
            "rows": 2
          },
          "bindings": [
            {
              "path": "value",
              "source": "state",
              "sourcePath": "status.message",
              "default": ""
            }
          ],
          "visibleWhen": [
            {
              "field": "status.message",
              "operator": "not_null"
            },
            {
              "field": "status.status",
              "operator": "!=",
              "value": "connected"
            }
          ]
        },
        {
          "id": "wechat-mobile-error",
          "type": "field",
          "props": {
            "label": "连接错误",
            "variant": "textarea",
            "rows": 2
          },
          "bindings": [
            {
              "path": "value",
              "source": "state",
              "sourcePath": "status.lastError",
              "default": ""
            }
          ],
          "visibleWhen": [
            {
              "field": "status.lastError",
              "operator": "not_null"
            }
          ]
        },
        {
          "id": "wechat-mobile-qr",
          "type": "image",
          "props": {
            "alt": "微信登录二维码",
            "fit": "contain",
            "height": 280,
            "preview": true
          },
          "bindings": [
            {
              "path": "src",
              "source": "state",
              "sourcePath": "connectResult.data.qrImageUrl"
            }
          ],
          "visibleWhen": [
            {
              "field": "connectResult.data.qrImageUrl",
              "operator": "not_null"
            },
            {
              "field": "status.status",
              "operator": "!=",
              "value": "connected"
            }
          ]
        },
        {
          "id": "wechat-mobile-actions",
          "type": "row",
          "props": {
            "gap": 12
          },
          "children": [
            {
              "id": "wechat-mobile-refresh",
              "type": "button",
              "props": {
                "text": "刷新",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": {
                    "channelId": "wechat"
                  },
                  "statePath": "status"
                }
              ]
            },
            {
              "id": "wechat-mobile-connect",
              "type": "button",
              "props": {
                "text": "获取或刷新二维码"
              },
              "actions": [
                {
                  "action_id": "connect",
                  "target": "host_command",
                  "input": {
                    "channelId": "wechat",
                    "config": {
                      "force": true
                    }
                  },
                  "statePath": "connectResult"
                },
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": {
                    "channelId": "wechat"
                  },
                  "statePath": "status"
                }
              ],
              "visibleWhen": [
                {
                  "field": "status.status",
                  "operator": "!=",
                  "value": "connected"
                }
              ]
            },
            {
              "id": "wechat-mobile-disconnect",
              "type": "button",
              "props": {
                "text": "退出登录",
                "type": "danger"
              },
              "actions": [
                {
                  "action_id": "disconnect",
                  "target": "host_command",
                  "input": {
                    "channelId": "wechat"
                  },
                  "confirmation": "确认退出当前微信账号？",
                  "statePath": "disconnectResult"
                },
                {
                  "action_id": "status",
                  "target": "host_command",
                  "input": {
                    "channelId": "wechat"
                  },
                  "statePath": "status"
                }
              ],
              "visibleWhen": [
                {
                  "field": "status.status",
                  "operator": "==",
                  "value": "connected"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 140,
    "maxLayoutCount": 160,
    "maxNodeCount": 160,
    "maxDataFetchCount": 2,
    "maxActionCount": 12
  }
}
