{
  "manifestVersion": 1,
  "extension": {
    "id": "com.amitia/emote",
    "name": {
      "default": "表情包"
    },
    "description": {
      "default": "提供表情包管理、AI 表情选择、聊天发送和消息渲染。"
    },
    "version": "1.1.4",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "character",
      "media"
    ],
    "keywords": [
      "emote",
      "sticker",
      "media"
    ]
  },
  "publisher": {
    "id": "com.amitia",
    "displayName": "Amitia",
    "trustLevel": "official"
  },
  "placement": "device",
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "emote-runtime",
      "name": {
        "default": "表情包运行时"
      },
      "description": {
        "default": "管理插件自有表情数据、资源和发送决策。"
      },
      "type": "javascript",
      "placement": "device",
      "deviceRequirements": {
        "platforms": [
          "windows",
          "linux",
          "macos",
          "android",
          "ios"
        ]
      },
      "runtime": {
        "type": "javascript",
        "entryPoint": "dist/index.js",
        "timeout": "120s",
        "memory": 268435456,
        "maxSubprocesses": 0,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "providedCapabilities": [
        {
          "id": "com.amitia/emote/ai",
          "version": "1.0.0",
          "metadata": {
            "toolId": "com.amitia/emote/ai"
          }
        }
      ],
      "contributions": [
        {
          "id": "emote-command",
          "kind": "tool",
          "name": {
            "default": "表情包命令"
          },
          "description": {
            "default": "表情包插件内部管理和发送入口。"
          },
          "requiredPermissions": [
            "storage.state.read",
            "storage.state.write",
            "resource.read",
            "resource.write",
            "message.append"
          ],
          "spec": {
            "toolId": "com.amitia/emote/command",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "payload": {
                  "type": "object"
                },
                "node_id": {
                  "type": "string"
                },
                "form_state": {
                  "type": "object"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "mimeType",
                      "size",
                      "dataBase64"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "mimeType": {
                        "type": "string"
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "dataBase64": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "high",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          }
        },
        {
          "id": "emote-ai",
          "kind": "tool",
          "name": {
            "default": "AI 表情选择"
          },
          "description": {
            "default": "回复适合使用表情时，先调用 action=list 获取可用表情的 id、名称、含义和关键词，由模型根据当前语境自主选择最合适的表情，再调用 action=send 发送。"
          },
          "requiredPermissions": [
            "storage.state.read",
            "storage.state.write",
            "resource.read",
            "resource.write",
            "message.append"
          ],
          "spec": {
            "toolId": "com.amitia/emote/ai",
            "modelName": "emote",
            "handlerName": "ai",
            "inputSchema": {
              "type": "object",
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "list",
                    "send"
                  ]
                },
                "emoteId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "characterId": {
                  "type": "string"
                },
                "conversationId": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "replyToMessageId": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "medium",
            "sideEffect": "write",
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "ai"
            }
          }
        }
      ]
    },
    {
      "id": "emote-ui",
      "name": {
        "default": "表情包界面"
      },
      "description": {
        "default": "在角色导航组和聊天区域提供表情包界面。"
      },
      "type": "data_only",
      "placement": "device",
      "contributions": [
        {
          "id": "emote-page",
          "kind": "ui_page",
          "name": {
            "default": "表情包管理"
          },
          "requiredPermissions": [
            "tool.invoke"
          ],
          "spec": {
            "contribution_id": "emote-page",
            "extension_id": "com.amitia/emote",
            "module_id": "emote-ui",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "表情包管理"
              },
              "description": {
                "default": "管理表情、分组和 AI 使用设置。"
              },
              "icon": "star"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/emote-ui/desktop/index.schema.json",
              "content_hash": "emote-page-v1"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行表情包命令"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/emote/command"
                },
                "risk_level": "high"
              }
            ],
            "integrity": {
              "definition_hash": "emote-page-v1"
            }
          }
        },
        {
          "id": "emote-mobile-page",
          "kind": "ui_page",
          "name": {
            "default": "表情包管理（手机）"
          },
          "requiredPermissions": [
