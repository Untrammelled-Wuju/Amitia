          "spec": {
            "contribution_id": "emote-mobile-page",
            "extension_id": "com.amitia/emote",
            "module_id": "emote-ui",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "表情包管理"
              },
              "description": {
                "default": "管理表情、分组和 AI 使用设置。"
              },
              "icon": "star"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/emote-ui/mobile/index.schema.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "visibility": {
              "platforms": [
                "android",
                "ios"
              ]
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行表情包命令"
