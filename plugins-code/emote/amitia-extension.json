  ],
  "permissions": [
    {
      "name": "storage.state.read",
      "reason": "读取插件自有表情、分组、设置和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.state.write",
      "reason": "保存插件自有表情、分组、设置和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "resource.read",
      "reason": "读取插件自有图片和资源链接。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "resource.write",
      "reason": "写入和删除插件自有图片资源。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "message.append",
      "reason": "把用户选择的表情作为通用图片消息写入当前聊天。",
      "required": true,
      "scope": "conversation"
    },
    {
      "name": "tool.invoke",
      "reason": "通过声明的表情包工具执行界面操作。",
      "required": true,
      "scope": "extension"
    }
  ],
  "lifecycle": {
    "backgroundTasks": false,
    "networkAccess": false,
    "sandbox": true
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
