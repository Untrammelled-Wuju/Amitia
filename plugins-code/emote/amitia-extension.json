            "contract_version": 1,
            "display": {
              "title": {
                "default": "发送表情"
              },
              "icon": "emote"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/emote-ui/desktop/composer.schema.json",
              "content_hash": "emote-composer-v1"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "visibility": {
              "platforms": [
                "windows",
