{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "表情包管理（桌面端）",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "ui.dashboard"
        },
        "statePath": "dashboard"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "emote-page",
      "type": "page",
      "children": [
        {
          "id": "emote-tabs",
          "type": "tabs",
          "props": {
            "queryParam": "tab",
            "navigation": "external"
          },
          "children": [
            {
              "id": "emote-tab-gallery",
              "type": "tab_item",
              "props": {
                "label": "表情",
                "name": "emotes"
              },
              "children": [
                {
                  "id": "emote-toolbar",
                  "type": "row",
                  "props": {
                    "layout": "toolbar",
                    "gap": "12px"
                  },
                  "children": [
                    {
                      "id": "emote-search",
                      "type": "field",
                      "props": {
                        "placeholder": "搜索名称、含义或关键词",
                        "clearable": true
                      },
                      "bindings": [
                        {
                          "path": "browser.query",
                          "source": "form",
                          "default": ""
                        }
                      ]
                    },
                    {
                      "id": "emote-count",
                      "type": "text",
                      "bindings": [
                        {
                          "path": "text",
                          "source": "state",
                          "sourcePath": "dashboard.countLabel"
                        }
                      ]
                    },
                    {
                      "id": "emote-refresh",
                      "type": "button",
                      "props": {
                        "text": "刷新"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.dashboard"
                          },
                          "statePath": "dashboard"
                        }
                      ]
                    },
                    {
                      "id": "emote-import",
                      "type": "file_picker",
                      "props": {
                        "text": "导入表情包",
                        "accept": ".png,.jpg,.jpeg,.gif,.webp",
                        "multiple": true
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.import",
                            "payload": {}
                          },
                          "statePath": "importResult"
                        },
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.dashboard"
                          },
                          "statePath": "dashboard"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "emote-workspace",
                  "type": "grid",
                  "props": {
                    "layout": "master-detail",
                    "gap": "24px"
                  },
                  "children": [
                    {
                      "id": "emote-gallery",
                      "type": "gallery",
                      "props": {
                        "variant": "assets",
                        "imageField": "thumbnailUrl",
                        "titleField": "name",
                        "subtitleField": "none",
                        "minItemWidth": 144,
                        "emptyText": "没有符合条件的表情",
                        "searchFields": [
                          "name",
                          "meaning",
                          "keywords"
                        ],
                        "showSubtitle": false,
                        "showCount": true
                      },
                      "bindings": [
                        {
                          "path": "items",
                          "source": "state",
                          "sourcePath": "dashboard.emotes"
                        },
                        {
                          "path": "query",
                          "source": "form",
                          "sourcePath": "browser.query"
                        },
                        {
                          "path": "selectedId",
                          "source": "form",
                          "sourcePath": "selected.id"
                        }
                      ],
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.select_emote",
                            "payload": {
                              "id": "$item.id"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "emote-detail",
                      "type": "section",
                      "props": {
                        "title": "表情详情"
                      },
                      "children": [
                        {
                          "id": "emote-detail-preview",
                          "type": "image",
                          "props": {
                            "fit": "contain",
                            "height": 220,
                            "preview": true
                          },
                          "bindings": [
                            {
                              "path": "src",
                              "source": "form",
                              "sourcePath": "selected.assetUrl"
                            }
                          ]
                        },
                        {
                          "id": "emote-detail-form",
                          "type": "stack",
                          "props": {
                            "gap": "16px"
                          },
                          "visibleWhen": [
                            {
                              "field": "selected.id",
                              "operator": "!=",
                              "value": ""
                            }
                          ],
                          "children": [
                            {
                              "id": "emote-detail-name",
                              "type": "field",
                              "props": {
                                "label": "名称"
                              },
                              "bindings": [
                                {
                                  "path": "selected.name",
                                  "source": "form",
                                  "default": ""
                                }
                              ]
                            },
                            {
                              "id": "emote-detail-meaning",
                              "type": "field",
                              "props": {
                                "label": "含义",
                                "variant": "textarea",
                                "rows": 3
                              },
                              "bindings": [
                                {
                                  "path": "selected.meaning",
                                  "source": "form",
                                  "default": ""
                                }
                              ]
                            },
                            {
                              "id": "emote-detail-keywords",
                              "type": "field",
                              "props": {
                                "label": "关键词",
                                "placeholder": "使用中英文逗号分隔"
                              },
                              "bindings": [
                                {
                                  "path": "selected.keywords",
                                  "source": "form",
                                  "default": ""
                                }
                              ]
                            },
                            {
                              "id": "emote-detail-ai",
                              "type": "switch",
                              "props": {
                                "activeText": "允许 AI 使用"
                              },
                              "bindings": [
                                {
                                  "path": "selected.aiEnabled",
                                  "source": "form",
                                  "default": false
                                }
                              ]
                            },
                            {
                              "id": "emote-detail-actions",
                              "type": "row",
                              "children": [
                                {
                                  "id": "emote-detail-save",
                                  "type": "button",
                                  "props": {
                                    "text": "保存",
                                    "type": "primary"
                                  },
                                  "actions": [
                                    {
                                      "action_id": "command",
                                      "target": "tool",
                                      "input": {
                                        "action": "emotes.update",
                                        "payload": {
                                          "id": "$form.selected.id",
                                          "name": "$form.selected.name",
                                          "meaning": "$form.selected.meaning",
                                          "keywords": "$form.selected.keywords",
                                          "aiEnabled": "$form.selected.aiEnabled"
                                        }
                                      },
                                      "statePath": "detailSaveResult"
                                    },
                                    {
                                      "action_id": "command",
                                      "target": "tool",
                                      "input": {
                                        "action": "ui.dashboard"
                                      },
                                      "statePath": "dashboard"
                                    }
                                  ]
                                },
                                {
                                  "id": "emote-detail-delete",
                                  "type": "button",
                                  "props": {
                                    "text": "删除",
                                    "type": "danger"
                                  },
                                  "actions": [
                                    {
                                      "action_id": "command",
                                      "target": "tool",
                                      "input": {
                                        "action": "emotes.delete",
                                        "payload": {
                                          "id": "$form.selected.id"
                                        }
                                      },
                                      "confirmation": "确认删除该表情？",
                                      "statePath": "detailDeleteResult"
                                    },
                                    {
                                      "action_id": "command",
                                      "target": "tool",
                                      "input": {
                                        "action": "ui.dashboard"
                                      },
                                      "statePath": "dashboard"
                                    }
                                  ]
                                }
                              ],
                              "props": {
                                "gap": "8px"
                              }
                            }
                          ]
                        },
                        {
                          "id": "emote-detail-close",
                          "type": "button",
                          "props": {
                            "text": "关闭详情"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.close_detail"
                              }
                            }
                          ]
                        }
                      ],
                      "visibleWhen": [
                        {
                          "field": "selected.id",
                          "operator": "!=",
                          "value": ""
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "emote-tab-groups",
              "type": "tab_item",
              "props": {
                "label": "分组",
                "name": "groups"
              },
              "children": [
                {
                  "id": "emote-group-overview",
                  "type": "stack",
                  "props": {
                    "gap": "20px"
                  },
                  "children": [
                    {
                      "id": "emote-group-toolbar",
                      "type": "row",
                      "props": {
                        "layout": "toolbar",
                        "justify": "space-between"
                      },
                      "children": [
                        {
                          "id": "emote-group-label",
                          "type": "text",
                          "props": {
                            "text": "我的分组",
                            "variant": "title"
                          }
                        },
                        {
                          "id": "emote-group-create",
                          "type": "button",
                          "props": {
                            "text": "新建分组",
                            "type": "primary"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.group_dialog",
                                "payload": {
                                  "open": true
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "emote-groups-gallery",
                      "type": "gallery",
                      "props": {
                        "variant": "collections",
                        "titleField": "name",
                        "subtitleField": "countLabel",
                        "minItemWidth": 210,
                        "emptyText": "还没有分组，在上方创建第一个分组"
                      },
                      "bindings": [
                        {
                          "path": "items",
                          "source": "state",
                          "sourcePath": "dashboard.groups"
                        }
                      ],
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.select_group",
                            "payload": {
                              "id": "$item.id"
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "visibleWhen": [
                    {
                      "field": "browser.groupId",
                      "operator": "==",
                      "value": ""
                    }
                  ]
                },
                {
                  "id": "emote-group-content",
                  "type": "stack",
                  "props": {
                    "gap": "20px"
                  },
                  "children": [
                    {
                      "id": "emote-group-header",
                      "type": "row",
                      "props": {
                        "layout": "toolbar"
                      },
                      "children": [
                        {
                          "id": "emote-group-back",
                          "type": "button",
                          "props": {
                            "text": "返回分组"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.select_group",
                                "payload": {
                                  "id": ""
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "emote-group-current-name",
                          "type": "text",
                          "props": {
                            "variant": "title"
                          },
                          "bindings": [
                            {
                              "path": "text",
                              "source": "form",
                              "sourcePath": "browser.groupName"
                            }
                          ]
                        },
                        {
                          "id": "emote-group-search",
                          "type": "field",
                          "props": {
                            "placeholder": "搜索名称、含义或关键词",
                            "clearable": true
                          },
                          "bindings": [
                            {
                              "path": "browser.query",
                              "source": "form",
                              "default": ""
                            }
                          ]
                        },
                        {
                          "id": "emote-group-add",
                          "type": "button",
                          "props": {
                            "text": "添加已有表情"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.group_picker",
                                "payload": {
                                  "open": true
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "emote-group-import",
                          "type": "file_picker",
                          "props": {
                            "text": "导入到当前分组",
                            "accept": ".png,.jpg,.jpeg,.gif,.webp",
                            "multiple": true
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.import",
                                "payload": {
                                  "groupId": "$form.browser.groupId"
                                }
                              },
                              "statePath": "importResult"
                            },
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.dashboard"
                              },
                              "statePath": "dashboard"
                            }
                          ]
                        },
                        {
                          "id": "emote-group-delete",
                          "type": "button",
                          "props": {
                            "text": "删除分组",
                            "type": "danger",
                            "plain": true
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "groups.delete",
                                "payload": {
                                  "id": "$form.browser.groupId"
                                }
                              },
                              "confirmation": "确认删除当前分组？分组中的图片会保留，只解除与该分组的关联。"
                            },
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.select_group",
                                "payload": {
                                  "id": ""
                                }
                              }
                            },
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.dashboard"
                              },
                              "statePath": "dashboard"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "emote-group-picker",
                      "type": "section",
                      "props": {
                        "title": "添加已有表情"
                      },
                      "children": [
                        {
                          "id": "emote-group-picker-select",
                          "type": "select",
                          "props": {
                            "placeholder": "选择要加入的表情，可多选",
                            "multiple": true,
                            "filterable": true,
                            "clearable": true
                          },
                          "bindings": [
                            {
                              "path": "picker.emoteIds",
                              "source": "form",
                              "default": []
                            },
                            {
                              "path": "options",
                              "source": "state",
                              "sourcePath": "dashboard.emotes"
                            }
                          ]
                        },
                        {
                          "id": "emote-group-picker-actions",
                          "type": "row",
                          "props": {
                            "gap": "8px"
                          },
                          "children": [
                            {
                              "id": "emote-group-picker-save",
                              "type": "button",
                              "props": {
                                "text": "加入分组",
                                "type": "primary"
                              },
                              "actions": [
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "groups.add",
                                    "payload": {
                                      "groupId": "$form.browser.groupId",
                                      "emoteIds": "$form.picker.emoteIds"
                                    }
                                  }
                                },
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "ui.dashboard"
                                  },
                                  "statePath": "dashboard"
                                }
                              ]
                            },
                            {
                              "id": "emote-group-picker-cancel",
                              "type": "button",
                              "props": {
                                "text": "取消"
                              },
                              "actions": [
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "ui.group_picker",
                                    "payload": {
                                      "open": false
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "visibleWhen": [
                        {
                          "field": "picker.open",
                          "operator": "==",
                          "value": true
                        }
                      ]
                    },
                    {
                      "id": "emote-group-workspace",
                      "type": "grid",
                      "props": {
                        "layout": "master-detail",
                        "gap": "24px"
                      },
                      "children": [
                        {
                          "id": "emote-group-gallery",
                          "type": "gallery",
                          "props": {
                            "variant": "assets",
                            "imageField": "thumbnailUrl",
                            "titleField": "name",
                            "subtitleField": "none",
                            "minItemWidth": 144,
                            "emptyText": "没有符合条件的表情",
                            "searchFields": [
                              "name",
                              "meaning",
                              "keywords"
                            ],
                            "filterField": "groupIds",
                            "showSubtitle": false,
                            "showCount": true
                          },
                          "bindings": [
                            {
                              "path": "items",
                              "source": "state",
                              "sourcePath": "dashboard.emotes"
                            },
                            {
                              "path": "query",
                              "source": "form",
                              "sourcePath": "browser.query"
                            },
                            {
                              "path": "selectedId",
                              "source": "form",
                              "sourcePath": "selected.id"
                            },
                            {
                              "path": "filterValue",
                              "source": "form",
                              "sourcePath": "browser.groupId"
                            }
                          ],
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.select_emote",
                                "payload": {
                                  "id": "$item.id"
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "emote-group-detail",
                          "type": "section",
                          "props": {
                            "title": "表情详情"
                          },
                          "children": [
                            {
                              "id": "emote-group-detail-preview",
                              "type": "image",
                              "props": {
                                "fit": "contain",
                                "height": 220,
                                "preview": true
                              },
                              "bindings": [
                                {
                                  "path": "src",
                                  "source": "form",
                                  "sourcePath": "selected.assetUrl"
                                }
                              ]
                            },
                            {
                              "id": "emote-group-detail-form",
                              "type": "stack",
                              "props": {
                                "gap": "16px"
                              },
                              "visibleWhen": [
                                {
                                  "field": "selected.id",
                                  "operator": "!=",
                                  "value": ""
                                }
                              ],
                              "children": [
                                {
                                  "id": "emote-group-detail-name",
                                  "type": "field",
                                  "props": {
                                    "label": "名称"
                                  },
                                  "bindings": [
                                    {
                                      "path": "selected.name",
                                      "source": "form",
                                      "default": ""
                                    }
                                  ]
                                },
                                {
                                  "id": "emote-group-detail-meaning",
                                  "type": "field",
                                  "props": {
                                    "label": "含义",
                                    "variant": "textarea",
                                    "rows": 3
                                  },
                                  "bindings": [
                                    {
                                      "path": "selected.meaning",
                                      "source": "form",
                                      "default": ""
                                    }
                                  ]
                                },
                                {
                                  "id": "emote-group-detail-keywords",
                                  "type": "field",
                                  "props": {
                                    "label": "关键词",
                                    "placeholder": "使用中英文逗号分隔"
                                  },
                                  "bindings": [
                                    {
                                      "path": "selected.keywords",
                                      "source": "form",
                                      "default": ""
                                    }
                                  ]
                                },
                                {
                                  "id": "emote-group-detail-ai",
                                  "type": "switch",
                                  "props": {
                                    "activeText": "允许 AI 使用"
                                  },
                                  "bindings": [
                                    {
                                      "path": "selected.aiEnabled",
                                      "source": "form",
                                      "default": false
                                    }
                                  ]
                                },
                                {
                                  "id": "emote-group-detail-actions",
                                  "type": "row",
                                  "children": [
                                    {
                                      "id": "emote-group-detail-save",
                                      "type": "button",
                                      "props": {
                                        "text": "保存",
                                        "type": "primary"
                                      },
                                      "actions": [
                                        {
                                          "action_id": "command",
                                          "target": "tool",
                                          "input": {
                                            "action": "emotes.update",
                                            "payload": {
                                              "id": "$form.selected.id",
                                              "name": "$form.selected.name",
                                              "meaning": "$form.selected.meaning",
                                              "keywords": "$form.selected.keywords",
                                              "aiEnabled": "$form.selected.aiEnabled"
                                            }
                                          },
                                          "statePath": "detailSaveResult"
                                        },
                                        {
                                          "action_id": "command",
                                          "target": "tool",
                                          "input": {
                                            "action": "ui.dashboard"
                                          },
                                          "statePath": "dashboard"
                                        }
                                      ]
                                    },
                                    {
                                      "id": "emote-group-detail-delete",
                                      "type": "button",
                                      "props": {
                                        "text": "删除",
                                        "type": "danger"
                                      },
                                      "actions": [
                                        {
                                          "action_id": "command",
                                          "target": "tool",
                                          "input": {
                                            "action": "emotes.delete",
                                            "payload": {
                                              "id": "$form.selected.id"
                                            }
                                          },
                                          "confirmation": "确认删除该表情？",
                                          "statePath": "detailDeleteResult"
                                        },
                                        {
                                          "action_id": "command",
                                          "target": "tool",
                                          "input": {
                                            "action": "ui.dashboard"
                                          },
                                          "statePath": "dashboard"
                                        }
                                      ]
                                    }
                                  ],
                                  "props": {
                                    "gap": "8px"
                                  }
                                }
                              ]
                            },
                            {
                              "id": "emote-group-detail-close",
                              "type": "button",
                              "props": {
                                "text": "关闭详情"
                              },
                              "actions": [
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "ui.close_detail"
                                  }
                                }
                              ]
                            },
                            {
                              "id": "emote-group-detail-remove",
                              "type": "button",
                              "props": {
                                "text": "移出当前分组"
                              },
                              "actions": [
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "groups.remove",
                                    "payload": {
                                      "groupId": "$form.browser.groupId",
                                      "emoteId": "$form.selected.id"
                                    }
                                  }
                                },
                                {
                                  "action_id": "command",
                                  "target": "tool",
                                  "input": {
                                    "action": "ui.dashboard"
                                  },
                                  "statePath": "dashboard"
                                }
                              ]
                            }
                          ],
                          "visibleWhen": [
                            {
                              "field": "selected.id",
                              "operator": "!=",
                              "value": ""
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "visibleWhen": [
                    {
                      "field": "browser.groupId",
                      "operator": "!=",
                      "value": ""
                    }
                  ]
                },
                {
                  "id": "emote-group-create-dialog",
                  "type": "section",
                  "props": {
                    "presentation": "dialog",
                    "title": "新建分组",
                    "width": 440
                  },
                  "bindings": [
                    {
                      "path": "groupDialog.open",
                      "source": "form",
                      "default": false
                    }
                  ],
                  "children": [
                    {
                      "id": "emote-group-name",
                      "type": "field",
                      "props": {
                        "label": "分组名称",
                        "placeholder": "输入分组名称",
                        "maxlength": 50
                      },
                      "bindings": [
                        {
                          "path": "group.name",
                          "source": "form",
                          "default": ""
                        }
                      ]
                    },
                    {
                      "id": "emote-group-dialog-actions",
                      "type": "row",
                      "props": {
                        "layout": "toolbar",
                        "justify": "flex-end",
                        "gap": "8px"
                      },
                      "children": [
                        {
                          "id": "emote-group-cancel-create",
                          "type": "button",
                          "props": {
                            "text": "取消"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.group_dialog",
                                "payload": {
                                  "open": false
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "emote-group-confirm-create",
                          "type": "button",
                          "props": {
                            "text": "创建分组",
                            "type": "primary",
                            "requiredFields": [
                              "group.name"
                            ],
                            "validationMessage": "请先输入分组名称"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "groups.create",
                                "payload": {
                                  "name": "$form.group.name"
                                }
                              }
                            },
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "ui.dashboard"
                              },
                              "statePath": "dashboard"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "emote-tab-settings",
              "type": "tab_item",
              "props": {
                "label": "AI 设置",
                "name": "settings"
              },
              "children": [
                {
                  "id": "emote-tab-settings-content",
                  "type": "stack",
                  "props": {
                    "gap": "24px",
                    "maxWidth": 560
                  },
                  "children": [
                    {
                      "id": "emote-settings-intro",
                      "type": "text",
                      "props": {
                        "text": "控制 AI 何时使用表情，以及发送频率。"
                      }
                    },
                    {
                      "id": "emote-settings-enabled",
                      "type": "switch",
                      "props": {
                        "activeText": "启用表情回复"
                      },
                      "bindings": [
                        {
                          "path": "settings.enabled",
                          "source": "form",
                          "default": true
                        }
                      ]
                    },
                    {
                      "id": "emote-settings-hour",
                      "type": "field",
                      "props": {
                        "label": "每小时最多发送",
                        "variant": "number"
                      },
                      "bindings": [
                        {
                          "path": "settings.maxPerHour",
                          "source": "form",
                          "default": 5
                        }
                      ]
                    },
                    {
                      "id": "emote-settings-cooldown",
                      "type": "field",
                      "props": {
                        "label": "同表情冷却分钟",
                        "variant": "number"
                      },
                      "bindings": [
                        {
                          "path": "settings.sameEmoteCooldownMinutes",
                          "source": "form",
                          "default": 30
                        }
                      ]
                    },
                    {
                      "id": "emote-settings-save",
                      "type": "button",
                      "props": {
                        "text": "保存设置",
                        "type": "primary"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "settings.save",
                            "payload": {
                              "enabled": "$form.settings.enabled",
                              "maxPerHour": "$form.settings.maxPerHour",
                              "sameEmoteCooldownMinutes": "$form.settings.sameEmoteCooldownMinutes"
                            }
                          },
                          "statePath": "settingsSaveResult"
                        },
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "ui.dashboard"
                          },
                          "statePath": "dashboard"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 200,
    "maxLayoutCount": 300,
    "maxNodeCount": 300,
    "maxDataFetchCount": 1,
    "maxActionCount": 32
  }
}
