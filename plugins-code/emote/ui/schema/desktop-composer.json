{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "发送表情（桌面端）",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "ui.composer"
        },
        "statePath": "composer"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "emote-composer-page",
      "type": "page",
      "children": [
        {
          "id": "emote-composer-groups",
          "type": "gallery",
          "props": {
            "variant": "groups",
            "imageField": "cover",
            "titleField": "name",
            "minItemWidth": 66,
            "emptyText": "暂无表情分组"
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "composer.groups"
            },
            {
              "path": "selectedId",
              "source": "form",
              "sourcePath": "groupId"
            }
          ],
          "actions": [
            {
              "action_id": "command",
              "target": "tool",
              "input": {
                "action": "ui.composer",
                "payload": {
                  "groupId": "$item.id"
                }
              },
              "statePath": "composer"
            }
          ]
        },
        {
          "id": "emote-composer-gallery",
          "type": "gallery",
          "props": {
            "variant": "stickers",
            "imageField": "thumbnailUrl",
            "titleField": "name",
            "subtitleField": "meaning",
            "minItemWidth": 58,
            "showTitle": false,
            "showSubtitle": false,
            "emptyText": "暂无可发送表情"
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "composer.emotes"
            }
          ],
          "actions": [
            {
              "action_id": "command",
              "target": "tool",
              "input": {
                "action": "emotes.send",
                "payload": {
                  "emoteId": "$item.id",
                  "conversationId": "$context.conversationId",
                  "characterId": "$context.characterId",
                  "channel": "$context.channel"
                }
              },
              "statePath": "sendResult"
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 100,
    "maxLayoutCount": 120,
    "maxNodeCount": 80,
    "maxDataFetchCount": 1,
    "maxActionCount": 8
  }
}
