{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "发送表情（桌面端）",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "ui.composer"
        },
        "statePath": "composer"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "emote-composer-page",
      "type": "page",
      "children": [
        {
          "id": "emote-composer-toolbar",
          "type": "row",
          "children": [
            {
              "id": "emote-composer-group",
              "type": "select",
              "props": {
                "placeholder": "全部分组",
                "clearable": true,
                "options": [
                  {
                    "label": "最近使用",
                    "value": "recent"
                  }
                ]
              },
              "bindings": [
                {
                  "path": "groupId",
                  "source": "form",
                  "default": ""
                },
                {
                  "path": "options",
                  "source": "state",
                  "sourcePath": "composer.groups"
                }
              ]
            },
            {
              "id": "emote-composer-refresh",
              "type": "button",
              "props": {
                "text": "刷新"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "ui.composer",
                    "payload": {
                      "groupId": "$form.groupId"
                    }
                  },
                  "statePath": "composer"
                }
              ]
            }
          ]
        },
        {
          "id": "emote-composer-gallery",
          "type": "gallery",
          "props": {
            "imageField": "thumbnailUrl",
            "titleField": "name",
            "subtitleField": "meaning",
            "minItemWidth": 104,
            "emptyText": "暂无可发送表情"
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "composer.emotes"
            }
          ],
          "actions": [
            {
              "action_id": "command",
              "target": "tool",
              "input": {
                "action": "emotes.send",
                "payload": {
                  "emoteId": "$item.id",
                  "conversationId": "$context.conversationId",
                  "characterId": "$context.characterId",
                  "channel": "$context.channel"
                }
              },
              "statePath": "sendResult"
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 100,
    "maxLayoutCount": 120,
    "maxNodeCount": 80,
    "maxDataFetchCount": 1,
    "maxActionCount": 8
  }
}
