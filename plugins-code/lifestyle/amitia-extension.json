      "reason": "读取插件自有生活状态。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.state.write",
      "reason": "保存插件自有生活状态。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "event.emit",
      "reason": "通知宿主和其他插件生活状态已变化。",
      "required": false,
      "scope": "extension"
    },
    {
      "name": "tool.invoke",
      "reason": "通过声明的生活工具执行界面操作。",
      "required": true,
