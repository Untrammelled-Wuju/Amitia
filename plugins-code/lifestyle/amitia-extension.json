{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia/lifestyle",
    "name": {
      "default": "生活系统"
    },
    "description": {
      "default": "管理角色生活场景、作息、工作、事件、日程和生活状态。"
    },
    "version": "1.0.12",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "companion",
      "lifestyle"
    ],
    "keywords": [
      "lifestyle",
      "schedule",
      "sleep",
      "work",
      "events"
    ],
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "lifestyle-runtime",
      "name": {
        "default": "生活系统运行时"
      },
      "description": {
        "default": "以插件自有状态管理生活规则、日程和状态。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "120s",
        "memoryBytes": 134217728,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "ui",
          "ui_provider"
        ],
        "maxContributions": 8,
        "maxTools": 2,
        "maxRoutes": 6,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "lifestyle-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "生活系统命令"
          },
          "description": {
            "default": "生活系统 UI 的统一控制入口。"
          },
          "spec": {
            "toolId": "com.amitia/lifestyle/command",
            "modelName": "lifestyle_command",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "characterId"
                  ],
                  "properties": {
                    "characterId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "medium",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "storage.state.read",
            "storage.state.write"
          ]
        },
        {
          "id": "lifestyle-context",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "生活上下文"
          },
          "description": {
            "default": "向宿主提供角色生活上下文。"
          },
          "spec": {
            "toolId": "com.amitia/lifestyle/context",
            "modelName": "lifestyle_context",
            "handlerName": "context",
            "inputSchema": {
              "type": "object",
              "properties": {
                "spaceId": {
                  "type": "string"
                },
                "characterId": {
                  "type": "string"
                },
                "conversationId": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "low",
            "sideEffect": "read_only",
            "internal": true,
            "metadata": {
              "amitia.context.provides": [
                "chat.realtime.schedule"
              ],
              "amitia.context.priority": 230,
              "amitia.context.key": "lifestyle"
            },
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "context"
            }
          },
          "requiredPermissions": [
            "storage.state.read"
          ]
        },
