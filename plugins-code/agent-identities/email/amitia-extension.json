{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia/agent-identity-email",
    "name": {
      "default": "Agent 邮箱身份"
    },
    "description": {
      "default": "为 Agent 提供独立邮箱身份、收件箱和发件能力。"
    },
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "agent-identities",
      "productivity"
    ],
    "keywords": [
      "email",
      "gmail",
      "microsoft",
      "inbox",
      "agent-identity"
    ],
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "email-identity-runtime",
      "name": {
        "default": "Agent 邮箱运行时"
      },
      "description": {
        "default": "管理 Agent 邮箱身份、收件箱和消息发送。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "120s",
        "memoryBytes": 268435456,
        "capabilities": {
          "network": true,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "host"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "services": {
        "provides": [
          {
            "serviceId": "agent.identity.email",
            "version": "1.0.0",
            "scopes": [
              "global"
            ],
            "placement": "device"
          }
        ],
        "requires": []
      },
      "dynamic": {
        "allowedAdapters": [
          "tool"
        ],
        "maxContributions": 1,
        "maxTools": 1,
        "maxRoutes": 0,
        "maxServices": 1,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "email-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "Agent 邮箱命令"
          },
          "description": {
            "default": "配置、读取和发送 Agent 邮箱消息。"
          },
          "spec": {
            "toolId": "com.amitia/agent-identity-email/command",
            "modelName": "agent_email_command",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "status",
                    "config",
                    "configure",
                    "enable",
                    "disable",
                    "execute"
                  ]
                },
                "config": {
                  "type": "object"
                },
                "credentialRef": {
                  "type": "string"
                },
                "input": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "medium",
            "sideEffect": "external",
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "storage.state.read",
            "storage.state.write",
            "secret.read",
            "service.network.request"
          ]
        }
      ],
      "placement": "device",
      "providedCapabilities": [
        {
          "id": "agent.identity.email",
          "version": "1.0.0"
        }
      ]
    }
  ],
  "permissions": [
    {
      "name": "storage.state.read",
      "reason": "读取邮箱身份配置。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.state.write",
      "reason": "保存邮箱身份配置。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "secret.read",
      "reason": "读取用户授权的 OAuth 或 SMTP 凭据。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "service.network.request",
      "reason": "连接邮箱 Provider。",
      "required": true,
      "scope": "extension"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
