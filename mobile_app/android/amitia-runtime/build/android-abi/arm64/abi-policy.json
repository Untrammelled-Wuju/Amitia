{
  "schemaVersion": 1,
  "policy": {
    "allowedAbis": ["arm64-v8a"],
    "required64BitAbi": "arm64-v8a",
    "requires64BitProcess": true,
    "forbiddenAbis": ["armeabi-v7a", "armeabi", "x86", "x86_64", "mips", "mips64", "riscv64"],
    "description": "Amitia Android Runtime restricts to arm64-v8a only. No 32-bit or non-ARM ABIs are supported."
  },
  "verification": {
    "layers": ["build", "archive", "runtime"],
    "enforcement": "strict",
    "failureMode": "refuse"
  }
}
