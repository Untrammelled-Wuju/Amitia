+int translate_process_vm_enter(Tracee *tracee, Tracee *target, bool writing)
+{
+	word_t local_iov_address = peek_reg(tracee, ORIGINAL, SYSARG_2);
+	word_t local_count = peek_reg(tracee, ORIGINAL, SYSARG_3);
+	word_t remote_iov_address = peek_reg(tracee, ORIGINAL, SYSARG_4);
+	word_t remote_count = peek_reg(tracee, ORIGINAL, SYSARG_5);
+	word_t flags = peek_reg(tracee, ORIGINAL, SYSARG_6);
+	size_t local_index = 0;
+	size_t remote_index = 0;
+	size_t local_offset = 0;
+	size_t remote_offset = 0;
+	ssize_t total = 0;
+
+	if (flags != 0)
+		return -EINVAL;
+	if (local_count > 1024 || remote_count > 1024)
+		return -EINVAL;
+
+	while (local_index < local_count && remote_index < remote_count) {
+		struct iovec local;
+		struct iovec remote;
+		char *buffer;
+		size_t local_remaining;
+		size_t remote_remaining;
+		size_t length;
+		int status;
+
+		status = read_data(tracee, &local, local_iov_address + local_index * sizeof(local), sizeof(local));
+		if (status < 0)
+			return status;
+		status = read_data(tracee, &remote, remote_iov_address + remote_index * sizeof(remote), sizeof(remote));
+		if (status < 0)
+			return status;
+
+		local_remaining = local.iov_len - local_offset;
+		remote_remaining = remote.iov_len - remote_offset;
+		length = local_remaining < remote_remaining ? local_remaining : remote_remaining;
+		if (length == 0) {
+			if (local_remaining == 0)
+				local_index++;
+			if (remote_remaining == 0)
+				remote_index++;
+			local_offset = 0;
+			remote_offset = 0;
+			continue;
+		}
+
+		buffer = malloc(length);
+		if (buffer == NULL)
+			return -ENOMEM;
+
+		if (writing) {
+			status = read_data(tracee, buffer, (word_t) local.iov_base + local_offset, length);
+			if (status == 0)
+				status = write_data(target, (word_t) remote.iov_base + remote_offset, buffer, length);
+		}
+		else {
+			status = read_data(target, buffer, (word_t) remote.iov_base + remote_offset, length);
+			if (status == 0)
+				status = write_data(tracee, (word_t) local.iov_base + local_offset, buffer, length);
+		}
+		free(buffer);
+		if (status < 0) {
+			if (total == 0)
+				return status;
+			break;
+		}
+
+		total += length;
+		local_offset += length;
+		remote_offset += length;
+		if (local_offset == local.iov_len) {
+			local_index++;
+			local_offset = 0;
+		}
+		if (remote_offset == remote.iov_len) {
+			remote_index++;
+			remote_offset = 0;
+		}
+	}
+
+	return total;
 }
 
