{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia/storage",
    "name": {
      "default": "存储维护"
    },
    "description": {
      "default": "清理聊天数据、优化数据库并管理完整设备备份与恢复。"
    },
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "system",
      "productivity"
    ],
    "keywords": [
      "storage",
      "backup",
      "cleanup"
    ],
    "metadata": {
      "system.defaultInstall": true,
      "system.defaultEnabled": true
    },
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos"
    ]
  },
  "modules": [
    {
      "id": "storage-runtime",
      "name": {
        "default": "存储维护运行时"
      },
      "description": {
        "default": "通过受控 Storage Host API 执行维护操作。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "10m",
        "memoryBytes": 67108864,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "ui",
          "ui_provider"
        ],
        "maxContributions": 8,
        "maxTools": 1,
        "maxRoutes": 1,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "storage-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "存储维护操作"
          },
          "description": {
            "default": "清理数据、优化数据库并管理完整备份。"
          },
          "spec": {
            "toolId": "com.amitia/storage/command",
            "modelName": "amitia_storage",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "characters",
                    "overview",
                    "stats",
                    "vacuum",
                    "cleanup_preview",
                    "cleanup_confirm",
                    "list_backups",
                    "create_backup",
                    "delete_backup",
                    "preview_restore",
                    "execute_restore",
                    "cancel_restore"
                  ]
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "high",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "character.read",
            "storage.cleanup",
            "storage.backup",
            "storage.restore"
          ]
        },
        {
          "id": "storage-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "存储维护"
          },
          "description": {
            "default": "聊天清理、数据库优化和完整备份恢复。"
          },
          "spec": {
            "contribution_id": "storage-page",
            "extension_id": "com.amitia/storage",
            "module_id": "storage-runtime",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "存储维护"
              },
              "description": {
                "default": "聊天清理、数据库优化和完整备份恢复。"
              },
              "icon": "delete"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/storage-ui/desktop/storage.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 247
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行存储维护"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/storage/command"
                },
                "risk_level": "high"
              }
            ],
            "integrity": {
              "definition_hash": "storage-page-v1"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "character.read",
            "storage.cleanup",
            "storage.backup",
            "storage.restore"
          ]
        },
        {
          "id": "storage-routes",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "存储维护路由"
          },
          "spec": {
            "providerId": "storage-routes",
            "capability": "route.registry",
            "mode": "replace",
            "priority": 247,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "declarative"
              },
              "electron_windows": {
                "type": "declarative"
              },
              "electron_macos": {
                "type": "declarative"
              },
              "electron_linux": {
                "type": "declarative"
              }
            },
            "metadata": {
              "routes": [
                {
                  "id": "storage",
                  "path": "/storage",
                  "providerId": "storage-page-provider",
                  "capability": "page.provider",
                  "title": "存储维护",
                  "priority": 247
                }
              ],
              "navigationItems": [
                {
                  "id": "storage",
                  "label": "存储维护",
                  "route": "/storage",
                  "icon": "delete",
                  "group": "settings",
                  "groupLabel": "设置",
                  "groupIcon": "extension",
                  "order": 170,
                  "mobile": false
                }
              ]
            }
          }
        },
        {
          "id": "storage-page-provider",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "存储维护页面 Provider"
          },
          "spec": {
            "providerId": "storage-page-provider",
            "capability": "page.provider",
            "mode": "replace",
            "priority": 247,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "schema_renderer",
                "contributionId": "storage-page"
              },
              "electron_windows": {
                "type": "schema_renderer",
                "contributionId": "storage-page"
              },
              "electron_macos": {
                "type": "schema_renderer",
                "contributionId": "storage-page"
              },
              "electron_linux": {
                "type": "schema_renderer",
                "contributionId": "storage-page"
              }
            },
            "metadata": {
              "routes": [
                "/storage"
              ]
            }
          }
        }
      ],
      "placement": "device",
      "deviceRequirements": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "通过插件工具执行存储维护。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "character.read",
      "reason": "选择聊天清理所属角色。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.cleanup",
      "reason": "预览并执行聊天清理和数据库优化。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.backup",
      "reason": "创建、列出和删除完整设备备份。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "storage.restore",
      "reason": "预检并执行完整数据恢复。",
      "required": true,
      "scope": "extension"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "scopes": [
      "device"
    ],
    "backup": false,
    "export": false,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
