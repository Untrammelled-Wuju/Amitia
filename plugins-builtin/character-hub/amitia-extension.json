      "default": "角色中心"
    },
    "description": {
      "default": "通过统一 UI Provider 提供角色管理、团队、世界书与画像入口。"
    },
    "version": "1.1.0",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "character",
      "navigation",
      "system"
    ],
    "keywords": [
      "character",
      "team",
      "worldbook",
      "profile"
    ],
    "metadata": {
      "system.defaultInstall": true,
      "system.defaultEnabled": true
    },
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "web",
      "windows",
      "linux",
      "macos"
    ]
  },
