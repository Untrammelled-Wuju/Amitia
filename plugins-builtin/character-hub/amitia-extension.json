      "id": "character-hub-runtime",
      "name": {
        "default": "角色中心运行时"
      },
      "description": {
        "default": "注册角色中心页面、路由和导航贡献。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "10s",
        "memoryBytes": 33554432,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "ui",
          "ui_provider"
        ],
        "maxContributions": 9,
        "maxTools": 0,
        "maxRoutes": 7,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "character-hub-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "角色中心"
          },
          "description": {
            "default": "查看角色、团队、世界书与画像。"
          },
          "spec": {
            "contribution_id": "character-hub-page",
            "extension_id": "com.amitia/character-hub",
            "module_id": "character-hub-runtime",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "角色"
              },
              "description": {
                "default": "管理角色、画像、团队与世界观设定。"
              },
              "icon": "character"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/character-hub-ui/desktop/character-hub.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 230
            },
            "visibility": {
              "platforms": [
                "web",
