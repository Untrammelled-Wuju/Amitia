                {
                  "id": "character-teams",
                  "section": "character",
                  "route": "/characters/teams",
                  "label": "团队",
                  "order": 20
                },
                {
                  "id": "character-worldbook",
                  "section": "character",
                  "route": "/world-book",
                  "label": "世界书",
                  "order": 30
