{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "角色",
  "actions": [],
  "children": [
    {
      "id": "character-hub-page",
      "type": "page",
      "children": [
        {
          "id": "character-hub-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "角色中心由插件提供",
            "description": "角色、团队、世界书和画像继续使用核心身份、归属与权限边界，入口可以随插件启停。",
            "closable": false
          }
        },
        {
          "id": "character-hub-grid",
          "type": "grid",
          "props": {
            "columnsTemplate": "repeat(auto-fill, minmax(240px, 1fr))",
            "gap": "12px"
          },
          "children": [
            {
              "id": "character-hub-manage-card",
              "type": "card",
              "props": {
                "header": "角色管理"
              },
              "children": [
                {
                  "id": "character-hub-manage-copy",
                  "type": "text",
                  "props": {
                    "text": "管理角色身份、模型、技能和人格配置。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "character-hub-manage-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开角色管理",
                    "href": "/character",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "character-hub-teams-card",
              "type": "card",
              "props": {
                "header": "角色团队"
              },
              "children": [
                {
                  "id": "character-hub-teams-copy",
                  "type": "text",
                  "props": {
                    "text": "配置团队成员、共享上下文和任务协作。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "character-hub-teams-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开团队",
                    "href": "/characters/teams",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "character-hub-worldbook-card",
              "type": "card",
              "props": {
                "header": "世界书"
              },
              "children": [
                {
                  "id": "character-hub-worldbook-copy",
                  "type": "text",
                  "props": {
                    "text": "管理角色与世界观相关的结构化设定。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "character-hub-worldbook-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开世界书",
                    "href": "/world-book",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "character-hub-profiles-card",
              "type": "card",
              "props": {
                "header": "用户画像"
              },
              "children": [
                {
                  "id": "character-hub-profiles-copy",
                  "type": "text",
                  "props": {
                    "text": "维护角色理解和个性化回应的用户画像。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "character-hub-profiles-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开用户画像",
                    "href": "/profiles",
                    "target": "_self"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 60,
    "maxLayoutCount": 50,
    "maxNodeCount": 50,
    "maxDataFetchCount": 0,
    "maxActionCount": 0
  }
}
