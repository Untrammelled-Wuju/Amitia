{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.builtin.active-task",
    "name": {
      "default": "主动任务"
    },
    "description": {
      "default": "通过统一 Host API 管理主动任务、时间提醒、队列和执行历史。"
    },
    "version": "1.2.1",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "productivity",
      "automation"
    ],
    "keywords": [
      "reminder",
      "schedule",
      "proactive"
    ],
    "metadata": {
      "system.defaultInstall": true,
      "system.defaultEnabled": true
    },
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos",
      "android",
      "ios"
    ]
  },
  "modules": [
    {
      "id": "active-task-runtime",
      "name": {
        "default": "主动任务运行时"
      },
      "description": {
        "default": "调用宿主主动任务与提醒 Host API。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "2m",
        "memoryBytes": 67108864,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "ui",
          "ui_provider"
        ],
        "maxContributions": 6,
        "maxTools": 1,
        "maxRoutes": 3,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "active-task-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "主动任务操作"
          },
          "description": {
            "default": "管理主动任务与定时提醒。"
          },
          "spec": {
            "toolId": "com.amitia.builtin.active-task/command",
            "modelName": "amitia_active_tasks",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "characters",
                    "overview",
                    "list",
                    "status",
                    "queue",
                    "capabilities",
                    "history",
                    "create",
                    "update",
                    "pause",
                    "resume",
                    "cancel",
                    "execute",
                    "preview",
                    "navigate"
                  ]
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "high",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "character.read",
            "reminder.read",
            "reminder.create",
            "reminder.manage",
            "reminder.execute",
            "proactive_task.read",
            "proactive_task.create",
            "proactive_task.manage",
            "proactive_task.execute",
            "ui.navigate"
          ]
        },
        {
          "id": "active-task-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "主动任务"
          },
          "description": {
            "default": "管理主动任务、定时提醒、队列和执行历史。"
          },
          "spec": {
            "contribution_id": "active-task-page",
            "extension_id": "com.amitia.builtin.active-task",
            "module_id": "active-task-runtime",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "主动任务"
              },
              "description": {
                "default": "管理主动任务、定时提醒、队列和执行历史。"
              },
              "icon": "alarm-clock"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/active-task-ui/desktop/active-tasks.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 248
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos",
                "android",
                "ios"
              ]
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行主动任务操作"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia.builtin.active-task/command"
                },
                "risk_level": "high"
              }
            ],
            "integrity": {
              "definition_hash": "active-task-page-v1"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "character.read",
            "reminder.read",
            "reminder.create",
            "reminder.manage",
            "reminder.execute",
            "proactive_task.read",
            "proactive_task.create",
            "proactive_task.manage",
            "proactive_task.execute"
          ]
        },
        {
          "id": "continuity-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "持续事项"
          },
          "spec": {
            "contribution_id": "continuity-page",
            "extension_id": "com.amitia.builtin.active-task",
            "module_id": "active-task-runtime",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "持续事项"
              },
              "description": {
                "default": "查看长期目标、当前状态、等待条件和执行范围。"
              },
              "icon": "continuity"
            },
            "entry": {
              "type": "host_native",
              "path": "builtin://com.amitia.builtin.active-task/continuity",
              "runtime_id": "host.tasks.continuity",
              "content_hash": "builtin"
            },
            "sandbox": {
              "type": "host_native"
            },
            "ordering": {
              "priority": 247
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos",
                "android",
                "ios"
              ]
            },
            "actions": [],
            "integrity": {
              "definition_hash": "continuity-page-v1"
            }
          }
        },
        {
          "id": "active-task-routes",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "主动任务路由"
          },
          "spec": {
            "providerId": "active-task-routes",
            "capability": "route.registry",
            "mode": "replace",
            "priority": 248,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "declarative"
              },
              "electron_windows": {
                "type": "declarative"
              },
              "electron_macos": {
                "type": "declarative"
              },
              "electron_linux": {
                "type": "declarative"
              },
              "mobile": {
                "type": "declarative"
              }
            },
            "metadata": {
              "routes": [
                {
                  "id": "active-task",
                  "path": "/reminders",
                  "providerId": "active-task-page-provider",
                  "capability": "page.provider",
                  "title": "主动任务",
                  "priority": 248
                },
                {
                  "id": "continuity",
                  "path": "/continuity",
                  "providerId": "continuity-page-provider",
                  "capability": "page.provider",
                  "title": "持续事项",
                  "priority": 247
                },
                {
                  "id": "continuity-detail",
                  "path": "/continuity/:id",
                  "providerId": "continuity-page-provider",
                  "capability": "page.provider",
                  "title": "持续事项",
                  "priority": 246
                }
              ],
              "sectionEntries": [
                {
                  "id": "active-task",
                  "section": "tasks",
                  "route": "/reminders",
                  "label": "主动任务",
                  "order": 10
                },
                {
                  "id": "continuity",
                  "section": "tasks",
                  "route": "/continuity",
                  "label": "持续事项",
                  "order": 20
                }
              ],
              "navigationItems": [
                {
                  "id": "active-task",
                  "label": "任务",
                  "route": "/reminders",
                  "icon": "calendar",
                  "group": "tasks",
                  "groupLabel": "任务",
                  "groupIcon": "calendar",
                  "order": 69,
                  "mobile": false
                }
              ]
            }
          }
        },
        {
          "id": "active-task-page-provider",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "主动任务页面 Provider"
          },
          "spec": {
            "providerId": "active-task-page-provider",
            "capability": "page.provider",
            "mode": "replace",
            "priority": 248,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "schema_renderer",
                "contributionId": "active-task-page"
              },
              "electron_windows": {
                "type": "schema_renderer",
                "contributionId": "active-task-page"
              },
              "electron_macos": {
                "type": "schema_renderer",
                "contributionId": "active-task-page"
              },
              "electron_linux": {
                "type": "schema_renderer",
                "contributionId": "active-task-page"
              },
              "mobile": {
                "type": "schema_renderer",
                "contributionId": "active-task-page"
              }
            },
            "metadata": {
              "routes": [
                "/reminders"
              ]
            }
          }
        },
        {
          "id": "continuity-page-provider",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "持续事项页面 Provider"
          },
          "spec": {
            "providerId": "continuity-page-provider",
            "capability": "page.provider",
            "mode": "replace",
            "priority": 247,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "schema_renderer",
                "contributionId": "continuity-page"
              },
              "electron_windows": {
                "type": "schema_renderer",
                "contributionId": "continuity-page"
              },
              "electron_macos": {
                "type": "schema_renderer",
                "contributionId": "continuity-page"
              },
              "electron_linux": {
                "type": "schema_renderer",
                "contributionId": "continuity-page"
              },
              "mobile": {
                "type": "schema_renderer",
                "contributionId": "continuity-page"
              }
            },
            "metadata": {
              "routes": [
                "/continuity",
                "/continuity/:id"
              ]
            }
          }
        }
      ],
      "placement": "device",
      "deviceRequirements": {
        "platforms": [
          "windows",
          "linux",
          "macos",
          "android",
          "ios"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "通过插件工具管理提醒任务。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "character.read",
      "reason": "列出任务所属角色。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "reminder.read",
      "reason": "读取定时提醒、队列和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "reminder.create",
      "reason": "创建定时提醒。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "reminder.manage",
      "reason": "更新、暂停、恢复或取消定时提醒。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "reminder.execute",
      "reason": "立即执行定时提醒。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.read",
      "reason": "读取主动任务、队列和历史。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.create",
      "reason": "创建主动任务。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.manage",
      "reason": "更新、暂停、恢复或取消主动任务。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "proactive_task.execute",
      "reason": "立即执行主动任务。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "ui.navigate",
      "reason": "跳转到持续事项页面。",
      "required": true,
      "scope": "session"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "scopes": [
      "device"
    ],
    "backup": false,
    "export": false,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
