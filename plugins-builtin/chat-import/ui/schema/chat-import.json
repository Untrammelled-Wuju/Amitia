{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "聊天导入",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "characters",
          "payload": {}
        },
        "statePath": "characters"
      },
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "batches",
          "payload": {}
        },
        "statePath": "batches"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    },
    {
      "actionId": "set-editable-items",
      "target": "local"
    },
    {
      "actionId": "set-selected-batch",
      "target": "local"
    }
  ],
  "children": [
    {
      "id": "chat-import-page",
      "type": "page",
      "children": [
        {
          "id": "chat-import-warning",
          "type": "alert",
          "props": {
            "type": "warning",
            "title": "导入内容可能包含隐私信息",
            "description": "请先移除验证码、密码、银行卡号和身份证号。导入前会创建可回滚的暂存批次。",
            "closable": false
          }
        },
        {
          "id": "chat-import-target",
          "type": "section",
          "props": {
            "title": "目标角色"
          },
          "children": [
            {
              "id": "chat-import-character",
              "type": "select",
              "props": {
                "label": "导入到哪个角色",
                "placeholder": "选择目标角色"
              },
              "bindings": [
                {
                  "path": "characterId",
                  "source": "form",
                  "default": ""
                },
                {
                  "path": "options",
                  "source": "state",
                  "sourcePath": "characters"
                }
              ]
            }
          ]
        },
        {
          "id": "chat-import-input",
          "type": "section",
          "props": {
            "title": "粘贴聊天记录"
          },
          "children": [
            {
              "id": "chat-import-raw-text",
              "type": "field",
              "props": {
                "label": "聊天内容",
                "variant": "textarea",
                "rows": 8,
                "placeholder": "支持标准、时间戳和多行聊天格式"
              },
              "bindings": [
                {
                  "path": "rawText",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-import-title",
              "type": "field",
              "props": {
                "label": "批次标题",
                "placeholder": "可选"
              },
              "bindings": [
                {
                  "path": "title",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-import-format",
              "type": "select",
              "props": {
                "label": "解析格式",
                "options": [
                  {
                    "label": "自动",
                    "value": "auto"
                  },
                  {
                    "label": "标准",
                    "value": "standard"
                  },
                  {
                    "label": "时间戳",
                    "value": "timestamp"
                  },
                  {
                    "label": "多行",
                    "value": "multiline"
                  }
                ]
              },
              "bindings": [
                {
                  "path": "format",
                  "source": "form",
                  "default": "auto"
                }
              ]
            },
            {
              "id": "chat-import-default-role",
              "type": "select",
              "props": {
                "label": "默认角色",
                "options": [
                  {
                    "label": "用户",
                    "value": "user"
                  },
                  {
                    "label": "AI",
                    "value": "assistant"
                  },
                  {
                    "label": "系统",
                    "value": "system"
                  }
                ]
              },
              "bindings": [
                {
                  "path": "defaultRole",
                  "source": "form",
                  "default": "user"
                }
              ]
            },
            {
              "id": "chat-import-user-speakers",
              "type": "field",
              "props": {
                "label": "用户发言者",
                "placeholder": "多个名称用逗号分隔"
              },
              "bindings": [
                {
                  "path": "userSpeakerNames",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-import-assistant-speakers",
              "type": "field",
              "props": {
                "label": "AI 发言者",
                "placeholder": "多个名称用逗号分隔"
              },
              "bindings": [
                {
                  "path": "assistantSpeakerNames",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-import-parse",
              "type": "button",
              "props": {
                "text": "解析聊天记录",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "parse",
                    "payload": {
                      "rawText": "$form.rawText",
                      "title": "$form.title",
                      "format": "$form.format",
                      "defaultRole": "$form.defaultRole",
                      "userSpeakerNames": "$form.userSpeakerNames",
                      "assistantSpeakerNames": "$form.assistantSpeakerNames"
                    }
                  },
                  "statePath": "parse",
                  "followUpActions": [
                    {
                      "action_id": "set-editable-items",
                      "target": "local",
                      "formPath": "editableItems",
                      "input": "$context.parse.items"
                    }
                  ]
                }
              ]
            },
            {
              "id": "chat-import-file",
              "type": "file_picker",
              "props": {
                "text": "上传 .txt / .md",
                "accept": ".txt,.md,text/plain,text/markdown",
                "hint": "文件内容会先进入解析预览，确认后才写入导入批次"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "parse_file",
                    "payload": {
                      "title": "$form.title",
                      "format": "$form.format",
                      "defaultRole": "$form.defaultRole",
                      "userSpeakerNames": "$form.userSpeakerNames",
                      "assistantSpeakerNames": "$form.assistantSpeakerNames"
                    }
                  },
                  "statePath": "parse",
                  "followUpActions": [
                    {
                      "action_id": "set-editable-items",
                      "target": "local",
                      "formPath": "editableItems",
                      "input": "$context.parse.items"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "chat-import-preview",
          "type": "section",
          "props": {
            "title": "预览与编辑"
          },
          "children": [
            {
              "id": "chat-import-detected-format",
              "type": "key_value",
              "props": {
                "columns": 1
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "parse"
                }
              ]
            },
            {
              "id": "chat-import-editable-items",
              "type": "editable_table",
              "props": {
                "bordered": true,
                "columns": [
                  {
                    "prop": "speaker",
                    "label": "发言者",
                    "width": 110
                  },
                  {
                    "prop": "role",
                    "label": "角色",
                    "width": 100,
                    "type": "select",
                    "options": [
                      {
                        "label": "用户",
                        "value": "user"
                      },
                      {
                        "label": "AI",
                        "value": "assistant"
                      },
                      {
                        "label": "系统",
                        "value": "system"
                      }
                    ]
                  },
                  {
                    "prop": "content",
                    "label": "内容"
                  },
                  {
                    "prop": "timestamp",
                    "label": "时间",
                    "width": 120
                  }
                ]
              },
              "bindings": [
                {
                  "path": "editableItems",
                  "source": "form",
                  "default": []
                }
              ]
            },
            {
              "id": "chat-import-confirm",
              "type": "button",
              "props": {
                "text": "确认导入并创建会话",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "confirm",
                    "payload": {
                      "characterId": "$form.characterId",
                      "title": "$form.title",
                      "defaultRole": "$form.defaultRole",
                      "detectedFormat": "$context.parse.detectedFormat",
                      "items": "$form.editableItems"
                    }
                  },
                  "confirmation": "确认导入当前消息并创建新的设备会话？",
                  "statePath": "importResult",
                  "followUpActions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "promote",
                        "payload": {
                          "batchId": "$context.importResult.batchId",
                          "roleId": "$form.characterId"
                        }
                      },
                      "statePath": "promoted"
                    },
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "batches",
                        "payload": {}
                      },
                      "statePath": "batches"
                    }
                  ]
                }
              ]
            },
            {
              "id": "chat-import-result",
              "type": "key_value",
              "props": {
                "title": "导入结果",
                "columns": 1
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "promoted"
                }
              ]
            }
          ]
        },
        {
          "id": "chat-import-history",
          "type": "section",
          "props": {
            "title": "导入批次"
          },
          "children": [
            {
              "id": "chat-import-refresh-batches",
              "type": "button",
              "props": {
                "text": "刷新批次"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "batches",
                    "payload": {}
                  },
                  "statePath": "batches"
                }
              ]
            },
            {
              "id": "chat-import-batch-list",
              "type": "gallery",
              "props": {
                "variant": "cards",
                "titleField": "title",
                "subtitleField": "status",
                "summaryField": "summary",
                "minItemWidth": 280,
                "emptyText": "暂无导入批次",
                "showSubtitle": true,
                "showCount": false,
                "itemActions": [
                  {
                    "id": "view",
                    "action_id": "command",
                    "label": "查看",
                    "type": "primary",
                    "plain": true,
                    "target": "tool",
                    "input": {
                      "action": "batch_detail",
                      "payload": {
                        "batchId": "$item.id"
                      }
                    },
                    "statePath": "batchDetail",
                    "followUpActions": [
                      {
                        "action_id": "set-selected-batch",
                        "target": "local",
                        "formPath": "selectedBatchId",
                        "input": "$item.id"
                      }
                    ]
                  },
                  {
                    "id": "promote",
                    "action_id": "command",
                    "label": "加入设备聊天",
                    "target": "tool",
                    "visibleWhen": [
                      {
                        "field": "status",
                        "operator": "!=",
                        "value": "promoted"
                      }
                    ],
                    "input": {
                      "action": "promote",
                      "payload": {
                        "batchId": "$item.id",
                        "roleId": "$item.roleId"
                      }
                    },
                    "statePath": "promoted"
                  },
                  {
                    "id": "delete",
                    "action_id": "command",
                    "label": "删除",
                    "type": "danger",
                    "plain": true,
                    "target": "tool",
                    "confirmation": "确认删除该导入批次？",
                    "input": {
                      "action": "delete_batch",
                      "payload": {
                        "batchId": "$item.id"
                      }
                    },
                    "statePath": "batchAction",
                    "followUpActions": [
                      {
                        "action_id": "command",
                        "target": "tool",
                        "input": {
                          "action": "batches",
                          "payload": {}
                        },
                        "statePath": "batches"
                      }
                    ]
                  }
                ]
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "batches.items"
                }
              ]
            },
            {
              "id": "chat-import-selected-batch",
              "type": "field",
              "props": {
                "label": "当前批次 ID",
                "disabled": true
              },
              "bindings": [
                {
                  "path": "selectedBatchId",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-import-summary-actions",
              "type": "button_group",
              "children": [
                {
                  "id": "chat-import-generate-summary",
                  "type": "button",
                  "props": {
                    "text": "生成批次摘要",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "generate_summary",
                        "payload": {
                          "batchId": "$form.selectedBatchId"
                        }
                      },
                      "statePath": "generatedSummary"
                    }
                  ]
                },
                {
                  "id": "chat-import-read-summary",
                  "type": "button",
                  "props": {
                    "text": "读取批次摘要"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "batch_summary",
                        "payload": {
                          "batchId": "$form.selectedBatchId"
                        }
                      },
                      "statePath": "batchSummary"
                    }
                  ]
                }
              ]
            },
            {
              "id": "chat-import-generated-summary",
              "type": "key_value",
              "props": {
                "title": "批次摘要",
                "columns": 1
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "batchSummary.summary"
                }
              ]
            },
            {
              "id": "chat-import-batch-detail",
              "type": "table",
              "props": {
                "title": "批次详情",
                "maxHeight": 360,
                "columns": [
                  {
                    "prop": "lineNo",
                    "label": "#",
                    "width": 60
                  },
                  {
                    "prop": "speaker",
                    "label": "发言者",
                    "width": 110
                  },
                  {
                    "prop": "role",
                    "label": "角色",
                    "width": 100
                  },
                  {
                    "prop": "content",
                    "label": "内容"
                  }
                ]
              },
              "bindings": [
                {
                  "path": "data",
                  "source": "state",
                  "sourcePath": "batchDetail.items"
                }
              ]
            },
            {
              "id": "chat-import-open-promoted",
              "type": "button",
              "props": {
                "text": "查看归档对话"
              },
              "visibleWhen": [
                {
                  "field": "promoted.conversationId",
                  "operator": "not_null"
                }
              ],
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "navigate",
                    "payload": {
                      "route": "/logs"
                    }
                  },
                  "statePath": "navigation"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 180,
    "maxLayoutCount": 240,
    "maxNodeCount": 240,
    "maxDataFetchCount": 2,
    "maxActionCount": 24
  }
}
