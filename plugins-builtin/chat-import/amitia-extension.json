      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "2m",
        "memoryBytes": 67108864,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "ui",
          "ui_provider"
        ],
        "maxContributions": 6,
        "maxTools": 1,
        "maxRoutes": 2,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "chat-import-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "聊天导入操作"
          },
          "description": {
            "default": "解析聊天记录、管理导入批次并晋升设备会话。"
          },
          "spec": {
            "toolId": "com.amitia/chat-import/command",
            "modelName": "amitia_chat_import",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "characters",
                    "parse",
                    "parse_file",
                    "batches",
                    "batch_detail",
                    "batch_summary",
                    "generate_summary",
                    "delete_batch",
                    "confirm",
                    "promote",
                    "navigate"
                  ]
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "high",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "character.read",
            "conversation.import",
            "ui.navigate"
          ]
