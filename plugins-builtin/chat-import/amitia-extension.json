  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "通过插件工具执行聊天导入。",
      "required": true,
      "scope": "session"
    },
    {
      "name": "character.read",
      "reason": "列出可用于导入的目标角色。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "conversation.import",
      "reason": "解析、保存导入批次并晋升为设备会话。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "ui.navigate",
      "reason": "导入完成后跳转到目标会话或归档页面。",
      "required": true,
      "scope": "extension"
    }
