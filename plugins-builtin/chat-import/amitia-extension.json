{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia/chat-import",
    "name": {
      "default": "聊天导入"
    },
    "description": {
      "default": "解析聊天记录、编辑消息、管理导入批次并晋升为设备会话。"
    },
    "version": "1.1.1",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "productivity",
      "character"
    ],
    "keywords": [
      "import",
      "chat",
      "conversation"
    ],
    "metadata": {
      "system.defaultInstall": true,
      "system.defaultEnabled": true
    },
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
