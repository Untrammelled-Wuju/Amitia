            "ordering": {
              "priority": 248
            },
            "visibility": {
              "platforms": [
                "android",
                "ios"
              ]
            },
            "actions": [],
            "integrity": {
              "definition_hash": "chat-import-mobile-page-v1"
            }
          }
        },
        {
