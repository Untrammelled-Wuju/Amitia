{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "长期运行维护",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "maintenance.overview"
        },
        "statePath": "maintenanceStatus"
      },
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "maintenance.config"
        },
        "statePath": "maintenanceConfig"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "long-running-page",
      "type": "page",
      "children": [
        {
          "id": "long-running-toolbar",
          "type": "row",
          "props": {
            "justify": "space-between",
            "align": "center",
            "layout": "toolbar"
          },
          "children": [
            {
              "id": "long-running-title",
              "type": "text",
              "props": {
                "text": "长期运行维护",
                "variant": "title"
              }
            },
            {
              "id": "long-running-refresh-all",
              "type": "button",
              "props": {
                "text": "刷新状态",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "maintenance.overview"
                  },
                  "statePath": "maintenanceStatus"
                },
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "maintenance.config"
                  },
                  "statePath": "maintenanceConfig"
                }
              ]
            }
          ]
        },
        {
          "id": "long-running-status-card",
          "type": "card",
          "props": {
            "title": "任务执行状态"
          },
          "children": [
            {
              "id": "long-running-status",
              "type": "key_value",
              "props": {
                "columns": 2,
                "bordered": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "maintenanceStatus"
                }
              ]
            },
            {
              "id": "long-running-tasks",
              "type": "table",
              "props": {
                "columns": [
                  { "prop": "id", "label": "任务 ID" },
                  { "prop": "title", "label": "标题" },
                  { "prop": "status", "label": "状态" },
                  { "prop": "placement", "label": "执行位置" },
                  { "prop": "updatedAt", "label": "更新时间" }
                ]
              },
              "bindings": [
                {
                  "path": "data",
                  "source": "state",
                  "sourcePath": "maintenanceStatus.tasks"
                }
              ]
            },
            {
              "id": "long-running-modules",
              "type": "table",
              "props": {
                "columns": [
                  { "prop": "name", "label": "模块" },
                  { "prop": "healthy", "label": "健康" },
                  { "prop": "message", "label": "详情" }
                ]
              },
              "bindings": [
                {
                  "path": "data",
                  "source": "state",
                  "sourcePath": "maintenanceStatus.modules"
                }
              ]
            }
          ]
        },
        {
          "id": "long-running-config-card",
          "type": "card",
          "props": {
            "title": "执行器配置"
          },
          "children": [
            {
              "id": "long-running-config-current",
              "type": "key_value",
              "props": {
                "columns": 2,
                "bordered": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "maintenanceConfig"
                }
              ]
            },
            {
              "id": "long-running-max-tasks",
              "type": "field",
              "props": {
                "label": "最大并发任务数",
                "type": "number",
                "min": 1,
                "max": 20
              },
              "bindings": [
                {
                  "path": "maxTasks",
                  "source": "form",
                  "default": 4
                }
              ]
            },
            {
              "id": "long-running-timeout-disabled",
              "type": "switch",
              "props": {
                "label": "禁用任务超时"
              },
              "bindings": [
                {
                  "path": "timeoutDisabled",
                  "source": "form",
                  "default": false
                }
              ]
            },
            {
              "id": "long-running-timeout-seconds",
              "type": "field",
              "props": {
                "label": "超时秒数",
                "type": "number",
                "min": 30,
                "max": 1800,
                "step": 30
              },
              "bindings": [
                {
                  "path": "timeoutSeconds",
                  "source": "form",
                  "default": 90
                }
              ]
            },
            {
              "id": "long-running-save-config",
              "type": "button",
              "props": {
                "text": "保存配置",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "maintenance.update",
                    "payload": {
                      "maxTasks": "$form.maxTasks",
                      "timeout": {
                        "disabled": "$form.timeoutDisabled",
                        "seconds": "$form.timeoutSeconds"
                      },
                      "expectedRevision": "$state.maintenanceConfig.revision",
                      "expectedTimeoutRevision": "$state.maintenanceConfig.timeoutRevision"
                    }
                  },
                  "statePath": "maintenanceConfig",
                  "successMessage": "执行器配置已保存"
                }
              ]
            }
          ]
        },
        {
          "id": "long-running-actions-card",
          "type": "card",
          "props": {
            "title": "维护动作"
          },
          "children": [
            {
              "id": "long-running-actions",
              "type": "button_group",
              "children": [
                {
                  "id": "long-running-cleanup",
                  "type": "button",
                  "props": {
                    "text": "清理临时文件",
                    "type": "warning"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "maintenance.cleanup-temp"
                      },
                      "statePath": "lastMaintenance"
                    }
                  ]
                },
                {
                  "id": "long-running-rotate",
                  "type": "button",
                  "props": {
                    "text": "轮转日志",
                    "type": "warning"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "maintenance.rotate-logs"
                      },
                      "statePath": "lastMaintenance"
                    }
                  ]
                },
                {
                  "id": "long-running-db",
                  "type": "button",
                  "props": {
                    "text": "数据库完整性检查",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "maintenance.check-db"
                      },
                      "statePath": "lastMaintenance"
                    }
                  ]
                }
              ]
            },
            {
              "id": "long-running-last-result",
              "type": "key_value",
              "props": {
                "title": "最近操作结果",
                "columns": 2,
                "bordered": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "lastMaintenance"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
