{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "BDI 决策可视化",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "snapshot"
        },
        "statePath": "snapshot"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "decision-viz-page",
      "type": "page",
      "children": [
        {
          "id": "decision-viz-toolbar",
          "type": "row",
          "props": {
            "justify": "space-between",
            "align": "center",
            "layout": "toolbar"
          },
          "children": [
            {
              "id": "decision-viz-title",
              "type": "text",
              "props": {
                "text": "BDI 决策可视化",
                "variant": "title"
              }
            },
            {
              "id": "decision-viz-refresh",
              "type": "button",
              "props": {
                "text": "刷新",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "snapshot"
                  },
                  "statePath": "snapshot"
                }
              ]
            }
          ]
        },
        {
          "id": "decision-viz-status",
          "type": "alert",
          "props": {
            "title": "当前没有可展示的 BehaviorPlan 或 ExpressionPlan",
            "type": "info",
            "closable": false
          },
          "visibleWhen": [
            {
              "field": "snapshot.behaviorPlan",
              "operator": "is_null"
            }
          ]
        },
        {
          "id": "decision-viz-behavior-card",
          "type": "card",
          "props": {
            "title": "BehaviorPlan — 行为计划"
          },
          "children": [
            {
              "id": "decision-viz-behavior",
              "type": "key_value",
              "props": {
                "columns": 2,
                "bordered": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "snapshot.behaviorPlan"
                }
              ]
            }
          ]
        },
        {
          "id": "decision-viz-expression-card",
          "type": "card",
          "props": {
            "title": "ExpressionPlan — 表达计划"
          },
          "children": [
            {
              "id": "decision-viz-expression",
              "type": "key_value",
              "props": {
                "columns": 2,
                "bordered": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "snapshot.expressionPlan"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
