  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 80,
    "maxLayoutCount": 100,
    "maxNodeCount": 100,
    "maxDataFetchCount": 0,
    "maxActionCount": 0
  }
}
