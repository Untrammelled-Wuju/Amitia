{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "内核工具",
  "actions": [],
  "children": [
    {
      "id": "kernel-hub-page",
      "type": "page",
      "children": [
        {
          "id": "kernel-hub-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "内核工具入口由插件提供",
            "description": "恢复、权限、进程监管和插件协议仍属于核心；这些管理和诊断入口可以随插件启停。",
            "closable": false
          }
        },
        {
          "id": "kernel-hub-grid",
          "type": "grid",
          "props": {
            "columnsTemplate": "repeat(auto-fill, minmax(240px, 1fr))",
            "gap": "12px"
          },
          "children": [
            {
              "id": "kernel-hub-packages",
              "type": "card",
              "props": {
                "header": "扩展包"
              },
              "children": [
                {
                  "id": "kernel-hub-packages-copy",
                  "type": "text",
                  "props": {
                    "text": "管理安装、版本、完整性、权限与回滚。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "kernel-hub-packages-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开扩展包",
                    "href": "/extensions/packages",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "kernel-hub-tasks",
              "type": "card",
              "props": {
                "header": "任务运行时"
              },
              "children": [
                {
                  "id": "kernel-hub-tasks-copy",
                  "type": "text",
                  "props": {
                    "text": "查看任务运行、审批、证据和恢复状态。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "kernel-hub-tasks-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开任务运行时",
                    "href": "/kernel/tasks",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "kernel-hub-events",
              "type": "card",
              "props": {
                "header": "事件中心"
              },
              "children": [
                {
                  "id": "kernel-hub-events-copy",
                  "type": "text",
                  "props": {
                    "text": "检查事件发布、订阅、生成和隔离状态。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "kernel-hub-events-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开事件中心",
                    "href": "/kernel/events",
                    "target": "_self"
