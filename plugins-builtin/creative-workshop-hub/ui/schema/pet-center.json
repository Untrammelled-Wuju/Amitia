{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "桌宠中心",
  "actions": [],
  "children": [
    {
      "id": "creative-workshop-pet-page",
      "type": "page",
      "children": [
        {
          "id": "creative-workshop-pet-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "桌宠中心由插件提供",
            "description": "桌宠安装、运行时监督、资源完整性和恢复仍由核心负责。",
            "closable": false
          }
        },
        {
          "id": "creative-workshop-pet-grid",
          "type": "grid",
          "props": {
            "columnsTemplate": "repeat(auto-fill, minmax(260px, 1fr))",
            "gap": "12px"
          },
          "children": [
            {
              "id": "creative-workshop-pet-installations",
              "type": "card",
              "props": {
                "header": "桌宠安装管理"
              },
              "children": [
                {
                  "id": "creative-workshop-pet-installations-copy",
                  "type": "text",
                  "props": {
                    "text": "查看安装状态、运行时健康、启动恢复和卸载。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "creative-workshop-pet-installations-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开安装管理",
                    "href": "/creative-workshop/pet/installations",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "creative-workshop-pet-packages",
              "type": "card",
              "props": {
                "header": "扩展包"
              },
              "children": [
                {
                  "id": "creative-workshop-pet-packages-copy",
                  "type": "text",
                  "props": {
                    "text": "查看 .petx 包、版本、权限和完整性状态。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "creative-workshop-pet-packages-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开扩展包",
                    "href": "/extensions/packages",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "creative-workshop-pet-market",
              "type": "card",
              "props": {
                "header": "发现桌宠"
              },
              "children": [
                {
                  "id": "creative-workshop-pet-market-copy",
                  "type": "text",
                  "props": {
                    "text": "从扩展市场发现新的桌宠内容和动作资源。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "creative-workshop-pet-market-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开扩展市场",
                    "href": "/extensions/market",
                    "target": "_self"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 60,
    "maxLayoutCount": 40,
    "maxNodeCount": 40,
    "maxDataFetchCount": 0,
    "maxActionCount": 0
  }
}
