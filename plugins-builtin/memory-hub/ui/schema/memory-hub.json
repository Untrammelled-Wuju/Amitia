{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "记忆",
  "actions": [],
  "children": [
    {
      "id": "memory-hub-page",
      "type": "page",
      "children": [
        {
          "id": "memory-hub-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "记忆中心由插件提供",
            "description": "知识、记忆视图、图谱、情景和时间线使用同一套设备归属与权限边界，入口可以随插件启停。",
            "closable": false
          }
        },
        {
          "id": "memory-hub-grid",
          "type": "grid",
          "props": {
            "columnsTemplate": "repeat(auto-fill, minmax(240px, 1fr))",
            "gap": "12px"
          },
          "children": [
            {
              "id": "memory-hub-overview-card",
              "type": "card",
              "props": {
                "header": "记忆总览"
              },
              "children": [
                {
                  "id": "memory-hub-overview-copy",
                  "type": "text",
                  "props": {
                    "text": "查看长期记忆、生命周期和来源证据。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-overview-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开记忆总览",
                    "href": "/memory-manager",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-knowledge-card",
              "type": "card",
              "props": {
                "header": "知识库"
              },
              "children": [
                {
                  "id": "memory-hub-knowledge-copy",
                  "type": "text",
                  "props": {
                    "text": "管理知识来源、检索索引和引用证据。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-knowledge-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开知识库",
                    "href": "/knowledge",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-episodic-card",
              "type": "card",
              "props": {
                "header": "情景记忆"
              },
              "children": [
                {
                  "id": "memory-hub-episodic-copy",
                  "type": "text",
                  "props": {
                    "text": "回顾带时间和情绪线索的历史片段。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-episodic-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开情景记忆",
                    "href": "/episodic",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-graph-card",
              "type": "card",
              "props": {
                "header": "记忆图谱"
              },
              "children": [
                {
                  "id": "memory-hub-graph-copy",
                  "type": "text",
                  "props": {
                    "text": "查看实体、关系和证据之间的连接。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-graph-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开记忆图谱",
                    "href": "/graph",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-timeline-card",
              "type": "card",
              "props": {
                "header": "记忆时间线"
              },
              "children": [
                {
                  "id": "memory-hub-timeline-copy",
                  "type": "text",
                  "props": {
                    "text": "按保存时间查看记忆变化和版本。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-timeline-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开时间线",
                    "href": "/memory-timeline",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-profiles-card",
              "type": "card",
              "props": {
                "header": "用户画像"
              },
              "children": [
                {
                  "id": "memory-hub-profiles-copy",
                  "type": "text",
                  "props": {
                    "text": "管理稳定偏好、习惯和关系画像。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-profiles-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开用户画像",
                    "href": "/profiles",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "memory-hub-worldbook-card",
              "type": "card",
              "props": {
                "header": "世界书"
              },
              "children": [
                {
                  "id": "memory-hub-worldbook-copy",
                  "type": "text",
                  "props": {
                    "text": "管理角色和世界观相关的结构化设定。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "memory-hub-worldbook-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开世界书",
                    "href": "/world-book",
                    "target": "_self"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 60,
    "maxLayoutCount": 80,
    "maxNodeCount": 80,
    "maxDataFetchCount": 0,
    "maxActionCount": 0
  }
}
