{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "归档对话",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "characters",
          "payload": {}
        },
        "statePath": "characters"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    },
    {
      "actionId": "select-conversation",
      "target": "local"
    }
  ],
  "children": [
    {
      "id": "chat-logs-page",
      "type": "page",
      "children": [
        {
          "id": "chat-logs-toolbar",
          "type": "grid",
          "props": {
            "columnsTemplate": "minmax(180px, 240px) minmax(0, 1fr) auto",
            "gap": "10px"
          },
          "children": [
            {
              "id": "chat-logs-role",
              "type": "select",
              "props": {
                "label": "角色",
                "placeholder": "选择角色"
              },
              "bindings": [
                {
                  "path": "roleId",
                  "source": "form",
                  "default": ""
                },
                {
                  "path": "options",
                  "source": "state",
                  "sourcePath": "characters"
                }
              ]
            },
            {
              "id": "chat-logs-keyword",
              "type": "field",
              "props": {
                "label": "搜索",
                "placeholder": "标题或消息内容"
              },
              "bindings": [
                {
                  "path": "keyword",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "chat-logs-refresh",
              "type": "button",
              "props": {
                "text": "刷新归档",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "list",
                    "payload": {
                      "roleId": "$form.roleId",
                      "page": 1,
                      "pageSize": 128
                    }
                  },
                  "statePath": "conversations"
                }
              ]
            }
          ]
        },
        {
          "id": "chat-logs-list",
          "type": "gallery",
          "props": {
            "variant": "cards",
            "titleField": "title",
            "subtitleField": "archivedAt",
            "summaryField": "messageCount",
            "queryPath": "keyword",
            "searchFields": [
              "title"
            ],
            "minItemWidth": 280,
            "emptyText": "暂无归档对话",
            "showSubtitle": true,
            "showCount": false,
            "itemActions": [
              {
                "id": "open",
                "action_id": "command",
                "label": "查看消息",
                "type": "primary",
                "target": "tool",
                "input": {
                  "action": "messages",
                  "payload": {
                    "roleId": "$form.roleId",
                    "conversationId": "$item.id"
                  }
                },
                "statePath": "messages",
                "followUpActions": [
                  {
                    "action_id": "select-conversation",
                    "target": "local",
                    "formPath": "conversationId",
                    "input": "$item.id"
                  }
                ]
              },
              {
                "id": "restore",
                "action_id": "command",
                "label": "撤销归档",
                "target": "tool",
                "input": {
                  "action": "restore",
                  "payload": {
                    "roleId": "$form.roleId",
                    "conversationId": "$item.id"
                  }
                },
                "statePath": "actionResult",
                "followUpActions": [
                  {
                    "action_id": "command",
                    "target": "tool",
                    "input": {
                      "action": "list",
                      "payload": {
                        "roleId": "$form.roleId",
                        "page": 1,
                        "pageSize": 128
                      }
                    },
                    "statePath": "conversations"
                  }
                ]
              },
              {
                "id": "summary",
                "action_id": "command",
                "label": "生成摘要",
                "target": "tool",
                "input": {
                  "action": "summary",
                  "payload": {
                    "roleId": "$form.roleId",
                    "conversationId": "$item.id"
                  }
                },
                "statePath": "summary"
              },
              {
                "id": "export",
                "action_id": "command",
                "label": "导出 JSON",
                "target": "tool",
                "input": {
                  "action": "export",
                  "payload": {
                    "roleId": "$form.roleId",
                    "conversationId": "$item.id"
                  }
                },
                "statePath": "exportResult"
              },
              {
                "id": "delete",
                "action_id": "command",
                "label": "永久删除",
                "type": "danger",
                "target": "tool",
                "confirmation": "永久删除该对话及消息，记忆会保留。此操作无法撤销。",
                "input": {
                  "action": "delete",
                  "payload": {
                    "roleId": "$form.roleId",
                    "conversationId": "$item.id"
                  }
                },
                "statePath": "actionResult",
                "followUpActions": [
                  {
                    "action_id": "command",
                    "target": "tool",
                    "input": {
                      "action": "list",
                      "payload": {
                        "roleId": "$form.roleId",
                        "page": 1,
                        "pageSize": 128
                      }
                    },
                    "statePath": "conversations"
                  }
                ]
              }
            ]
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "conversations.items"
            }
          ]
        },
        {
          "id": "chat-logs-current",
          "type": "field",
          "props": {
            "label": "当前会话 ID",
            "disabled": true
          },
          "bindings": [
            {
              "path": "conversationId",
              "source": "form",
              "default": ""
            }
          ]
        },
        {
          "id": "chat-logs-message-section",
          "type": "section",
          "props": {
            "title": "归档消息"
          },
          "children": [
            {
              "id": "chat-logs-messages",
              "type": "table",
              "props": {
                "maxHeight": 520,
                "columns": [
                  {
                    "prop": "role",
                    "label": "角色",
                    "width": 100
                  },
                  {
                    "prop": "content",
                    "label": "内容"
                  },
                  {
                    "prop": "createdAt",
                    "label": "时间",
                    "width": 190
                  }
                ]
              },
              "bindings": [
                {
                  "path": "data",
                  "source": "state",
                  "sourcePath": "messages.items"
                }
              ]
            },
            {
              "id": "chat-logs-summary",
              "type": "key_value",
              "props": {
                "title": "对话摘要",
                "columns": 1
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "summary"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "accessibility": {
    "enabled": true,
    "keyboardNav": true,
    "screenReader": true
  },
  "performanceBudget": {
    "maxRenderTimeMs": 180,
    "maxLayoutCount": 240,
    "maxNodeCount": 240,
    "maxDataFetchCount": 2,
    "maxActionCount": 24
  }
}
