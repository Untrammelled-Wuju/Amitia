{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "工作区",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "mounts",
          "payload": {}
        },
        "statePath": "mounts"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    },
    {
      "actionId": "select-mount",
      "target": "local"
    },
    {
      "actionId": "set-current-uri",
      "target": "local"
    },
    {
      "actionId": "set-workspace-uri",
      "target": "local"
    }
  ],
  "children": [
    {
      "id": "workspace-page",
      "type": "page",
      "children": [
        {
          "id": "workspace-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "工作区由插件提供，核心只执行受控能力",
            "description": "文件路径策略、只读限制、Git 安全策略和权限审计仍由 Amitia 核心执行。插件可被同契约的第三方实现替换。",
            "closable": false
          }
        },
        {
          "id": "workspace-mounts-section",
          "type": "section",
          "props": {
            "title": "工作区"
          },
          "children": [
            {
              "id": "workspace-mounts-toolbar",
              "type": "row",
              "props": {
                "gap": "8px"
              },
              "children": [
                {
                  "id": "workspace-mounts-refresh",
                  "type": "button",
                  "props": {
                    "text": "刷新工作区",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "mounts",
                        "payload": {}
                      },
                      "statePath": "mounts"
                    }
                  ]
                },
                {
                  "id": "workspace-current-root-label",
                  "type": "text",
                  "props": {
                    "text": "当前工作区根目录"
                  }
                },
                {
                  "id": "workspace-current-root",
                  "type": "field",
                  "props": {
                    "label": "工作区 URI",
                    "placeholder": "从下方工作区卡片选择"
                  },
                  "bindings": [
                    {
                      "path": "workspaceUri",
                      "source": "form",
                      "default": ""
                    }
                  ]
                }
              ]
            },
            {
              "id": "workspace-mounts",
              "type": "gallery",
              "props": {
                "variant": "cards",
                "titleField": "name",
                "subtitleField": "kind",
                "summaryField": "status",
                "platformField": "status",
                "minItemWidth": 260,
                "emptyText": "暂无可用工作区",
                "showSubtitle": true,
                "showCount": false,
                "itemActions": [
                  {
                    "id": "select-workspace",
                    "action_id": "command",
                    "label": "选择并打开",
                    "type": "primary",
                    "plain": true,
                    "target": "tool",
                    "input": {
                      "action": "browse",
                      "payload": {
                        "uri": "$item.rootUri"
                      }
                    },
                    "statePath": "fs",
                    "followUpActions": [
                      {
                        "action_id": "set-workspace-uri",
                        "target": "local",
                        "formPath": "workspaceUri",
                        "input": "$item.rootUri"
                      },
                      {
                        "action_id": "set-current-uri",
                        "target": "local",
                        "formPath": "currentUri",
                        "input": "$item.rootUri"
                      }
                    ]
                  }
                ]
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "mounts"
                }
              ]
            }
          ]
        },
        {
          "id": "workspace-browser-tabs",
          "type": "tabs",
          "children": [
            {
              "id": "workspace-files-tab",
              "type": "tab_item",
              "props": {
                "label": "文件",
                "name": "files"
              },
              "children": [
                {
                  "id": "workspace-files-toolbar",
                  "type": "grid",
                  "props": {
                    "columnsTemplate": "minmax(0, 1fr) auto auto",
                    "gap": "8px"
                  },
                  "children": [
                    {
                      "id": "workspace-current-uri",
                      "type": "field",
                      "props": {
                        "label": "当前路径",
                        "placeholder": "amitia://workspace/@workspace-id/path"
                      },
                      "bindings": [
                        {
                          "path": "currentUri",
                          "source": "form",
                          "default": ""
                        }
                      ]
                    },
                    {
                      "id": "workspace-browse",
                      "type": "button",
                      "props": {
                        "text": "打开路径",
                        "type": "primary"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "browse",
                            "payload": {
                              "uri": "$form.currentUri"
                            }
                          },
                          "statePath": "fs"
                        }
                      ]
                    },
                    {
                      "id": "workspace-browse-parent",
                      "type": "button",
                      "props": {
                        "text": "上一级"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "browse_parent",
                            "payload": {
                              "currentUri": "$form.currentUri",
                              "workspaceUri": "$form.workspaceUri"
                            }
                          },
                          "statePath": "fs",
                          "followUpActions": [
                            {
                              "action_id": "set-current-uri",
                              "target": "local",
                              "formPath": "currentUri",
                              "input": "$context.fs.path"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "workspace-file-list",
                  "type": "gallery",
                  "props": {
                    "variant": "cards",
                    "titleField": "name",
                    "subtitleField": "type",
                    "summaryField": "mimeType",
                    "minItemWidth": 220,
                    "emptyText": "目录为空或尚未选择工作区",
                    "showSubtitle": true,
                    "showCount": false,
                    "itemActions": [
                      {
                        "id": "open-directory",
                        "action_id": "command",
                        "label": "打开目录",
                        "type": "primary",
                        "plain": true,
                        "target": "tool",
                        "visibleWhen": [
                          {
                            "field": "type",
                            "operator": "==",
                            "value": "directory"
                          }
                        ],
                        "input": {
                          "action": "browse",
                          "payload": {
                            "uri": "$item.uri"
                          }
                        },
                        "statePath": "fs",
                        "followUpActions": [
                          {
                            "action_id": "set-current-uri",
                            "target": "local",
                            "formPath": "currentUri",
                            "input": "$item.uri"
                          }
                        ]
                      },
                      {
                        "id": "preview-file",
                        "action_id": "command",
                        "label": "预览",
                        "type": "primary",
                        "plain": true,
                        "target": "tool",
                        "visibleWhen": [
                          {
                            "field": "type",
                            "operator": "==",
                            "value": "file"
                          }
                        ],
                        "input": {
                          "action": "preview",
                          "payload": {
                            "uri": "$item.uri"
                          }
                        },
                        "statePath": "preview"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "items",
                      "source": "state",
                      "sourcePath": "fs.entries"
                    }
                  ]
                },
                {
                  "id": "workspace-preview-card",
                  "type": "card",
                  "props": {
                    "title": "文件预览"
                  },
                  "children": [
                    {
                      "id": "workspace-preview-content",
                      "type": "code",
                      "bindings": [
                        {
                          "path": "content",
                          "source": "state",
                          "sourcePath": "preview.content"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "workspace-git-tab",
              "type": "tab_item",
              "props": {
                "label": "Git",
                "name": "git"
              },
              "children": [
                {
                  "id": "workspace-git-toolbar",
                  "type": "row",
                  "props": {
                    "gap": "8px"
                  },
                  "children": [
                    {
                      "id": "workspace-git-refresh",
                      "type": "button",
                      "props": {
                        "text": "刷新 Git",
                        "type": "primary"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_overview",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri"
                            }
                          },
                          "statePath": "git"
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-stage-all",
                      "type": "button",
                      "props": {
                        "text": "暂存全部"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_add",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri",
                              "paths": [],
                              "all": true,
                              "force": true
                            }
                          },
                          "successMessage": "已暂存全部变更",
                          "statePath": "gitAction",
                          "followUpActions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "git_overview",
                                "payload": {
                                  "workspaceUri": "$form.workspaceUri"
                                }
                              },
                              "statePath": "git"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-fetch",
                      "type": "button",
                      "props": {
                        "text": "Fetch"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_fetch",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri",
                              "remote": "$form.remote"
                            }
                          },
                          "successMessage": "Fetch 完成",
                          "statePath": "gitAction"
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-pull",
                      "type": "button",
                      "props": {
                        "text": "Pull"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_pull",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri",
                              "remote": "$form.remote",
                              "branch": "$form.branchName"
                            }
                          },
                          "confirmation": "确认从远程 Pull 当前工作区？",
                          "successMessage": "Pull 完成",
                          "statePath": "gitAction"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "workspace-git-changes-title",
                  "type": "text",
                  "props": {
                    "text": "变更"
                  }
                },
                {
                  "id": "workspace-git-changes",
                  "type": "gallery",
                  "props": {
                    "variant": "cards",
                    "titleField": "uri",
                    "subtitleField": "staging",
                    "summaryField": "worktree",
                    "minItemWidth": 280,
                    "emptyText": "没有未提交变更",
                    "showSubtitle": true,
                    "showCount": false,
                    "itemActions": [
                      {
                        "id": "stage-change",
                        "action_id": "command",
                        "label": "暂存",
                        "target": "tool",
                        "input": {
                          "action": "git_add",
                          "payload": {
                            "workspaceUri": "$form.workspaceUri",
                            "paths": [
                              "$item.uri"
                            ],
                            "all": false,
                            "force": false
                          }
                        },
                        "statePath": "gitAction"
                      },
                      {
                        "id": "restore-change",
                        "action_id": "command",
                        "label": "还原",
                        "type": "danger",
                        "target": "tool",
                        "confirmation": "还原该文件的工作区改动？",
                        "input": {
                          "action": "git_restore",
                          "payload": {
                            "workspaceUri": "$form.workspaceUri",
                            "paths": [
                              "$item.uri"
                            ],
                            "worktree": true
                          }
                        },
                        "statePath": "gitAction"
                      },
                      {
                        "id": "diff-change",
                        "action_id": "command",
                        "label": "Diff",
                        "target": "tool",
                        "input": {
                          "action": "git_diff",
                          "payload": {
                            "workspaceUri": "$form.workspaceUri",
                            "paths": [
                              "$item.uri"
                            ]
                          }
                        },
                        "statePath": "diff"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "items",
                      "source": "state",
                      "sourcePath": "git.status.entries"
                    }
                  ]
                },
                {
                  "id": "workspace-git-diff-card",
                  "type": "card",
                  "props": {
                    "title": "Git Diff"
                  },
                  "children": [
                    {
                      "id": "workspace-git-diff-code",
                      "type": "code",
                      "bindings": [
                        {
                          "path": "content",
                          "source": "state",
                          "sourcePath": "diff.files.0.patch"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "workspace-git-commit",
                  "type": "section",
                  "props": {
                    "title": "提交与分支"
                  },
                  "children": [
                    {
                      "id": "workspace-git-commit-message",
                      "type": "field",
                      "props": {
                        "label": "提交信息",
                        "variant": "textarea",
                        "placeholder": "描述本次变更"
                      },
                      "bindings": [
                        {
                          "path": "commitMessage",
                          "source": "form",
                          "default": ""
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-commit-button",
                      "type": "button",
                      "props": {
                        "text": "创建提交",
                        "type": "primary"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_commit",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri",
                              "message": "$form.commitMessage"
                            }
                          },
                          "successMessage": "提交完成",
                          "statePath": "gitAction",
                          "followUpActions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "git_overview",
                                "payload": {
                                  "workspaceUri": "$form.workspaceUri"
                                }
                              },
                              "statePath": "git"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-branch-name",
                      "type": "field",
                      "props": {
                        "label": "分支名",
                        "placeholder": "main"
                      },
                      "bindings": [
                        {
                          "path": "branchName",
                          "source": "form",
                          "default": ""
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-branch-actions",
                      "type": "button_group",
                      "children": [
                        {
                          "id": "workspace-git-checkout",
                          "type": "button",
                          "props": {
                            "text": "切换分支"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "git_checkout",
                                "payload": {
                                  "workspaceUri": "$form.workspaceUri",
                                  "branch": "$form.branchName",
                                  "create": false
                                }
                              },
                              "successMessage": "分支已切换",
                              "statePath": "gitAction"
                            }
                          ]
                        },
                        {
                          "id": "workspace-git-create-branch",
                          "type": "button",
                          "props": {
                            "text": "新建并切换",
                            "type": "primary"
                          },
                          "actions": [
                            {
                              "action_id": "command",
                              "target": "tool",
                              "input": {
                                "action": "git_checkout",
                                "payload": {
                                  "workspaceUri": "$form.workspaceUri",
                                  "branch": "$form.branchName",
                                  "create": true
                                }
                              },
                              "successMessage": "分支已创建并切换",
                              "statePath": "gitAction"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "workspace-git-branches",
                  "type": "table",
                  "props": {
                    "title": "分支",
                    "columns": [
                      {
                        "prop": "name",
                        "label": "分支",
                        "width": 180
                      },
                      {
                        "prop": "commit",
                        "label": "Commit"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "data",
                      "source": "state",
                      "sourcePath": "git.branches.branches"
                    }
                  ]
                },
                {
                  "id": "workspace-git-remotes",
                  "type": "table",
                  "props": {
                    "title": "远程",
                    "columns": [
                      {
                        "prop": "name",
                        "label": "名称",
                        "width": 100
                      },
                      {
                        "prop": "fetchUrl",
                        "label": "Fetch URL"
                      },
                      {
                        "prop": "hasCredential",
                        "label": "凭据",
                        "width": 80
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "data",
                      "source": "state",
                      "sourcePath": "git.remotes"
                    }
                  ]
                },
                {
                  "id": "workspace-git-log",
                  "type": "table",
                  "props": {
                    "title": "提交历史",
                    "columns": [
                      {
                        "prop": "hash",
                        "label": "Hash",
                        "width": 120
                      },
                      {
                        "prop": "subject",
                        "label": "提交"
                      },
                      {
                        "prop": "authorName",
                        "label": "作者",
                        "width": 140
                      },
                      {
                        "prop": "committedAt",
                        "label": "时间",
                        "width": 180
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "data",
                      "source": "state",
                      "sourcePath": "git.log.entries"
                    }
                  ]
                },
                {
                  "id": "workspace-git-push",
                  "type": "section",
                  "props": {
                    "title": "Push"
                  },
                  "children": [
                    {
                      "id": "workspace-git-remote",
                      "type": "field",
                      "props": {
                        "label": "Remote"
                      },
                      "bindings": [
                        {
                          "path": "remote",
                          "source": "form",
                          "default": "origin"
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-local-ref",
                      "type": "field",
                      "props": {
                        "label": "Local ref"
                      },
                      "bindings": [
                        {
                          "path": "localRef",
                          "source": "form",
                          "default": "HEAD"
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-remote-ref",
                      "type": "field",
                      "props": {
                        "label": "Remote ref"
                      },
                      "bindings": [
                        {
                          "path": "remoteRef",
                          "source": "form",
                          "default": "HEAD"
                        }
                      ]
                    },
                    {
                      "id": "workspace-git-push-button",
                      "type": "button",
                      "props": {
                        "text": "Push",
                        "type": "primary"
                      },
                      "actions": [
                        {
                          "action_id": "command",
                          "target": "tool",
                          "input": {
                            "action": "git_push",
                            "payload": {
                              "workspaceUri": "$form.workspaceUri",
                              "remote": "$form.remote",
                              "localRef": "$form.localRef",
                              "remoteRef": "$form.remoteRef"
                            }
                          },
                          "confirmation": "确认向远程 Push？",
                          "successMessage": "Push 完成",
                          "statePath": "gitAction"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "workspace-isolated-tab",
              "type": "tab_item",
              "props": {
                "label": "隔离工作区",
                "name": "isolated"
              },
              "children": [
                {
                  "id": "workspace-isolated-name",
                  "type": "field",
                  "props": {
                    "label": "名称"
                  },
                  "bindings": [
                    {
                      "path": "isolatedName",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-mode",
                  "type": "select",
                  "props": {
                    "label": "模式",
                    "options": [
                      {
                        "label": "Snapshot",
                        "value": "snapshot"
                      },
                      {
                        "label": "Git Clone",
                        "value": "git_clone"
                      }
                    ]
                  },
                  "bindings": [
                    {
                      "path": "isolatedMode",
                      "source": "form",
                      "default": "snapshot"
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-source",
                  "type": "field",
                  "props": {
                    "label": "源工作区 URI"
                  },
                  "bindings": [
                    {
                      "path": "isolatedSource",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-remote",
                  "type": "field",
                  "props": {
                    "label": "Git Remote URL"
                  },
                  "bindings": [
                    {
                      "path": "isolatedRemote",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-ref",
                  "type": "field",
                  "props": {
                    "label": "Ref"
                  },
                  "bindings": [
                    {
                      "path": "isolatedRef",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-lifetime",
                  "type": "field",
                  "props": {
                    "label": "生命周期",
                    "placeholder": "例如 24h"
                  },
                  "bindings": [
                    {
                      "path": "isolatedLifetime",
                      "source": "form",
                      "default": ""
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-readonly",
                  "type": "switch",
                  "props": {
                    "activeText": "只读"
                  },
                  "bindings": [
                    {
                      "path": "isolatedReadOnly",
                      "source": "form",
                      "default": false
                    }
                  ]
                },
                {
                  "id": "workspace-isolated-create",
                  "type": "button",
                  "props": {
                    "text": "创建隔离工作区",
                    "type": "primary"
                  },
                  "actions": [
                    {
                      "action_id": "command",
                      "target": "tool",
                      "input": {
                        "action": "create_isolated",
                        "payload": {
                          "name": "$form.isolatedName",
                          "mode": "$form.isolatedMode",
