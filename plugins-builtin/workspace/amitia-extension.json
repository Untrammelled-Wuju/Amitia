{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia/workspace",
    "name": {
      "default": "工作区"
    },
    "description": {
      "default": "通过统一插件契约浏览工作区文件、管理 Git 仓库并创建隔离工作区。"
    },
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "homepage": "https://amitia.untrammelled.top",
    "categories": [
      "productivity",
      "developer",
      "system"
    ],
    "keywords": [
      "workspace",
      "files",
      "git",
      "repository"
    ],
    "metadata": {
      "system.defaultInstall": true,
      "system.defaultEnabled": true
    },
    "publisher": {
      "id": "com.amitia",
      "displayName": "Amitia",
      "trustLevel": "official"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0",
    "platforms": [
      "windows",
      "linux",
      "macos"
    ]
  },
  "modules": [
    {
      "id": "workspace-runtime",
      "name": {
        "default": "工作区运行时"
      },
      "description": {
        "default": "通过 Host API 访问受控文件系统与 Git 能力。"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "dist/index.js",
        "timeout": "2m",
        "memoryBytes": 67108864,
        "capabilities": {
          "network": false,
          "filesystem": false
        },
        "hostAccess": {
          "filesystem": {
            "mode": "none"
          },
          "network": {
            "mode": "none"
          },
          "process": {
            "mode": "none"
          }
        }
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "ui",
          "ui_provider"
        ],
        "maxContributions": 8,
        "maxTools": 1,
        "maxRoutes": 1,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "workspace-command",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "工作区操作"
          },
          "description": {
            "default": "执行受控的工作区文件与 Git 操作。"
          },
          "spec": {
            "toolId": "com.amitia/workspace/command",
            "modelName": "amitia_workspace",
            "handlerName": "command",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "mounts",
                    "browse",
                    "browse_parent",
                    "preview",
                    "git_overview",
                    "git_diff",
                    "git_add",
                    "git_restore",
                    "git_commit",
                    "git_checkout",
                    "git_fetch",
                    "git_pull",
                    "git_push",
                    "isolated_info",
                    "create_isolated",
                    "delete_isolated",
                    "write_file",
                    "mkdir",
                    "rename",
                    "move",
                    "copy",
                    "delete"
                  ]
                },
                "payload": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "additionalProperties": true
            },
            "riskLevel": "high",
            "sideEffect": "write",
            "internal": true,
            "runtime": {
              "runtimeType": "javascript",
              "handlerName": "command"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "workspace.read",
            "workspace.write"
          ]
        },
        {
          "id": "workspace-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "工作区"
          },
          "description": {
            "default": "浏览文件、管理 Git 仓库并创建隔离工作区。"
          },
          "spec": {
            "contribution_id": "workspace-page",
            "extension_id": "com.amitia/workspace",
            "module_id": "workspace-runtime",
            "kind": "schema_page",
            "slot": {
              "slot_id": "provider.page.provider",
              "contract_version": 1
            },
            "contract_version": 1,
            "display": {
              "title": {
                "default": "工作区"
              },
              "description": {
                "default": "浏览文件、管理 Git 仓库并创建隔离工作区。"
              },
              "icon": "folder-opened"
            },
            "entry": {
              "type": "schema_renderer",
              "schema_path": "modules/workspace-ui/desktop/workspace.json",
              "content_hash": "pending"
            },
            "sandbox": {
              "type": "schema_renderer"
            },
            "ordering": {
              "priority": 250
            },
            "visibility": {
              "platforms": [
                "windows",
                "linux",
                "macos"
              ]
            },
            "actions": [
              {
                "action_id": "command",
                "title": {
                  "default": "执行工作区操作"
                },
                "target": {
                  "type": "tool",
                  "tool_id": "com.amitia/workspace/command"
                },
                "risk_level": "high"
              }
            ],
            "integrity": {
              "definition_hash": "workspace-page-v1"
            }
          },
          "requiredPermissions": [
            "tool.invoke",
            "workspace.read",
            "workspace.write"
          ]
        },
        {
          "id": "workspace-routes",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "工作区路由"
          },
          "spec": {
            "providerId": "workspace-routes",
            "capability": "route.registry",
            "mode": "replace",
            "priority": 250,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "declarative"
              },
              "electron_windows": {
                "type": "declarative"
              },
              "electron_macos": {
                "type": "declarative"
              },
              "electron_linux": {
                "type": "declarative"
              }
            },
            "metadata": {
              "routes": [
                {
                  "id": "workspace",
                  "path": "/workspaces",
                  "providerId": "workspace-page-provider",
                  "capability": "page.provider",
                  "title": "工作区",
                  "priority": 250
                }
              ],
              "navigationItems": [
                {
                  "id": "workspace",
                  "label": "工作区",
                  "route": "/workspaces",
                  "icon": "folder-opened",
                  "group": "workspace",
                  "groupLabel": "工作区",
                  "groupIcon": "folder",
                  "order": 25,
                  "mobile": false
                }
              ]
            }
          }
        },
        {
          "id": "workspace-page-provider",
          "kind": "ui_provider",
          "adapter": "ui_provider",
          "contractVersion": 1,
          "name": {
            "default": "工作区页面 Provider"
          },
          "spec": {
            "providerId": "workspace-page-provider",
            "capability": "page.provider",
            "mode": "replace",
            "priority": 250,
            "trustLevel": "official",
            "entries": {
              "web": {
                "type": "schema_renderer",
                "contributionId": "workspace-page"
              },
              "electron_windows": {
                "type": "schema_renderer",
                "contributionId": "workspace-page"
              },
              "electron_macos": {
                "type": "schema_renderer",
                "contributionId": "workspace-page"
              },
              "electron_linux": {
                "type": "schema_renderer",
                "contributionId": "workspace-page"
              }
            },
            "metadata": {
              "routes": [
                "/workspaces"
              ]
            }
          }
        }
      ],
      "placement": "device",
      "deviceRequirements": {
        "platforms": [
          "windows",
          "linux",
          "macos"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "通过插件工具执行工作区页面操作。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "workspace.read",
      "reason": "读取工作区挂载、文件列表、文件预览和 Git 状态。",
      "required": true,
      "scope": "extension"
    },
    {
      "name": "workspace.write",
      "reason": "执行文件写入、Git 变更和隔离工作区维护动作。",
      "required": true,
      "scope": "extension"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "scopes": [
      "device"
    ],
    "backup": false,
    "export": false,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
