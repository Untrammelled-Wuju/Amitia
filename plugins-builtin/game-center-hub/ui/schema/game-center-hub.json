{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "游戏模式",
  "actions": [],
  "children": [
    {
      "id": "game-center-hub-page",
      "type": "page",
      "children": [
        {
          "id": "game-center-hub-intro",
          "type": "alert",
          "props": {
            "type": "info",
            "title": "游戏中心由插件提供",
            "description": "游戏运行、插件安装、进程监管和权限边界仍由核心负责，中心入口可以随插件启停。",
            "closable": false
          }
        },
        {
          "id": "game-center-hub-grid",
          "type": "grid",
          "props": {
            "columnsTemplate": "repeat(auto-fill, minmax(260px, 1fr))",
            "gap": "12px"
          },
          "children": [
            {
              "id": "game-center-hub-manage",
              "type": "card",
              "props": {
                "header": "游戏插件"
              },
              "children": [
                {
                  "id": "game-center-hub-manage-copy",
                  "type": "text",
                  "props": {
                    "text": "安装、启用和管理 .gamex 游戏插件。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "game-center-hub-manage-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开游戏插件",
                    "href": "/game-center/plugin",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "game-center-hub-market",
              "type": "card",
              "props": {
                "header": "获取游戏扩展"
              },
              "children": [
                {
                  "id": "game-center-hub-market-copy",
                  "type": "text",
                  "props": {
                    "text": "从扩展市场发现和安装新的游戏运行内容。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "game-center-hub-market-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开扩展市场",
                    "href": "/extensions/market",
                    "target": "_self"
                  }
                }
              ]
            },
            {
              "id": "game-center-hub-packages",
              "type": "card",
              "props": {
                "header": "扩展包管理"
              },
              "children": [
                {
                  "id": "game-center-hub-packages-copy",
                  "type": "text",
                  "props": {
                    "text": "查看安装记录、版本、权限和运行状态。",
                    "variant": "muted"
                  }
                },
                {
                  "id": "game-center-hub-packages-link",
                  "type": "resource_link",
                  "props": {
                    "text": "打开扩展包",
                    "href": "/extensions/packages",
                    "target": "_self"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 60,
    "maxLayoutCount": 40,
    "maxNodeCount": 40,
    "maxDataFetchCount": 0,
    "maxActionCount": 0
  }
}
