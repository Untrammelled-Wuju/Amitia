{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/layouts/**",
    "src/views/pages/articles/**",
    "src/views/pages/analysis/**",
    "src/views/pages/friendLink/**",
    "src/views/pages/idea/**",
    "src/views/pages/log/**",
    "src/views/pages/navigation/**",
    "src/views/pages/project/**",
    "src/views/pages/sentences/**",
    "src/views/pages/setting/**",
    "src/views/pages/talk/**",
    "src/views/pages/tool/**",
    "src/views/pages/websiteConfig/**"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
