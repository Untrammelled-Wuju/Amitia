{
  "schemaVersion": 1,
  "description": "Canonical Runtime Program Contract - shared schema between Python Validator, Android PackageVerifier, and Runtime Package Builder",
  "requiredProgramPaths": [
    "backend/amitia-server",
    "node/bin/node",
    "node/lib/node_modules/npm/bin/npm-cli.js",
    "node/lib/node_modules/npm/bin/npx-cli.js",
    "qdrant/bin/qdrant",
    "plugin-host/dist/index.js",
    "task-host/dist/index.js",
    "scripts/node/amitia-node-prepare.sh",
    "scripts/node/amitia-node-probe.sh",
    "manifest/guest-layout.json",
    "manifest/mount-contract.json"
  ],
  "programSubdirs": [
    "backend",
    "node",
    "qdrant",
    "sidecar",
    "qq-sidecar",
    "plugin-host",
    "task-host",
    "scripts",
    "manifest",
    "licenses"
  ],
  "packageFormat": {
    "metadata": [
      "metadata/package-index.json",
      "metadata/component-lock.json",
      "metadata/SHA256SUMS",
      "metadata/guest-layout.json",
      "metadata/mount-contract.json"
    ],
    "payloads": [
      "payload/rootfs/rootfs.tar.xz",
      "payload/runtime/runtime.tar.xz"
    ]
  }
}
