{
  "schemaVersion": 1,
  "componentId": "runtime.guest-mount-contract",
  "version": "1",
  "mounts": [
    {
      "id": "runtime",
      "guestTarget": "/opt/amitia",
      "persistence": "immutable",
      "required": true,
      "sourceClass": "runtime-package"
    },
    {
      "id": "config",
      "guestTarget": "/etc/amitia",
      "persistence": "persistent-critical",
      "required": true,
      "sourceClass": "config"
    },
    {
      "id": "data",
      "guestTarget": "/var/lib/amitia",
      "persistence": "persistent-critical",
      "required": true,
      "sourceClass": "data"
    },
    {
      "id": "cache",
      "guestTarget": "/var/cache/amitia",
      "persistence": "rebuildable",
      "required": true,
      "sourceClass": "cache"
    },
    {
      "id": "logs",
      "guestTarget": "/var/log/amitia",
      "persistence": "persistent-diagnostic",
      "required": true,
      "sourceClass": "logs"
    },
    {
      "id": "run",
      "guestTarget": "/run/amitia",
      "persistence": "ephemeral",
      "required": true,
      "sourceClass": "run"
    }
  ],
  "order": [
    "runtime",
    "config",
    "data",
    "cache",
    "logs",
    "run"
  ]
}
