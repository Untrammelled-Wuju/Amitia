{
  "schemaVersion": 1,
  "binds": [
    {
      "role": "program",
      "source": "${HOST_PROGRAM_ROOT}",
      "target": "/opt/amitia",
      "readOnly": true,
      "description": "Active read-only program source mounted into guest"
    },
    {
      "role": "config",
      "source": "${HOST_CONFIG_ROOT}",
      "target": "/etc/amitia",
      "readOnly": false,
      "description": "Persistent configuration directory"
    },
    {
      "role": "data",
      "source": "${HOST_DATA_ROOT}",
      "target": "/var/lib/amitia",
      "readOnly": false,
      "description": "Persistent data directory (security, providers, storage)"
    },
    {
      "role": "cache",
      "source": "${HOST_CACHE_ROOT}",
      "target": "/var/cache/amitia",
      "readOnly": false,
      "description": "Cache directory (npm cache)"
    },
    {
      "role": "logs",
      "source": "${HOST_LOG_ROOT}",
      "target": "/var/log/amitia",
      "readOnly": false,
      "description": "Log directory"
    },
    {
      "role": "run",
      "source": "${HOST_RUN_ROOT}",
      "target": "/run/amitia",
      "readOnly": false,
      "description": "Runtime state directory"
    },
    {
      "role": "home",
      "source": "${HOST_HOME_ROOT}",
      "target": "/home/amitia",
      "readOnly": false,
      "description": "Guest home directory for runtime user"
    }
  ],
  "environment": {
    "TERM": "xterm-256color",
    "HOME": "/home/amitia",
    "PATH": "/opt/amitia/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "LANG": "C.UTF-8"
  }
}
