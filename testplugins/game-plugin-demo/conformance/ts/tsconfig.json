{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "types": ["node", "jest"],
    "baseUrl": "./src"
  },
  "include": ["src/**/*", "src/matrices/**/*"],
  "exclude": ["node_modules", "dist"]
}
