{
  "schemaVersion": 1,
  "protectedRoutes": [
    "/onboarding",
    "/privacy",
    "/usage-boundary",
    "/settings/ui-providers",
    "/settings",
    "/my-space",
    "/me",
    "/logs",
    "/characters",
    "/memory",
    "/tasks",
    "/extensions",
    "/reminders",
    "/continuity"
  ],
  "providerRoutes": [
    {
      "path": "/extensions/market",
      "extensionId": "com.amitia/plugin-market",
      "manifest": "plugins-builtin/plugin-market/amitia-extension.json",
      "registryProviderId": "plugin-market-routes",
      "routeId": "plugin-market",
      "pageProviderId": "plugin-market-page-provider",
      "entries": [
        "web",
        "electron_windows",
        "electron_macos",
        "electron_linux",
        "mobile"
      ]
    },
    {
