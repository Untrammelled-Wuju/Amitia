{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitia.untrammelled.top/contracts/workbench/terminal-transcript-v1.schema.json",
  "title": "Workbench Terminal Bounded Output Export V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "running",
    "exitCode",
    "data",
    "baseCursor",
    "endCursor",
    "truncated",
    "capturedAt",
    "startedAt",
    "outputBytes",
    "outputDigest",
    "digestScope",
    "lifecycle",
    "lifecycleLatestSequence",
    "lifecycleTruncated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workspaceUri": {
      "type": "string",
      "pattern": "^amitia://workspace/@[A-Za-z0-9_-]{1,128}/$"
    },
    "mode": {
      "enum": [
        "pty",
        "conpty",
        "pipe"
      ]
    },
    "running": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": -1
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 349528
    },
    "baseCursor": {
      "type": "integer",
      "minimum": 0
    },
    "endCursor": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "outputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digestScope": {
      "const": "retained-bytes-only"
    },
    "lifecycle": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "kind",
          "at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "session.started",
              "session.resized",
              "process.exited"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "exitCode": {
            "type": "integer"
          },
          "rows": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
          },
          "cols": {
            "type": "integer",
            "minimum": 20,
            "maximum": 300
          }
        }
      }
    },
    "lifecycleLatestSequence": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycleTruncated": {
      "type": "boolean"
    }
  }
}
