{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitia.untrammelled.top/contracts/workbench/coding-worker-verification-summary-v1.schema.json",
  "title": "Coding Worker Evidence Verification Summary V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["total", "waiting", "blocked", "approved", "confirmedMerged", "requiresAttention", "allMergesConfirmed"],
  "properties": {
    "total": {"type": "integer", "minimum": 1, "maximum": 8},
    "waiting": {"type": "integer", "minimum": 0},
    "blocked": {"type": "integer", "minimum": 0},
    "approved": {"type": "integer", "minimum": 0},
    "confirmedMerged": {"type": "integer", "minimum": 0},
    "requiresAttention": {"type": "boolean"},
    "allMergesConfirmed": {"type": "boolean"}
  }
}
