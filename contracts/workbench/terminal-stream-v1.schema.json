{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench Terminal Stream V1",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "snapshot"],
      "properties": {
        "type": {"const": "snapshot"},
        "snapshot": {"$ref": "terminal-session-v1.schema.json"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "input"},
        "data": {"type": "string", "contentEncoding": "base64", "maxLength": 6000}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "rows", "cols"],
      "properties": {
        "type": {"const": "resize"},
        "rows": {"type": "integer", "minimum": 10, "maximum": 120},
        "cols": {"type": "integer", "minimum": 20, "maximum": 300}
      },
      "additionalProperties": false
    }
  ]
}
