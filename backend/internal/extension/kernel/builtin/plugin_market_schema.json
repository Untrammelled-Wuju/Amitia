{
  "schemaVersion": "schema-ui/1",
  "type": "document",
  "title": "插件市场",
  "lifecycle": {
    "onMount": [
      {
        "action_id": "command",
        "target": "tool",
        "input": {
          "action": "catalog"
        },
        "statePath": "market"
      }
    ]
  },
  "actions": [
    {
      "actionId": "command",
      "target": "tool"
    }
  ],
  "children": [
    {
      "id": "plugin-market-page",
      "type": "page",
      "children": [
        {
          "id": "plugin-market-search",
          "type": "grid",
          "props": {
            "columns": 12
          },
          "children": [
            {
              "id": "plugin-market-query",
              "type": "field",
              "props": {
                "label": "搜索",
                "placeholder": "名称、扩展 ID、发布者或能力"
              },
              "bindings": [
                {
                  "path": "pluginQuery",
                  "source": "form",
                  "default": ""
                }
              ]
            },
            {
              "id": "plugin-market-refresh",
              "type": "button",
              "props": {
                "text": "搜索",
                "type": "primary"
              },
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "input": {
                    "action": "catalog",
                    "q": "$form.pluginQuery"
                  },
                  "statePath": "market"
                }
              ]
            }
          ]
        },
        {
          "id": "plugin-market-source",
          "type": "text",
          "bindings": [
            {
              "path": "text",
              "source": "state",
              "sourcePath": "market.source"
            }
          ]
        },
        {
          "id": "plugin-market-list",
          "type": "gallery",
          "props": {
            "variant": "assets",
            "titleField": "displayName",
            "subtitleField": "extensionId",
            "minItemWidth": 260,
            "emptyText": "没有匹配的插件",
            "searchFields": [
              "displayName",
              "extensionId",
              "summary",
              "publisher"
            ],
            "showSubtitle": true,
            "showCount": true
          },
          "bindings": [
            {
              "path": "items",
              "source": "state",
              "sourcePath": "market.listings"
            }
          ],
          "actions": [
            {
              "action_id": "command",
              "target": "tool",
              "input": {
                "action": "prepare",
                "extensionId": "$item.extensionId",
                "version": "$item.latestVersion",
                "packageUri": "$item.packageUri",
                "sha256": "$item.sha256",
                "fileName": "$item.fileName",
                "publisher": "$item.publisher",
                "trustLevel": "$item.trustLevel",
                "entryId": "$item.extensionId",
                "source": {
                  "catalogId": "plugin-market",
                  "sourceType": "market",
                  "publisher": "$item.publisher",
                  "trustLevel": "$item.trustLevel",
                  "entryId": "$item.extensionId"
                }
              },
              "statePath": "review"
            }
          ]
        },
        {
          "id": "plugin-market-review",
          "type": "section",
          "props": {
            "title": "安装审查"
          },
          "visibleWhen": [
            {
              "field": "review.sessionId",
              "operator": "!=",
              "value": ""
            }
          ],
          "children": [
            {
              "id": "plugin-market-review-summary",
              "type": "key_value",
              "props": {
                "title": "插件信息",
                "columns": 2
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "review.summary"
                }
              ]
            },
            {
              "id": "plugin-market-review-risk",
              "type": "alert",
              "props": {
                "type": "warning",
                "title": "风险与确认项",
                "description": "请完整阅读后再确认安装。"
              },
              "bindings": [
                {
                  "path": "props.description",
                  "source": "state",
                  "sourcePath": "review.confirmationsText"
                }
              ]
            },
            {
              "id": "plugin-market-review-issues",
              "type": "alert",
              "props": {
                "type": "error",
                "title": "安装问题"
              },
              "bindings": [
                {
                  "path": "props.description",
                  "source": "state",
                  "sourcePath": "review.issuesText"
                }
              ],
              "visibleWhen": [
                {
                  "field": "review.issuesText",
                  "operator": "!=",
                  "value": ""
                }
              ]
            },
            {
              "id": "plugin-market-permissions",
              "type": "gallery",
              "props": {
                "variant": "assets",
                "titleField": "name",
                "subtitleField": "reason",
                "minItemWidth": 220,
                "emptyText": "该插件未声明额外权限。",
                "showSubtitle": true,
                "showCount": true
              },
              "bindings": [
                {
                  "path": "items",
                  "source": "state",
                  "sourcePath": "review.permissions"
                }
              ]
            },
            {
              "id": "plugin-market-confirm",
              "type": "switch",
              "props": {
                "activeText": "我已阅读并接受上述权限、风险和确认项"
              },
              "bindings": [
                {
                  "path": "installConfirmed",
                  "source": "form",
                  "default": false
                }
              ]
            },
            {
              "id": "plugin-market-install",
              "type": "button",
              "props": {
                "text": "确认安装",
                "type": "danger"
              },
              "visibleWhen": [
                {
                  "field": "installConfirmed",
                  "operator": "==",
                  "value": true
                }
              ],
              "actions": [
                {
                  "action_id": "command",
                  "target": "tool",
                  "confirmation": "确认按照审查结果安装该插件？",
                  "input": {
                    "action": "install",
                    "extensionId": "$state.review.extensionId",
                    "version": "$state.review.version",
                    "sessionId": "$state.review.sessionId",
                    "requiredConfirmations": "$state.review.requiredConfirmations",
                    "confirmed": "$form.installConfirmed"
                  },
                  "statePath": "installResult"
                }
              ]
            }
          ]
        },
        {
          "id": "plugin-market-install-result",
          "type": "alert",
          "props": {
            "type": "success",
            "title": "安装已提交"
          },
          "bindings": [
            {
              "path": "props.description",
              "source": "state",
              "sourcePath": "installResult.operationId"
            }
          ],
          "visibleWhen": [
            {
              "field": "installResult.operationId",
              "operator": "!=",
              "value": ""
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "auto"
  },
  "performanceBudget": {
    "maxRenderTimeMs": 120,
    "maxLayoutCount": 80,
    "maxNodeCount": 80,
    "maxDataFetchCount": 0,
    "maxActionCount": 16
  }
}
