{
  "openapi": "3.1.0",
  "info": {"title": "Amitia Extension Runtime API", "version": "3.0.0"},
  "servers": [{"url": "/api"}],
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "schemas": {
      "Problem": {"type": "object", "required": ["type", "title", "status", "detail", "instance", "code", "traceId"], "properties": {"type": {"type": "string", "format": "uri"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}, "instance": {"type": "string"}, "code": {"type": "string"}, "traceId": {"type": "string"}}},
      "ExecuteRequest": {"type": "object", "required": ["characterId", "input"], "properties": {"characterId": {"type": "string"}, "conversationId": {"type": "string"}, "channel": {"type": "string"}, "sessionId": {"type": "string"}, "idempotencyKey": {"type": "string"}, "input": {}}},
      "PermissionGrant": {"type": "object", "required": ["capability", "decision", "scopeType", "scopeId"], "properties": {"capability": {"type": "string"}, "decision": {"enum": ["deny", "allow_once", "allow_session", "allow_character", "allow_always"]}, "scopeType": {"enum": ["global", "character", "conversation", "channel", "session"]}, "scopeId": {"type": "string"}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "PluginManifest": {"type": "object", "required": ["$schema", "apiVersion", "kind", "metadata", "compatibility", "entry", "capabilities", "hooks", "subscriptions", "registeredSkills", "execution", "state", "enabled"], "properties": {"$schema": {"const": "https://schemas.amitia.dev/extensions/v1/manifest.schema.json"}, "apiVersion": {"const": "extensions.amitia.dev/v1alpha1"}, "kind": {"const": "Plugin"}, "metadata": {"type": "object"}, "compatibility": {"type": "object"}, "entry": {"type": "object"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "hooks": {"type": "array", "items": {"type": "string"}}, "subscriptions": {"type": "array", "items": {"type": "string"}}, "registeredSkills": {"type": "array", "items": {"type": "string"}}, "execution": {"type": "object"}, "state": {"type": "object"}, "enabled": {"type": "boolean"}}},
      "PluginView": {"type": "object", "required": ["manifest", "source", "lifecycle", "health", "compatible", "enabled", "currentCircuits"], "properties": {"manifest": {"$ref": "#/components/schemas/PluginManifest"}, "source": {"const": "builtin"}, "lifecycle": {"enum": ["registered", "loaded", "enabled", "disabled", "error", "circuit_open", "unloading", "unloaded"]}, "health": {"type": "string"}, "compatible": {"type": "boolean"}, "enabled": {"type": "boolean"}, "currentCircuits": {"type": "integer"}}},
      "SurfaceActionRequest": {"type": "object", "required": ["characterId", "input"], "properties": {"characterId": {"type": "string"}, "conversationId": {"type": "string"}, "channel": {"type": "string"}, "sessionId": {"type": "string"}, "input": {}}},
      "WorkshopSession": {"type": "object", "required": ["id", "userId", "status", "requirement", "currentRevision", "createdAt", "updatedAt"], "properties": {"id": {"type": "string"}, "userId": {"type": "string"}, "characterId": {"type": "string"}, "status": {"enum": ["draft", "generating", "generated", "validating", "validation_failed", "validated", "awaiting_permission_confirmation", "testing", "test_failed", "test_passed", "installing", "installed", "enabled", "disabled", "archived", "error"]}, "requirement": {"type": "string"}, "currentRevision": {"type": "integer"}, "installedSkillId": {"type": "string"}, "installedVersion": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
      "WorkshopPlan": {"type": "object", "required": ["goal", "inputs", "outputs", "configs", "steps", "dependencies", "capabilities", "sideEffects", "risks", "missingDetails", "assumptions"], "properties": {"goal": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "object"}}, "outputs": {"type": "array", "items": {"type": "object"}}, "configs": {"type": "array", "items": {"type": "object"}}, "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "purpose"], "properties": {"id": {"type": "string"}, "type": {"enum": ["http", "condition", "transform", "template", "call_skill", "schedule", "notification", "memory_candidate", "context_contribution"]}, "purpose": {"type": "string"}}}}, "dependencies": {"type": "array", "items": {"type": "string"}}, "capabilities": {"type": "array", "items": {"type": "string"}}, "sideEffects": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}, "missingDetails": {"type": "array", "items": {"type": "string"}}, "assumptions": {"type": "array", "items": {"type": "string"}}}},
      "WorkshopRevision": {"type": "object", "required": ["id", "sessionId", "revision", "plan", "draft", "normalizedDraft", "workflowChecksum", "createdAt"], "properties": {"id": {"type": "string"}, "sessionId": {"type": "string"}, "revision": {"type": "integer"}, "plan": {"$ref": "#/components/schemas/WorkshopPlan"}, "draft": {"type": "object"}, "normalizedDraft": {"type": "object"}, "workflowChecksum": {"type": "string"}, "validation": {"type": "object"}, "modelProvider": {"type": "string"}, "modelName": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}}},
      "WorkshopGenerateRequest": {"type": "object", "properties": {"requirement": {"type": "string", "maxLength": 20000}, "draft": {"type": "object"}}},
      "WorkshopPermissionConfirmation": {"type": "object", "required": ["workflowChecksum", "capabilities", "confirmedHighRisk", "production"], "properties": {"workflowChecksum": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "confirmedHighRisk": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "production": {"type": "boolean"}}},
      "WorkshopTestRequest": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["dry_run", "mocked", "controlled_live"]}, "testCaseIds": {"type": "array", "items": {"type": "string"}}, "testCases": {"type": "array", "items": {"type": "object"}}, "controlledLiveConfirmed": {"type": "boolean"}}},
      "AgentSkillResource": {"type": "object", "required": ["path", "kind", "mimeType", "size", "sha256", "textReadable", "executable", "supported"], "properties": {"path": {"type": "string"}, "kind": {"enum": ["skill", "reference", "asset", "script", "agent_metadata", "other"]}, "mimeType": {"type": "string"}, "size": {"type": "integer"}, "sha256": {"type": "string"}, "textReadable": {"type": "boolean"}, "executable": {"const": false}, "supported": {"type": "boolean"}}},
      "AgentSkill": {"type": "object", "required": ["extensionId", "name", "description", "source", "scope", "contentHash", "resources", "toolMappings", "compatibilityStatus", "enabled"], "properties": {"extensionId": {"type": "string"}, "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "description": {"type": "string"}, "source": {"enum": ["bundled", "local-directory", "local-zip", "workshop"]}, "scope": {"enum": ["global", "character"]}, "contentHash": {"type": "string"}, "resources": {"type": "array", "items": {"$ref": "#/components/schemas/AgentSkillResource"}}, "toolMappings": {"type": "array", "items": {"type": "object"}}, "compatibilityStatus": {"enum": ["compatible", "compatible_with_warnings", "partially_compatible", "blocked"]}, "enabled": {"type": "boolean"}}},
      "AgentSkillInstallRequest": {"type": "object", "required": ["previewId", "scope"], "properties": {"previewId": {"type": "string"}, "scope": {"enum": ["global", "character"]}, "characterId": {"type": "string"}, "enable": {"type": "boolean", "default": false}}},
      "PackageImportPreview": {"type": "object", "required": ["sessionId", "format", "skillType", "id", "name", "version", "packageHash", "checksum", "signature", "files", "risks", "warnings", "errors", "conflict", "availableActions", "expiresAt"], "properties": {"sessionId": {"type": "string"}, "format": {"enum": ["amitiax", "agentskills-zip", "agentskills-directory"]}, "skillType": {"enum": ["workflow", "instructions"]}, "id": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "packageHash": {"type": "string"}, "checksum": {"type": "object"}, "signature": {"type": "object"}, "files": {"type": "array", "items": {"type": "object"}}, "risks": {"type": "array", "items": {"type": "object"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "items": {"type": "string"}}, "conflict": {"type": "string"}, "availableActions": {"type": "array", "items": {"type": "string"}}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "PackageInstallRequest": {"type": "object", "required": ["sessionId", "scopeType"], "properties": {"sessionId": {"type": "string"}, "scopeType": {"enum": ["global", "character"]}, "scopeId": {"type": "string"}, "confirmUnsigned": {"type": "boolean"}, "confirmScripts": {"type": "boolean"}, "confirmVersionChange": {"type": "boolean"}, "confirmSignerChange": {"type": "boolean"}, "confirmConfigMigration": {"type": "boolean"}, "confirmedCapabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}
    }
  },
  "security": [{"bearerAuth": []}],
  "paths": {
    "/extensions/packages/status": {"get": {"summary": "Get extension package service status", "responses": {"200": {"description": "Extension package status"}, "401": {"description": "Unauthorized"}}}},
    "/extensions/packages": {"get": {"summary": "List installed extension packages", "responses": {"200": {"description": "Installed extension package list"}, "401": {"description": "Unauthorized"}}}},
    "/extensions/packages/install": {"post": {"summary": "Validate and atomically install an Amitiax package", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["package"], "properties": {"package": {"type": "string", "format": "binary"}}}}}}, "responses": {"201": {"description": "Installed"}, "401": {"description": "Unauthorized"}, "422": {"description": "Invalid package"}}}},
    "/extensions/capabilities": {"get": {"summary": "List capability definitions", "responses": {"200": {"description": "Capability definitions"}, "401": {"description": "Unauthorized", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/packages/import/preview": {"post": {"summary": "Detect, securely validate and preview a local Amitia or AgentSkills package", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file", "scopeType"], "properties": {"file": {"type": "string", "format": "binary"}, "scopeType": {"enum": ["global", "character"]}, "scopeId": {"type": "string"}}}}, "application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Server-validated package preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PackageImportPreview"}}}}, "422": {"description": "Unsafe or invalid package"}}}},
    "/extensions/packages/import/install": {"post": {"summary": "Atomically install a one-time validated import session disabled by default", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PackageInstallRequest"}}}}, "responses": {"200": {"description": "Installed"}, "410": {"description": "Session expired or consumed"}}}},
    "/extensions/packages/metrics": {"get": {"summary": "Get local package lifecycle counters", "responses": {"200": {"description": "Package metrics"}}}},
    "/extensions/{id}/export": {"post": {"summary": "Export a workflow as .amitiax or instructions as .amitiax/AgentSkills ZIP", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Expiring controlled export"}}}},
    "/extensions/{id}/exports/{exportId}": {"get": {"summary": "Download an authorized expiring export", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "exportId", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Package bytes"}}}},
    "/extensions/{id}/upgrade/preview": {"post": {"summary": "Preview a manual local package upgrade", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Upgrade preview"}}}},
    "/extensions/{id}/upgrade": {"post": {"summary": "Atomically apply a confirmed local upgrade", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Upgrade result"}}}},
    "/extensions/{id}/versions": {"get": {"summary": "List immutable package versions", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Version history"}}}},
    "/extensions/{id}/versions/compare": {"get": {"summary": "Compare manifests, schemas, workflow/instructions, capabilities and signatures", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "from", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "to", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Structured version diff"}}}},
    "/extensions/{id}/versions/{version}/rollback": {"post": {"summary": "Atomically rollback without restoring revoked grants", "responses": {"200": {"description": "Rollback result"}}}},
    "/extensions/{id}/dependencies": {"get": {"summary": "List direct and reverse package dependencies", "responses": {"200": {"description": "Dependencies"}}}},
    "/extensions/{id}/uninstall/preview": {"get": {"summary": "Preview uninstall cleanup, retained audit data and dependency blockers", "responses": {"200": {"description": "Uninstall preview"}, "409": {"description": "Dependency in use"}}}},
    "/extensions/{id}": {"delete": {"summary": "Uninstall a local Skill while preserving audits and runs", "responses": {"200": {"description": "Uninstall result"}, "409": {"description": "Dependency in use"}}}},
    "/extensions/package-operations": {"get": {"summary": "List package operation audit history", "responses": {"200": {"description": "Operation history"}}}},
    "/extensions/package-operations/{operationId}": {"get": {"summary": "Get a package operation audit record", "parameters": [{"in": "path", "name": "operationId", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Operation detail"}, "404": {"description": "Operation not found"}}}},
    "/extensions/signers": {"get": {"summary": "List local package signers and trust state", "responses": {"200": {"description": "Signer list"}}}},
    "/extensions/signers/{fingerprint}/trust": {"post": {"summary": "Trust a local Ed25519 signer without granting capabilities", "responses": {"200": {"description": "Trusted"}}}},
    "/extensions/signers/{fingerprint}/untrust": {"post": {"summary": "Revoke local signer trust", "responses": {"200": {"description": "Untrusted"}}}},
    "/extensions/skills": {"get": {"summary": "List skills", "parameters": [{"in": "query", "name": "characterId", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "enabled", "schema": {"type": "boolean"}}, {"in": "query", "name": "trigger", "schema": {"enum": ["llm", "manual", "schedule", "system_event"]}}, {"in": "query", "name": "source", "schema": {"enum": ["builtin", "legacy_tool", "workflow", "instructions"]}}], "responses": {"200": {"description": "Skill list"}, "401": {"description": "Unauthorized", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/agent-skills/import/preview": {"post": {"summary": "Validate and preview a ZIP or directory Agent Skill import", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "properties": {"source": {"enum": ["zip", "directory"]}, "file": {"type": "string", "format": "binary"}, "files": {"type": "array", "items": {"type": "string", "format": "binary"}}, "paths": {"type": "string"}, "rootName": {"type": "string"}}}}}}, "responses": {"200": {"description": "Server-validated import preview"}, "400": {"description": "Invalid or unsafe import", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/agent-skills/import/install": {"post": {"summary": "Install a previously validated Agent Skill preview", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentSkillInstallRequest"}}}}, "responses": {"201": {"description": "Installed, disabled by default"}}}},
    "/extensions/agent-skills": {"get": {"summary": "List visible Agent Skills", "parameters": [{"in": "query", "name": "characterId", "schema": {"type": "string"}}, {"in": "query", "name": "query", "schema": {"type": "string"}}, {"in": "query", "name": "scope", "schema": {"enum": ["global", "character"]}}, {"in": "query", "name": "status", "schema": {"enum": ["compatible", "compatible_with_warnings", "partially_compatible", "blocked"]}}], "responses": {"200": {"description": "Agent Skill page"}}}},
    "/extensions/agent-skills/metrics": {"get": {"summary": "Get Agent Skill runtime counters and token totals", "responses": {"200": {"description": "Agent Skill metrics"}}}},
    "/extensions/agent-skills/{id}": {"get": {"summary": "Get Agent Skill details, compatibility and activation trace", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "characterId", "schema": {"type": "string"}}], "responses": {"200": {"description": "Agent Skill detail"}}}, "delete": {"summary": "Disable and remove an Agent Skill", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Removed"}}}},
    "/extensions/agent-skills/{id}/enable": {"post": {"summary": "Enable a non-blocked Agent Skill", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Enabled"}}}},
    "/extensions/agent-skills/{id}/disable": {"post": {"summary": "Disable an Agent Skill and evict prompt cache", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Disabled"}}}},
    "/extensions/agent-skills/{id}/compatibility": {"get": {"summary": "Get Agent Skill compatibility report", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Compatibility report"}}}},
    "/extensions/agent-skills/{id}/resources": {"get": {"summary": "List Agent Skill resource metadata", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "kind", "schema": {"type": "string"}}], "responses": {"200": {"description": "Resource index"}}}},
    "/extensions/agent-skills/{id}/resources/content": {"get": {"summary": "Read or download a controlled Agent Skill text resource", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Resource content"}}}},
    "/extensions/agent-skills/{id}/assets/content": {"get": {"summary": "Download a controlled non-executable Agent Skill asset", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "path", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "characterId", "schema": {"type": "string"}}], "responses": {"200": {"description": "Sandboxed asset content"}, "403": {"description": "Unsafe or out-of-scope asset"}}}},
    "/extensions/agent-skills/{id}/activations": {"get": {"summary": "List redacted Agent Skill activation traces", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Activation history"}}}},
    "/extensions/workshop/metrics": {"get": {"summary": "Get workshop runtime counters", "responses": {"200": {"description": "Required workshop counters", "content": {"application/json": {"schema": {"type": "object", "required": ["counters"], "properties": {"counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}}}}}}},
    "/extensions/workshop/instructions/generate": {"post": {"summary": "Generate and server-validate a no-code Agent Skill instruction preview", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["requirement"], "properties": {"requirement": {"type": "string", "maxLength": 20000}}}}}}, "responses": {"200": {"description": "Validated Agent Skill import preview"}, "400": {"description": "Invalid, unsafe, or executable model output"}}}},
    "/extensions/workshop/sessions": {"get": {"summary": "List owned workshop sessions", "parameters": [{"in": "query", "name": "characterId", "schema": {"type": "string"}}, {"in": "query", "name": "page", "schema": {"type": "integer", "minimum": 1}}, {"in": "query", "name": "pageSize", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}], "responses": {"200": {"description": "Workshop session page"}}}, "post": {"summary": "Create workshop session", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["requirement"], "properties": {"requirement": {"type": "string", "maxLength": 20000}, "characterId": {"type": "string"}}}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopSession"}}}}}}},
    "/extensions/workshop/sessions/{id}": {"get": {"summary": "Get owned workshop session", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Session detail"}, "403": {"description": "Forbidden", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/workshop/sessions/{id}/archive": {"post": {"summary": "Archive workshop session", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"204": {"description": "Archived"}}}},
    "/extensions/workshop/sessions/{id}/revisions": {"get": {"summary": "List immutable revisions", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Revision list"}}}},
    "/extensions/workshop/sessions/{id}/revisions/{revision}": {"get": {"summary": "Get immutable revision", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "revision", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopRevision"}}}}}}},
    "/extensions/workshop/sessions/{id}/generate": {"post": {"summary": "Plan requirements and generate or save a structured draft revision", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopGenerateRequest"}}}}, "responses": {"200": {"description": "Generated revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopRevision"}}}}, "400": {"description": "Invalid model output", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/workshop/sessions/{id}/revisions/{revision}/validate": {"post": {"summary": "Compile and statically validate revision", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "revision", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Validation result"}}}},
    "/extensions/workshop/sessions/{id}/revisions/{revision}/permissions/confirm": {"post": {"summary": "Confirm revision-bound capabilities", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "revision", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopPermissionConfirmation"}}}}, "responses": {"204": {"description": "Confirmed"}}}},
    "/extensions/workshop/sessions/{id}/revisions/{revision}/test": {"post": {"summary": "Run declarative workflow sandbox test", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "revision", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkshopTestRequest"}}}}, "responses": {"200": {"description": "Structured test report"}}}},
    "/extensions/workshop/sessions/{id}/revisions/{revision}/install": {"post": {"summary": "Atomically install validated and tested workflow Skill", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}, {"in": "path", "name": "revision", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Installed disabled Skill"}, "409": {"description": "Revision or version conflict", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/workshop/sessions/{id}/tests": {"get": {"summary": "List revision-bound test reports", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Test reports"}}}},
    "/extensions/workshop/sessions/{id}/artifact": {"get": {"summary": "Get installed workshop artifact", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Artifact metadata and redacted declarative files"}, "404": {"description": "Artifact not found"}}}},
    "/extensions/workshop/sessions/{id}/export": {"post": {"summary": "Export deterministic workflow artifact ZIP", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Artifact ZIP", "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}}}}},
    "/extensions/workshop/tests/{testRunId}": {"get": {"summary": "Get owned redacted test report", "parameters": [{"in": "path", "name": "testRunId", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Test report"}, "403": {"description": "Forbidden", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/extensions/skills/{id}/workshop/fork": {"post": {"summary": "Create a new workshop revision session from an installed workflow Skill", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "Forked workshop session"}, "409": {"description": "Only workflow Skills can be forked"}}}},
