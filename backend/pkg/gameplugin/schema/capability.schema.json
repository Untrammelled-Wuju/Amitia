{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amitia.untrammelled.top/schemas/gamehost/capability.schema.json",
  "title": "Game Host Capability",
  "description": "Schema for amitia-game-host/1 Capability identifier. Public protocol for third-party game plugin implementations.",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "realtime_control",
        "state_streaming",
        "event_streaming",
        "binary_streaming",
        "custom_rpc",
        "host_api",
        "shared_control",
        "custom_ui",
        "multi_service"
      ],
      "description": "Standard capabilities with defined semantics."
    },
    {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9.]*$",
      "minLength": 1,
      "maxLength": 256,
      "description": "Custom namespaced capability using vendor namespace prefix.",
      "examples": ["minecraft.pathfinding", "vendor.custom-agent", "factorio.logistics"]
    }
  ]
}
