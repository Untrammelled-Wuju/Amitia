{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amitia.untrammelled.top/schemas/gamehost/plugin-host-spec.schema.json",
  "title": "Amitia Game Plugin Host Spec",
  "description": "Canonical host-owned contribution contract for amitia-game-host/1. It intentionally contains no game identity, version, application-specific world/entity/action/observation semantics.",
  "type": "object",
  "required": [
    "protocolVersion",
    "network"
  ],
  "properties": {
    "protocolVersion": {
      "const": "amitia-game-host/1"
    },
    "runtimeModuleId": {
      "type": "string",
      "minLength": 1
    },
    "hostFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "capability.schema.json"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "moduleId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "moduleId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "process"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "state",
              "log",
              "metric",
              "custom"
            ]
          },
          "schemaId": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "controlEffectSinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "serviceId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "zip"
            ]
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "architectures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "compatibilityVersions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "loopback",
            "unrestricted"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "Explicit network boundary. none/loopback require an OS isolation backend; unrestricted additionally requires service.network.request."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "runtimeModuleId"
      ]
    },
    {
      "required": [
        "services"
      ],
      "properties": {
        "services": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": false
}
