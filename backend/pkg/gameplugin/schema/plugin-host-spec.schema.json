{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amitia.untrammelled.top/schemas/gamehost/plugin-host-spec.schema.json",
  "title": "Amitia Game Plugin Host Spec",
  "description": "Canonical host-owned contribution contract for amitia-game-host/1. It intentionally contains no game identity, version, application-specific world/entity/action/observation semantics.",
  "type": "object",
  "required": [
    "protocolVersion",
    "network"
  ],
  "properties": {
    "protocolVersion": {
      "const": "amitia-game-host/1"
    },
    "runtimeModuleId": {
      "type": "string",
      "minLength": 1
    },
    "hostFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "capability.schema.json"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "moduleId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x20\\x7f]+$"
          },
          "moduleId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "process"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x20\\x7f]+$"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "state",
              "log",
              "metric",
              "binary",
              "custom"
            ]
          },
          "schemaId": {
            "type": "string",
            "maxLength": 1024
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x20\\x7f]+$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "plugin_to_host",
              "host_to_plugin",
              "bidirectional"
            ],
            "description": "Channel flow direction. Omitted defaults to plugin_to_host."
          },
          "frequencyHint": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "realtime"
            ],
            "description": "Informational expected message-frequency hint."
          }
        },
        "additionalProperties": false
      }
    },
    "controlEffectSinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "serviceId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x20\\x7f]+$"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "zip"
            ]
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "architectures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "compatibilityVersions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "loopback",
            "restricted",
            "unrestricted"
          ]
        },
        "allowedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "allowedIPs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 45 }
        },
        "allowedPorts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "restricted" } } },
          "then": {
            "required": ["allowedPorts"],
            "anyOf": [
              { "required": ["allowedDomains"], "properties": { "allowedDomains": { "minItems": 1 } } },
              { "required": ["allowedIPs"], "properties": { "allowedIPs": { "minItems": 1 } } }
            ],
            "properties": {
              "allowedPorts": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "allowedDomains": { "maxItems": 0 },
              "allowedIPs": { "maxItems": 0 },
              "allowedPorts": { "maxItems": 0 }
            }
          }
        }
      ],
      "description": "Explicit protocol-v1 network intent. Restricted keeps the plugin process network-isolated and allows only host-mediated requests matching allowedDomains/allowedIPs/allowedPorts; restricted and unrestricted require service.network.request."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "runtimeModuleId"
      ]
    },
    {
      "required": [
        "services"
      ],
      "properties": {
        "services": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": false
}
