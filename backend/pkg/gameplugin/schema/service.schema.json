{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amitia.untrammelled.top/schemas/gamehost/service.schema.json",
  "title": "Game Host Service Descriptor",
  "description": "Schema for amitia-game-host/1 Service Descriptor. Public protocol for third-party game plugin implementations.",
  "type": "object",
  "required": ["id", "kind"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique service identifier within the plugin.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\x00-\\x1f]+$",
      "examples": ["agent-service", "game-bridge", "vision-service"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable service name.",
      "maxLength": 512
    },
    "kind": {
      "type": "string",
      "enum": ["process", "external"],
      "description": "Service execution model."
    },
    "required": {
      "type": "boolean",
      "description": "Whether this service is essential for plugin operation.",
      "default": false
    },
    "dependsOn": {
      "type": "array",
      "description": "Service IDs this service depends on.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "description": "Capabilities this service provides.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "description": "Extension metadata. Core logic must not depend on undefined fields.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
