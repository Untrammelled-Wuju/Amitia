{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amitia.untrammelled.top/schemas/gamehost/error.schema.json",
  "title": "Game Host Protocol Error",
  "description": "Schema for amitia-game-host/1 Protocol Error. Public protocol for third-party game plugin implementations.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "invalid_request",
            "invalid_argument",
            "not_found",
            "already_exists",
            "unsupported",
            "protocol_mismatch",
            "capability_unsupported",
            "runtime_unavailable",
            "service_unavailable",
            "invalid_runtime_state",
            "permission_denied",
            "resource_exhausted",
            "timeout",
            "cancelled",
            "internal"
          ],
          "description": "Standard protocol error codes."
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9.]*$",
          "description": "Custom namespaced error code using vendor namespace prefix.",
          "examples": ["minecraft.connection_failed", "vendor.auth_failed"]
        }
      ]
    },
    "message": {
      "type": "string",
      "description": "Human-readable error message.",
      "minLength": 1,
      "maxLength": 2048
    },
    "retryable": {
      "type": "boolean",
      "description": "Whether the operation can be retried.",
      "default": false
    },
    "data": {
      "type": "object",
      "description": "Opaque error data. Core protocol treats as transparent payload.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
