{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/runtime-crash",
    "name": {
      "default": "Runtime Crash"
    },
    "description": {
      "default": "Phase 10 E2E: extension that throws during invocation to validate runtime crash isolation and recovery"
    },
    "version": "1.0.0",
    "metadata": {
      "expectedBehavior": "crash_on_invoke",
      "crashType": "uncaught_exception"
    },
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "tool"
        ],
        "maxContributions": 1,
        "maxTools": 1,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "crash-tool",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "Crash Tool"
          },
          "description": {
            "default": "Tool that throws an uncaught exception to crash its runtime"
          }
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "Execute crash tool",
      "required": true
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
