{
	"manifestVersion": 2,
	"extension": {
		"id": "com.amitia.repair/tool-permission-denied",
		"name": {"default": "Tool Permission Denied"},
		"description": {"default": "Phase 10 E2E: tool that requires a permission which is not granted by default, must be denied"},
		"version": "1.0.0"
	},
	"publisher": {
		"id": "com.amitia.repair",
		"displayName": "Amitia Repair"
	},
	"modules": [
		{
			"id": "main",
			"name": {"default": "Main"},
			"type": "javascript",
			"runtime": {"type": "javascript", "entryPoint": "index.js"},
			"contributions": [
				{
					"id": "guarded-tool",
					"kind": "tool",
					"name": {"default": "Guarded Tool"},
					"description": {"default": "Tool requiring filesystem.read permission to execute"},
					"modelName": "guarded_tool",
					"requiredPermissions": ["filesystem.read"],
					"inputSchema": {
						"type": "object",
						"properties": {
							"path": {"type": "string", "description": "Path to read"}
						},
						"required": ["path"]
					}
				}
			]
		}
	],
	"permissions": [
		{"name": "filesystem.read", "reason": "Read files via guarded tool", "required": true}
	],
	"integrity": {
		"algorithm": "sha256",
		"contentTreeHash": ""
	}
}
