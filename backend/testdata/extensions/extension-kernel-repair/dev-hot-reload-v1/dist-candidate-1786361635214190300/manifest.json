{
	"manifestVersion": 2,
	"extension": {
		"id": "com.amitia.repair/dev-hot-reload",
		"name": {"default": "Dev Hot Reload v1"},
		"description": {"default": "Phase 10 E2E: developer mode extension v1, used as baseline before hot reload to v2"},
		"version": "1.0.0",
		"metadata": {
			"expectedGeneration": 1,
			"reloadScenario": "baseline"
		}
	},
	"publisher": {
		"id": "com.amitia.repair",
		"displayName": "Amitia Repair"
	},
	"modules": [
		{
			"id": "main",
			"name": {"default": "Main"},
			"type": "javascript",
			"runtime": {"type": "javascript", "entryPoint": "index.js"},
			"contributions": [
				{
					"id": "dev-tool",
					"kind": "tool",
					"name": {"default": "Dev Tool v1"},
					"description": {"default": "Developer tool generation 1"},
					"modelName": "dev_tool",
					"inputSchema": {
						"type": "object",
						"properties": {
							"input": {"type": "string"}
						}
					}
				}
			]
		}
	],
	"permissions": [
		{"name": "tool.invoke", "reason": "Execute dev tool", "required": true}
	],
	"development": {
		"developerMode": true,
		"hotReload": true,
		"sourceMaps": true,
		"watchPaths": ["modules/main/index.js"]
	},
	"integrity": {
		"algorithm": "sha256",
		"contentTreeHash": ""
	}
}
