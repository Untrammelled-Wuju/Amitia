{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/signature-tampered",
    "name": {
      "default": "Signature Tampered"
    },
    "description": {
      "default": "Phase 10 E2E: extension whose package content has been tampered after signing, must fail integrity verification"
    },
    "version": "1.0.0",
    "metadata": {
      "expectedSignatureStatus": "tampered",
      "expectedInstallStatus": "failed",
      "tamperHint": "modify index.js after packaging to break content tree hash"
    },
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair",
      "trustLevel": "trusted"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "tool"
        ],
        "maxContributions": 1,
        "maxTools": 1,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "tampered-tool",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "Tampered Tool"
          },
          "description": {
            "default": "Tool whose package content was modified post-signing"
          }
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "Execute tool",
      "required": true
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
