{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/event-generation",
    "name": {
      "default": "Event Generation v1"
    },
    "description": {
      "default": "Phase 10 E2E: event subscription generation v1, used to validate generation switching"
    },
    "version": "1.0.0",
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "event"
        ],
        "maxContributions": 1,
        "maxTools": 0,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "gen-subscription",
          "kind": "event_subscription",
          "adapter": "event",
          "contractVersion": 1,
          "name": {
            "default": "Generation v1 Subscription"
          },
          "description": {
            "default": "Generation 1 subscription for system.test events"
          },
          "version": "1.0.0",
          "spec": {
            "eventTypeId": "system.test",
            "eventVersionRange": "^1",
            "entry": "onEvent",
            "generation": 1,
            "deliveryPolicy": {
              "timeout": "5s",
              "maxInFlight": 4
            }
          }
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "event.subscribe",
      "reason": "Subscribe to system.test events",
      "required": true
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
