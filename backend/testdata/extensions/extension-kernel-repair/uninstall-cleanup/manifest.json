{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/uninstall-cleanup",
    "name": {
      "default": "Uninstall Cleanup"
    },
    "description": {
      "default": "Phase 10 E2E: extension that creates subscriptions, schedules, runtime and UI sessions to verify full cleanup on uninstall"
    },
    "version": "1.0.0",
    "metadata": {
      "expectedBehavior": "full_cleanup_on_uninstall",
      "cleanupTargets": [
        "runtime",
        "event_subscription",
        "delivery",
        "schedule",
        "lease",
        "ui_session",
        "shortcut"
      ]
    },
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "tool",
          "event",
          "schedule",
          "ui"
        ],
        "maxContributions": 4,
        "maxTools": 1,
        "maxRoutes": 1,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "cleanup-tool",
          "kind": "tool",
          "adapter": "tool",
          "contractVersion": 1,
          "name": {
            "default": "Cleanup Tool"
          },
          "description": {
            "default": "Tool that registers side effects to verify cleanup"
          }
        },
        {
          "id": "cleanup-subscription",
          "kind": "event_subscription",
          "adapter": "event",
          "contractVersion": 1,
          "name": {
            "default": "Cleanup Subscription"
          },
          "description": {
            "default": "Subscription that must be removed on uninstall"
          },
          "spec": {
            "eventTypeId": "system.test",
            "eventVersionRange": "^1",
            "entry": "onEvent"
          }
        },
        {
          "id": "cleanup-schedule",
          "kind": "schedule",
          "adapter": "schedule",
          "contractVersion": 1,
          "name": {
            "default": "Cleanup Schedule"
          },
          "description": {
            "default": "Schedule that must be removed on uninstall"
          },
          "spec": {
            "trigger": {
              "type": "interval",
              "interval": "60s"
            },
            "target": {
              "type": "tool",
              "toolId": "cleanup-tool",
              "input": {
                "action": "scheduled"
              }
            }
          }
        },
        {
          "id": "cleanup-page",
          "kind": "ui_page",
          "adapter": "ui",
          "contractVersion": 1,
          "name": {
            "default": "Cleanup Page"
          },
          "description": {
            "default": "UI page session that must be removed on uninstall"
          },
          "spec": {
            "route": "/cleanup",
            "entry": "index.html",
            "visibility": {
              "platforms": [
                "windows"
              ]
            }
          }
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "tool.invoke",
      "reason": "Execute cleanup tool",
      "required": true
    },
    {
      "name": "event.subscribe",
      "reason": "Subscribe for cleanup verification",
      "required": true
    },
    {
      "name": "schedule.create",
      "reason": "Create schedule for cleanup verification",
      "required": true
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
