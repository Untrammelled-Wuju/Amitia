{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/event-scope-denied",
    "name": {
      "default": "Event Scope Denied"
    },
    "description": {
      "default": "Phase 10 E2E: event subscription requiring a scope that is not bound, must be denied"
    },
    "version": "1.0.0",
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "event"
        ],
        "maxContributions": 1,
        "maxTools": 0,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "scoped-subscription",
          "kind": "event_subscription",
          "adapter": "event",
          "contractVersion": 1,
          "name": {
            "default": "Scoped Subscription"
          },
          "description": {
            "default": "Subscription requiring resource:private scope"
          },
          "spec": {
            "eventTypeId": "system.scoped",
            "eventVersionRange": "^1",
            "entry": "onEvent",
            "scopeRule": {
              "requireAll": [
                "resource:private"
              ]
            }
          },
          "requiredPermissions": [
            "event.subscribe"
          ],
          "requiredScope": [
            "resource:private"
          ]
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "event.subscribe",
      "reason": "Subscribe to scoped events",
      "required": true,
      "scope": "resource:private"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
