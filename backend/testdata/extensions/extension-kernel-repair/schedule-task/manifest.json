{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.repair/schedule-task",
    "name": {
      "default": "Schedule Task"
    },
    "description": {
      "default": "Phase 10 E2E: cron schedule that creates a TaskRun"
    },
    "version": "1.0.0",
    "publisher": {
      "id": "com.amitia.repair",
      "displayName": "Amitia Repair"
    }
  },
  "compatibility": {
    "minHostVersion": "0.1.0"
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "Main"
      },
      "runtime": {
        "adapter": "javascript",
        "entry": "index.js"
      },
      "dynamic": {
        "allowedAdapters": [
          "schedule"
        ],
        "maxContributions": 1,
        "maxTools": 0,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "task-schedule",
          "kind": "schedule",
          "adapter": "schedule",
          "contractVersion": 1,
          "name": {
            "default": "Task Schedule"
          },
          "description": {
            "default": "Cron schedule targeting a background task"
          },
          "spec": {
            "trigger": {
              "type": "cron",
              "expression": "0 */5 * * * *"
            },
            "target": {
              "type": "task",
              "taskName": "periodic-sync",
              "input": {
                "source": "scheduled"
              }
            }
          }
        }
      ],
      "placement": "device"
    }
  ],
  "permissions": [
    {
      "name": "schedule.create",
      "reason": "Create cron schedule",
      "required": true
    },
    {
      "name": "task.run",
      "reason": "Run scheduled task",
      "required": true
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
