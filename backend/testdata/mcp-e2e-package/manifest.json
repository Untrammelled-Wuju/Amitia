{
  "schemaVersion": 1,
  "plugin": {
    "id": "com.amitia.e2e/mcp-server",
    "name": {
      "default": "MCP E2E Fixture",
      "translations": {}
    },
    "description": {
      "default": "Production-path MCP package integration fixture",
      "translations": {}
    },
    "version": "1.0.0",
    "publisher": {
      "id": "amitia-e2e",
      "displayName": "Amitia E2E",
      "trustLevel": "untrusted"
    }
  },
  "compatibility": {
    "minHostVersion": "26.2.0-beta.10",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "modules": [
    {
      "id": "main",
      "name": {
        "default": "MCP E2E",
        "translations": {}
      },
      "dynamic": {
        "allowedAdapters": [
          "mcp_server"
        ],
        "maxContributions": 1,
        "maxTools": 0,
        "maxRoutes": 0,
        "maxServices": 0,
        "allowUnregister": true
      },
      "contributions": [
        {
          "id": "echo",
          "kind": "mcp_server",
          "adapter": "mcp_server",
          "contractVersion": 1,
          "name": {
            "default": "MCP E2E Echo",
            "translations": {}
          },
          "description": {
            "default": "Echo tool from a real .amitiax package",
            "translations": {}
          },
          "spec": {
            "schemaVersion": 1,
            "transport": {
              "type": "stdio",
              "stdio": {
                "command": "/Users/untrammelled/Desktop/Project/U-AI/AmitiaData/node/bin/node",
                "args": [
                  "/Users/untrammelled/Desktop/Project/U-AI/backend/testdata/mcp-e2e-package/modules/main/server.mjs"
                ],
                "env": {
                  "values": {
                    "AMITIA_MCP_E2E": "1"
                  }
                },
                "runtimeHint": "node"
              }
            },
            "capabilities": {
              "server": {
                "tools": "required"
              },
              "client": {
                "roots": "required",
                "sampling": "optional",
                "tasks": "disabled"
              }
            },
            "lifecycle": {
              "autoStart": true,
              "restartPolicy": "on_failure",
              "refreshOnReconnect": true
            },
            "security": {
              "allowPrivateNetwork": false
            }
          }
        }
      ],
      "placement": "device"
    }
  ],
  "data": {
    "schemaVersion": 1,
    "backup": true,
    "export": true,
    "uninstall": "retain"
  },
  "integrity": {
    "algorithm": "sha256",
    "contentTreeHash": ""
  }
}
