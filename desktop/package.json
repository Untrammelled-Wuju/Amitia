{
  "name": "@amitia/desktop",
  "version": "26.1.8",
  "desktopPetRuntimeVersion": "2.0.0",
  "desktopPetRuntimeContractVersion": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && node scripts/copy-static-assets.mjs && node scripts/verify-renderer-build.mjs && node scripts/verify-desktop-pet-package.mjs",
    "dist:win": "node scripts/build-release.mjs",
    "dist:win:dir": "electron-builder --win --x64 --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && node scripts/build-release.mjs && node scripts/verify-packaged-desktop-pet.mjs release/win-unpacked",
    "upload": "node scripts/publish-release.mjs",
    "verify:desktop-pet-package": "node scripts/verify-desktop-pet-package.mjs",
    "package:ci": "pnpm run build && pnpm run test:electron-pet-smoke && electron-builder --config electron-builder.ci.yml --win --x64 --dir && node scripts/verify-packaged-desktop-pet.mjs release-ci/win-unpacked",
    "test:electron-pet-smoke": "electron scripts/desktop-pet-electron-smoke.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vue/compiler-sfc": "3.5.35",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "vue": "3.5.35",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
