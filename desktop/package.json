{
  "name": "@amitia/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && node -e \"const{cpSync}=require('fs');cpSync('src/renderer/update-check','dist/renderer/update-check',{recursive:true})\"",
    "dist:win": "electron-builder --win --x64",
    "dist:win:dir": "electron-builder --win --x64 --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0"
  }
}
