{
  "name": "@amitia/desktop",
  "version": "26.1.8",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && node -e \"const{cpSync}=require('fs');cpSync('src/renderer/update-check','dist/renderer/update-check',{recursive:true})\"",
    "dist:win": "node scripts/build-release.mjs",
    "dist:win:dir": "electron-builder --win --x64 --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && node scripts/build-release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vue/compiler-sfc": "3.5.35",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "vue": "3.5.35",
    "wait-on": "^9.0.10"
  }
}
