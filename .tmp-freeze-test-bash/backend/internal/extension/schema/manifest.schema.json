{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amitia.dev/extensions/v1/manifest.schema.json",
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/semver"},
        "description": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "license": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineMin"],
      "properties": {"engineMin": {"$ref": "#/$defs/semver"}, "engineMaxExclusive": {"$ref": "#/$defs/semver"}}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "artifactId": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "apiVersion", "kind", "metadata", "compatibility", "entry", "capabilities", "triggers", "execution", "inputSchema", "outputSchema", "enabled", "allowLLM", "allowManual"],
      "properties": {
        "$schema": {"const": "https://schemas.amitia.dev/extensions/v1/manifest.schema.json"},
        "apiVersion": {"const": "extensions.amitia.dev/v1alpha1"},
        "kind": {"const": "Skill"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "entry": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"kind": {"enum": ["builtin", "legacy_tool", "workflow", "instructions", "wasm_runtime"]}}, "allOf": [{"if": {"properties": {"kind": {"enum": ["workflow", "instructions"]}}}, "then": {"anyOf": [{"required": ["artifactId"]}, {"required": ["path"]}]}, "else": {"required": ["name"]}}, {"if": {"properties": {"kind": {"const": "instructions"}}}, "then": {"properties": {"path": {"enum": ["SKILL.md", "instructions/SKILL.md"]}}}}]}]},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["llm", "manual", "schedule", "system_event"]}},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["timeoutMs", "hasSideEffects", "retryable", "idempotent"],
          "properties": {"timeoutMs": {"type": "integer", "minimum": 1, "maximum": 300000}, "hasSideEffects": {"type": "boolean"}, "retryable": {"type": "boolean"}, "idempotent": {"type": "boolean"}}
        },
        "inputSchema": {"type": "object"}, "outputSchema": {"type": "object"}, "configSchema": {"type": "object"}, "defaultConfig": {},
        "enabled": {"type": "boolean"}, "allowLLM": {"type": "boolean"}, "allowManual": {"type": "boolean"}
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "apiVersion", "kind", "metadata", "compatibility", "entry", "capabilities", "hooks", "subscriptions", "registeredSkills", "execution", "state", "enabled"],
      "properties": {
        "$schema": {"const": "https://schemas.amitia.dev/extensions/v1/manifest.schema.json"},
        "apiVersion": {"const": "extensions.amitia.dev/v1alpha1"},
        "kind": {"const": "Plugin"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "entry": {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"kind": {"const": "builtin"}}}]},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "hooks": {"type": "array", "uniqueItems": true, "items": {"enum": ["on_load", "on_enable", "before_prompt", "after_reply", "on_event", "on_schedule", "on_disable", "on_unload"]}},
        "subscriptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "registeredSkills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["hookTimeoutMs", "maxConcurrency", "failureThreshold", "circuitOpenMs"],
          "properties": {"hookTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 5000}, "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 20}, "circuitOpenMs": {"type": "integer", "minimum": 100, "maximum": 3600000}, "halfOpenMaxRequests": {"type": "integer", "minimum": 1, "maximum": 4}}
        },
        "configSchema": {"type": "object"}, "defaultConfig": {},
        "state": {
          "type": "object", "additionalProperties": false, "required": ["schemaVersion"],
          "properties": {"schemaVersion": {"$ref": "#/$defs/semver"}, "schema": {"type": "object"}, "default": {}}
        },
        "surface": {"type": "object"},
        "enabled": {"type": "boolean"}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/skill"}, {"$ref": "#/$defs/plugin"}]
}
